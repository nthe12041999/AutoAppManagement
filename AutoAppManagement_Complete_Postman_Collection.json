    {
      "name": "License Management",
      "item": [
        {
          "name": "Check Account License",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
