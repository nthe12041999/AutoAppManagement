              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"accountId\": {{accountId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/CustomerAccount/remove-device",
              "host": ["{{baseUrl}}"],
              "path": ["api", "CustomerAccount", "remove-device"]
            },
            "description": "Xóa thiết bị khỏi tài khoản"
          }
        },
        {
          "name": "Validate Access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
