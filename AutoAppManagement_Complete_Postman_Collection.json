{
  "info": {
    "_postman_id": "e7h21eff-bf78-4ee3-e4ab-e66783dc7099",
    "name": "AutoAppManagement",
    "description": "Collection chứa tất cả API endpoints của AutoAppManagement System - File duy nhất cho testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login (Accountant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Accountant/Login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Accountant", "Login"]
            },
            "description": "Đăng nhập cho admin/accountant"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.isSuccess && jsonData.data && jsonData.data.token) {",
                  "        pm.environment.set('accessToken', jsonData.data.token);",
                  "        pm.environment.set('accountId', jsonData.data.id || jsonData.data.accountId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Customer Login with Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"testuser\",\n  \"password\": \"123456\",\n  \"deviceInfo\": {\n    \"deviceName\": \"iPhone 15 Pro\",\n    \"deviceType\": \"Mobile\",\n    \"operatingSystem\": \"iOS\",\n    \"osVersion\": \"17.2\",\n    \"browserInfo\": \"Safari 17.2\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/CustomerAccount/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "CustomerAccount", "login"]
            },
            "description": "Đăng nhập customer với thông tin thiết bị"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.isSuccess && jsonData.data && jsonData.data.accessToken) {",
                  "        pm.environment.set('accessToken', jsonData.data.accessToken);",
                  "        pm.environment.set('accountId', jsonData.data.accountId);",
                  "        pm.environment.set('deviceId', jsonData.data.deviceId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
