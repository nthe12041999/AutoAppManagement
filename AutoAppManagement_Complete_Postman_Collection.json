            "description": "Lấy số lượng thông báo chưa đọc của tài khoản hiện tại"
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{notificationId}}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Notification/MaskAsRead?noticeId={{notificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Notification", "MaskAsRead"],
              "query": [
                {
                  "key": "noticeId",
                  "value": "{{notificationId}}"
                }
              ]
            },
            "description": "Đánh dấu thông báo đã đọc"
          }
        },
        {
          "name": "Get Notifications by Range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Notification/GetNoticeByRange?from={{fromIndex}}&to={{toIndex}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Notification", "GetNoticeByRange"],
              "query": [
                {
                  "key": "from",
                  "value": "{{fromIndex}}"
                },
                {
                  "key": "to",
                  "value": "{{toIndex}}"
                }
              ]
            },
            "description": "Lấy danh sách thông báo theo phạm vi index"
          }
        }
      ]
