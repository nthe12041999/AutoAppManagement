              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{accountId}},\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/CustomerAccount/validate-access",
              "host": ["{{baseUrl}}"],
              "path": ["api", "CustomerAccount", "validate-access"]
            },
