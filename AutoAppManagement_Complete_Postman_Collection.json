                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": {{accountId}},\n  \"deviceInfo\": {\n    \"deviceName\": \"MacBook Pro M3\",\n    \"deviceType\": \"Desktop\",\n    \"operatingSystem\": \"macOS\",\n    \"osVersion\": \"14.2\",\n    \"browserInfo\": \"Chrome 120.0\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/CustomerAccount/register-device",
              "host": ["{{baseUrl}}"],
              "path": ["api", "CustomerAccount", "register-device"]
            },
            "description": "Đăng ký thiết bị mới cho tài khoản"
          }
        },
        {
          "name": "Get Account Devices",
          "request": {
            "method": "GET",
            "header": [
              {
