# Environment variables for production deployment
# Copy this file to .env and update the values

# Database Configuration
DB_CONNECTION_STRING=Server=your-production-db-server;Database=AutoAppManagement;User Id=your-db-user;Password=your-db-password;TrustServerCertificate=true;Encrypt=false;

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# JWT Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_ISSUER=AutoAppManagement
JWT_AUDIENCE=AutoAppManagement.Users
JWT_EXPIRES_IN_MINUTES=60

# External API URLs
EXTERNAL_API_BASE_URL=https://api.yourdomain.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=AutoAppManagement

# Redis Configuration (if using Redis)
REDIS_CONNECTION_STRING=localhost:6379,password=AutoApp@123456

# Logging
LOG_LEVEL=Information
LOG_FILE_PATH=/app/logs/

# Security
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# SSL/TLS
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Domain Configuration
DOMAIN_NAME=yourdomain.com
API_DOMAIN_NAME=api.yourdomain.com

# Docker Configuration
COMPOSE_PROJECT_NAME=autoappmanagement
RESTART_POLICY=unless-stopped

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Monitoring
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
