@{
    ViewData["Title"] = "Elements";
    ViewData["PageName"] = "elements";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">UI Elements</h1>
        <p class="text-muted mb-0">Comprehensive collection of UI components</p>
    </div>
</div>

<!-- Elements Grid -->
<div class="row g-4">
    <!-- Buttons -->
    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-square text-primary" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title">Buttons</h5>
                <p class="card-text text-muted">Various button styles and states</p>
                <a href="@Url.Action("Buttons", "Elements")" class="btn btn-primary">View Buttons</a>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title">Alerts</h5>
                <p class="card-text text-muted">Alert messages and notifications</p>
                <a href="@Url.Action("Alerts", "Elements")" class="btn btn-warning">View Alerts</a>
            </div>
        </div>
    </div>

    <!-- Badges -->
    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-award text-success" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title">Badges</h5>
                <p class="card-text text-muted">Labels and status indicators</p>
                <a href="@Url.Action("Badges", "Elements")" class="btn btn-success">View Badges</a>
            </div>
        </div>
    </div>

    <!-- Cards -->
    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-card-text text-info" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title">Cards</h5>
                <p class="card-text text-muted">Flexible content containers</p>
                <a href="@Url.Action("Cards", "Elements")" class="btn btn-info">View Cards</a>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-window text-secondary" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title">Modals</h5>
                <p class="card-text text-muted">Dialog boxes and overlays</p>
                <a href="@Url.Action("Modals", "Elements")" class="btn btn-secondary">View Modals</a>
            </div>
        </div>
    </div>

    <!-- Forms -->
    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-ui-checks text-primary" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title">Forms</h5>
                <p class="card-text text-muted">Input fields and form controls</p>
                <a href="@Url.Action("Forms", "Elements")" class="btn btn-primary">View Forms</a>
            </div>
        </div>
    </div>

    <!-- Tables -->
    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-table text-dark" style="font-size: 3rem;"></i>
                </div>
                <h5 class="card-title">Tables</h5>
                <p class="card-text text-muted">Data tables and grids</p>
                <a href="@Url.Action("Tables", "Elements")" class="btn btn-dark">View Tables</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/admin-template/elements-D1Idb5ul.js"></script>
}
