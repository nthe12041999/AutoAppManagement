@{
    ViewData["Title"] = "Files";
    ViewData["PageName"] = "files";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Files</h1>
        <p class="text-muted mb-0">Manage your documents and media</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
            <i class="bi bi-cloud-upload me-2"></i>Upload Files
        </button>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createFolderModal">
            <i class="bi bi-folder-plus me-2"></i>New Folder
        </button>
    </div>
</div>

<!-- File Navigation -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="#"><i class="bi bi-house"></i> Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Documents</a></li>
                        <li class="breadcrumb-item active">Projects</li>
                    </ol>
                </nav>
            </div>
            <div class="col-md-6">
                <div class="d-flex justify-content-end align-items-center">
                    <div class="input-group me-3" style="max-width: 300px;">
                        <input type="text" class="form-control" placeholder="Search files...">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary active" data-view="grid">
                            <i class="bi bi-grid"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-view="list">
                            <i class="bi bi-list"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Storage Info -->
<div class="row mb-4">
    <div class="col-lg-3">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-hdd text-primary" style="font-size: 2rem;"></i>
                <h5 class="mt-2">Storage Used</h5>
                <h3 class="text-primary">2.4 GB</h3>
                <p class="text-muted mb-0">of 10 GB</p>
                <div class="progress mt-2">
                    <div class="progress-bar" style="width: 24%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark text-success" style="font-size: 2rem;"></i>
                <h5 class="mt-2">Total Files</h5>
                <h3 class="text-success">1,247</h3>
                <p class="text-muted mb-0">files</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-folder text-warning" style="font-size: 2rem;"></i>
                <h5 class="mt-2">Folders</h5>
                <h3 class="text-warning">42</h3>
                <p class="text-muted mb-0">folders</p>
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-share text-info" style="font-size: 2rem;"></i>
                <h5 class="mt-2">Shared</h5>
                <h3 class="text-info">18</h3>
                <p class="text-muted mb-0">shared items</p>
            </div>
        </div>
    </div>
</div>

<!-- Files Grid -->
<div class="card">
    <div class="card-body">
        <div class="files-grid" id="filesGrid">
            <!-- Folders -->
            <div class="file-item folder" data-type="folder">
                <div class="file-icon">
                    <i class="bi bi-folder-fill text-warning" style="font-size: 3rem;"></i>
                </div>
                <div class="file-info">
                    <h6 class="file-name">Documents</h6>
                    <small class="text-muted">24 items</small>
                </div>
                <div class="file-actions">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>Open</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Rename</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-share me-2"></i>Share</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="file-item folder" data-type="folder">
                <div class="file-icon">
                    <i class="bi bi-folder-fill text-warning" style="font-size: 3rem;"></i>
                </div>
                <div class="file-info">
                    <h6 class="file-name">Images</h6>
                    <small class="text-muted">156 items</small>
                </div>
                <div class="file-actions">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>Open</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-pencil me-2"></i>Rename</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-share me-2"></i>Share</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Files -->
            <div class="file-item file" data-type="pdf">
                <div class="file-icon">
                    <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 3rem;"></i>
                </div>
                <div class="file-info">
                    <h6 class="file-name">Project Report.pdf</h6>
                    <small class="text-muted">2.4 MB • 2 days ago</small>
                </div>
                <div class="file-actions">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>Preview</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-download me-2"></i>Download</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-share me-2"></i>Share</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="file-item file" data-type="image">
                <div class="file-icon">
                    <i class="bi bi-file-earmark-image text-success" style="font-size: 3rem;"></i>
                </div>
                <div class="file-info">
                    <h6 class="file-name">screenshot.png</h6>
                    <small class="text-muted">1.2 MB • 1 hour ago</small>
                </div>
                <div class="file-actions">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>Preview</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-download me-2"></i>Download</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-share me-2"></i>Share</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="file-item file" data-type="document">
                <div class="file-icon">
                    <i class="bi bi-file-earmark-word text-primary" style="font-size: 3rem;"></i>
                </div>
                <div class="file-info">
                    <h6 class="file-name">Meeting Notes.docx</h6>
                    <small class="text-muted">856 KB • 3 days ago</small>
                </div>
                <div class="file-actions">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>Preview</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-download me-2"></i>Download</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-share me-2"></i>Share</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="file-item file" data-type="spreadsheet">
                <div class="file-icon">
                    <i class="bi bi-file-earmark-excel text-success" style="font-size: 3rem;"></i>
                </div>
                <div class="file-info">
                    <h6 class="file-name">Budget 2025.xlsx</h6>
                    <small class="text-muted">3.1 MB • 1 week ago</small>
                </div>
                <div class="file-actions">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-eye me-2"></i>Preview</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-download me-2"></i>Download</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-share me-2"></i>Share</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Files</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="upload-area border-2 border-dashed rounded p-4 text-center">
                    <i class="bi bi-cloud-upload text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Drag and drop files here</h5>
                    <p class="text-muted">or click to browse</p>
                    <input type="file" class="form-control" multiple style="display: none;">
                    <button type="button" class="btn btn-primary">Choose Files</button>
                </div>
                <div class="upload-progress mt-3" style="display: none;">
                    <div class="progress">
                        <div class="progress-bar" style="width: 0%"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Upload</button>
            </div>
        </div>
    </div>
</div>

<!-- Create Folder Modal -->
<div class="modal fade" id="createFolderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Folder</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="folderName" class="form-label">Folder Name</label>
                        <input type="text" class="form-control" id="folderName" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Create Folder</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .files-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
        }
        
        .file-item {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 1rem;
            text-align: center;
            transition: all 0.2s ease;
            position: relative;
        }
        
        .file-item:hover {
            border-color: #6366f1;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .file-actions {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            opacity: 0;
            transition: opacity 0.2s ease;
        }
        
        .file-item:hover .file-actions {
            opacity: 1;
        }
        
        .file-name {
            margin-top: 0.5rem;
            margin-bottom: 0.25rem;
            font-size: 0.875rem;
            word-break: break-word;
        }
        
        .upload-area {
            border-color: #dee2e6 !important;
            transition: border-color 0.2s ease;
        }
        
        .upload-area:hover {
            border-color: #6366f1 !important;
        }
    </style>
}

@section Scripts {
    <script type="module" src="~/admin-template/files.js"></script>
}
