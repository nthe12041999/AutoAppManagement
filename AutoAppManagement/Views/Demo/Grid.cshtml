@using AutoAppManagement.Models.Enums
@{
    ViewData["Title"] = "Demo DataGrid Component";
    ViewData["PageName"] = "demo-grid";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/components/datagrid.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/demo-grid.css" />
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-table me-2 text-primary"></i>Demo DataGrid Component
        </h1>
        <p class="text-muted mb-0">Sử dụng DataGrid component với dữ liệu mẫu</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="toggleDemoStats">
            <i class="bi bi-bar-chart me-1"></i>
            <span id="toggleDemoStatsText">Hiện thống kê</span>
        </button>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active">Demo Grid</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Statistics Cards -->
<div id="demoStatistics" data-component="statistics" data-template="demo" style="display: none;">
    <!-- Cards will be auto-generated by StatisticsCards component -->
</div>
<!-- Filter and Actions -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="form-floating">
                    <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm...">
                    <label for="searchInput">
                        <i class="bi bi-search me-2"></i>Tìm kiếm theo tên, email...
                    </label>
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="statusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Active">Hoạt động</option>
                    <option value="Inactive">Không hoạt động</option>
                    <option value="Pending">Chờ duyệt</option>
                    <option value="Suspended">Tạm ngưng</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="departmentFilter">
                    <option value="">Tất cả phòng ban</option>
                    <option value="IT">IT</option>
                    <option value="Marketing">Marketing</option>
                    <option value="Sales">Sales</option>
                    <option value="HR">HR</option>
                    <option value="Finance">Finance</option>
                    <option value="Operations">Operations</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="pageSize">
                    <option value="10">10 / trang</option>
                    <option value="25">25 / trang</option>
                    <option value="50">50 / trang</option>
                    <option value="100">100 / trang</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-secondary btn-block" id="clearFilters">
                    <i class="bi bi-x-lg me-1"></i> Xóa bộ lọc
                </button>
            </div>
        </div>
    </div>
</div>

<!-- DataGrid Component -->
<div class="card" data-component="datagrid"
     data-table-id="demoTable"
     data-get-url="@Url.Action("GetDemoData", "Demo")"
     data-base-url="/Demo"
     data-entity="demo"
     data-page-size="10"
     data-auto-load="true"
     data-has-paging="true"
     data-title="Demo DataGrid Component"
     data-title-icon="bi bi-table"
     data-has-export="true"
     data-has-refresh="true"
     data-has-add="true"
     data-title-add="Thêm demo item"
     data-add-action="modal"
     data-add-target="#demoModal">

    <!-- Header will be auto-generated by DataGrid -->
    <div class="card-body p-0" data-section="table-container">
        <div class="table-responsive" data-element="table-wrapper">
            <table class="table table-hover mb-0" id="demoTable">
                <thead class="table-light" data-section="table-header">
                    <tr data-row="header">
                        <th width="50" data-type="@DataGridColumnType.Checkbox" data-sortable="false" class="text-center">
                            <input type="checkbox" class="form-check-input" id="selectAll" data-action="select-all" data-target="all-rows">
                        </th>
                        <th data-field="Id" data-type="@DataGridColumnType.Text" width="80">
                            ID
                        </th>
                        <th data-field="Name" data-type="@DataGridColumnType.User">
                            Thông tin nhân viên
                        </th>
                        <th data-field="Email" data-type="@DataGridColumnType.Email">
                            Email
                        </th>
                        <th data-field="Phone" data-type="@DataGridColumnType.Text">
                            Số điện thoại
                        </th>
                        <th data-field="Department" data-type="@DataGridColumnType.Badge">
                            Phòng ban
                        </th>
                        <th data-field="Position" data-type="@DataGridColumnType.Text">
                            Chức vụ
                        </th>
                        <th data-field="Status" data-type="@DataGridColumnType.Badge">
                            Trạng thái
                        </th>
                        <th data-field="JoinDate" data-type="@DataGridColumnType.DateTime">
                            Ngày vào làm
                        </th>
                        <th data-field="Salary" data-type="@DataGridColumnType.Text">
                            Lương
                        </th>
                        <th data-field="Score" data-type="@DataGridColumnType.Text">
                            Điểm
                        </th>
                        <th data-field="IsActive" data-type="@DataGridColumnType.Badge">
                            Hoạt động
                        </th>
                        <th width="150" data-type="@DataGridColumnType.Actions" data-sortable="false">
                            Thao tác
                        </th>
                    </tr>
                </thead>
                <!-- tbody will be auto-generated by DataGrid with loading state -->
            </table>
        </div>
    </div>
    <!-- Pagination will be auto-generated by DataGrid when data-has-paging="true" -->
</div>

<!-- Include Demo Modal (Create/Edit/View) -->
@await Html.PartialAsync("_DemoModal")

<!-- Demo Modal -->
<div class="modal fade" id="demoModal" tabindex="-1" aria-labelledby="demoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="demoModalLabel">
                    <i class="bi bi-person-plus me-2"></i>Thêm demo item
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="demoForm">
                    <input type="hidden" id="demoId" name="id">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="name" name="name" placeholder="Họ tên" required>
                                <label for="name">Họ tên *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="email" class="form-control" id="email" name="email" placeholder="Email" required>
                                <label for="email">Email *</label>
                            </div>
                        </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="phone">Số điện thoại</label>
                                <input type="text" class="form-control" id="phone" name="phone">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="department">Phòng ban</label>
                                <select class="form-control" id="department" name="department">
                                    <option value="">Chọn phòng ban</option>
                                    <option value="IT">IT</option>
                                    <option value="Marketing">Marketing</option>
                                    <option value="Sales">Sales</option>
                                    <option value="HR">HR</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Operations">Operations</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="position">Chức vụ</label>
                                <select class="form-control" id="position" name="position">
                                    <option value="">Chọn chức vụ</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Developer">Developer</option>
                                    <option value="Analyst">Analyst</option>
                                    <option value="Specialist">Specialist</option>
                                    <option value="Coordinator">Coordinator</option>
                                    <option value="Assistant">Assistant</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="status">Trạng thái</label>
                                <select class="form-control" id="status" name="status">
                                    <option value="Active">Hoạt động</option>
                                    <option value="Inactive">Không hoạt động</option>
                                    <option value="Pending">Chờ duyệt</option>
                                    <option value="Suspended">Tạm ngưng</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="salary">Lương (VNĐ)</label>
                                <input type="number" class="form-control" id="salary" name="salary" min="0">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="score">Điểm</label>
                                <input type="number" class="form-control" id="score" name="score" min="0" max="100">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveItem()">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/components/statistics-cards.js"></script>
    <script src="~/js/components/datagrid.js"></script>
    <script src="~/js/components/demo-modal.js"></script>
    <script src="~/js/pages/demo-datagrid.js"></script>

    <script>
        let demoStatsInterval;
        let isDemoStatsVisible = false;

        // Khởi tạo demo statistics
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 Initializing Demo Statistics...');

            // Toggle Demo Stats
            const toggleBtn = document.getElementById('toggleDemoStats');
            const toggleText = document.getElementById('toggleDemoStatsText');
            const demoStatsSection = document.getElementById('demoStatistics');

            // Toggle function
            function toggleDemoStats() {
                isDemoStatsVisible = !isDemoStatsVisible;

                if (isDemoStatsVisible) {
                    demoStatsSection.style.display = 'block';
                    toggleText.textContent = 'Ẩn thống kê';
                    toggleBtn.classList.remove('btn-outline-secondary');
                    toggleBtn.classList.add('btn-secondary');

                    // Load initial data
                    updateDemoStats();

                    // Start auto-update
                    startDemoStatsAutoUpdate();
                } else {
                    demoStatsSection.style.display = 'none';
                    toggleText.textContent = 'Hiện thống kê';
                    toggleBtn.classList.remove('btn-secondary');
                    toggleBtn.classList.add('btn-outline-secondary');

                    // Stop auto-update
                    stopDemoStatsAutoUpdate();
                }
            }

            // Event listeners
            toggleBtn.addEventListener('click', toggleDemoStats);

            // Update demo statistics function
            function updateDemoStats() {
                if (window.demoStatisticsStats) {
                    // Show loading
                    window.demoStatisticsStats.showLoading();

                    // Simulate API call
                    setTimeout(() => {
                        const randomData = {
                            totalItems: Math.floor(Math.random() * 200) + 100,
                            activeItems: Math.floor(Math.random() * 150) + 50,
                            pendingItems: Math.floor(Math.random() * 30) + 10,
                            suspendedItems: Math.floor(Math.random() * 20) + 5
                        };

                        window.demoStatisticsStats.updateValues(randomData);
                        console.log('✅ Demo Statistics updated:', randomData);
                    }, 800);
                }
            }

            // Auto-update functions
            function startDemoStatsAutoUpdate() {
                if (demoStatsInterval) clearInterval(demoStatsInterval);

                demoStatsInterval = setInterval(() => {
                    if (isDemoStatsVisible) {
                        updateDemoStats();
                        console.log('🔄 Demo Statistics auto-updated');
                    }
                }, 30000); // Cập nhật mỗi 30 giây
            }

            function stopDemoStatsAutoUpdate() {
                if (demoStatsInterval) {
                    clearInterval(demoStatsInterval);
                    demoStatsInterval = null;
                }
            }

            // Cleanup on page unload
            window.addEventListener('beforeunload', stopDemoStatsAutoUpdate);
        });
    </script>
}
