@using AutoAppManagement.Models.Enums
@using AutoAppManagement.Models
@{
    ViewData["Title"] = "Demo DataGrid Component";
    ViewData["PageName"] = "demo-grid";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: bold;
    }

    /* Grid Styles */
    .table-responsive {
        border-radius: 0.375rem;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        color: #495057;
        background-color: #f8f9fa;
    }

    .table tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    /* Badge styles */
    .badge {
        font-size: 0.75rem;
        font-weight: 500;
    }

    #demoStatistics .card {
        transition: all 0.3s ease;
    }

    #demoStatistics .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
</style>



<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-table me-2 text-primary"></i>Demo DataGrid Component
        </h1>
        <p class="text-muted mb-0">Sử dụng DataGrid component với dữ liệu mẫu</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="toggleDemoStats">
            <i class="bi bi-bar-chart me-1"></i>
            <span id="toggleDemoStatsText">Hiện thống kê</span>
        </button>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active">Demo Grid</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Statistics Cards -->
<div id="demoStatistics" data-component="statistics" data-template="demo" style="display: none;">
    <!-- Cards will be auto-generated by StatisticsCards component -->
</div>
<!-- Demo Grid Filter - Card Filter Component (Bootstrap style) -->
<div data-component="card-filter"
     data-container-id="demoGridFilter"
     data-has-search="true"
     data-has-status="true"
     data-has-category="true"
     data-has-date-range="true"
     data-search-label="Tìm kiếm User"
     data-search-placeholder="Nhập tên, email, số điện thoại..."
     data-status-options="Active:Hoạt động,Inactive:Không hoạt động,Pending:Chờ duyệt,Suspended:Tạm ngưng"
     data-category-options="admin:Admin,user:User,guest:Guest,vip:VIP"
     data-debounce-ms="300"
     data-auto-apply="true">
</div>



<!-- DataGrid Component -->
<div class="card" data-component="datagrid"
     data-table-id="demoUserTable"
     data-get-url="@Url.Action("GetDemoUsers", "Demo")"
     data-base-url="/Demo"
     data-entity="user"
     data-page-size="10"
     data-auto-load="true"
     data-has-paging="true"
     data-title="Danh sách Users Demo"
     data-title-icon="bi bi-table"
     data-has-export="true"
     data-has-refresh="true"
     data-has-add="true"
     data-title-add="Thêm User"
     data-add-action="modal"
     data-add-target="#demoModal">

    <!-- Header will be auto-generated by DataGrid -->
    <div class="card-body p-0" data-section="table-container">
        <div class="table-responsive" data-element="table-wrapper">
            <table class="table table-hover mb-0" id="demoUserTable">
                <thead class="table-light" data-section="table-header">
                    <tr data-row="header">
                        <th width="50" data-type="@DataGridColumnType.Checkbox" data-sortable="false" class="text-center">
                            <input type="checkbox" class="form-check-input" id="selectAll" data-action="select-all" data-target="all-rows">
                        </th>
                        <th data-field="Avatar" data-type="@DataGridColumnType.Avatar">
                            Avatar
                        </th>
                        <th data-field="Name" data-type="@DataGridColumnType.User">
                            Thông tin User
                        </th>
                        <th data-field="Email" data-type="@DataGridColumnType.Email">
                            Email
                        </th>
                        <th data-field="Phone" data-type="@DataGridColumnType.Text">
                            Số điện thoại
                        </th>
                        <th data-field="Role" data-type="@DataGridColumnType.Badge">
                            Vai trò
                        </th>
                        <th data-field="Status" data-type="@DataGridColumnType.Badge">
                            Trạng thái
                        </th>
                        <th data-field="LastLogin" data-type="@DataGridColumnType.DateTime">
                            Lần cuối đăng nhập
                        </th>
                        <th width="150" data-type="@DataGridColumnType.Actions" data-sortable="false">
                            Thao tác
                        </th>
                    </tr>
                </thead>
                <!-- tbody will be auto-generated by DataGrid with loading state -->
                <tbody>
                    <!-- Sample rows for demo purposes -->
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="form-check-input row-checkbox" value="1">
                        </td>
                        <td>
                            <i class="bi bi-person-circle fs-4 text-primary"></i>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-primary text-white me-3">
                                    NA
                                </div>
                                <div>
                                    <div class="fw-bold">Nguyễn Văn An</div>
                                    <small class="text-muted">an.nguyen@company.com</small>
                                </div>
                            </div>
                        </td>
                        <td>an.nguyen@company.com</td>
                        <td>0901234567</td>
                        <td><span class="badge bg-danger">Admin</span></td>
                        <td><span class="badge bg-success">Hoạt động</span></td>
                        <td>2 phút trước</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" title="Xem chi tiết" onclick="viewUser(1)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-warning" title="Chỉnh sửa" onclick="editUser(1)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger" title="Xóa" onclick="deleteUser(1)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="form-check-input row-checkbox" value="2">
                        </td>
                        <td>
                            <i class="bi bi-person-fill fs-4 text-success"></i>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-success text-white me-3">
                                    TB
                                </div>
                                <div>
                                    <div class="fw-bold">Trần Thị Bình</div>
                                    <small class="text-muted">binh.tran@company.com</small>
                                </div>
                            </div>
                        </td>
                        <td>binh.tran@company.com</td>
                        <td>0912345678</td>
                        <td><span class="badge bg-primary">User</span></td>
                        <td><span class="badge bg-success">Hoạt động</span></td>
                        <td>15 phút trước</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" title="Xem chi tiết" onclick="viewUser(2)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-warning" title="Chỉnh sửa" onclick="editUser(2)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger" title="Xóa" onclick="deleteUser(2)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="form-check-input row-checkbox" value="3">
                        </td>
                        <td>
                            <i class="bi bi-person fs-4 text-secondary"></i>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle bg-secondary text-white me-3">
                                    LC
                                </div>
                                <div>
                                    <div class="fw-bold">Lê Minh Cường</div>
                                    <small class="text-muted">cuong.le@company.com</small>
                                </div>
                            </div>
                        </td>
                        <td>cuong.le@company.com</td>
                        <td>0923456789</td>
                        <td><span class="badge bg-info">Moderator</span></td>
                        <td><span class="badge bg-secondary">Không hoạt động</span></td>
                        <td>2 giờ trước</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" title="Xem chi tiết" onclick="viewUser(3)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-warning" title="Chỉnh sửa" onclick="editUser(3)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger" title="Xóa" onclick="deleteUser(3)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- Pagination will be auto-generated by DataGrid when data-has-paging="true" -->
    <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted">
                Hiển thị 1-10 trong tổng số 247 bản ghi
            </div>
            <nav aria-label="Phân trang">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1">Trước</a>
                    </li>
                    <li class="page-item active">
                        <a class="page-link" href="#">1</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">3</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Include Demo Modal (Create/Edit/View) -->
@await Html.PartialAsync("_DemoModal")

<!-- Demo User Modal -->
<div class="modal fade" id="demoModal" tabindex="-1" aria-labelledby="demoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="demoModalLabel">
                    <i class="bi bi-person-plus me-2"></i>Thêm User mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="demoForm">
                    <input type="hidden" id="demoId" name="id">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="name" name="name" placeholder="Họ tên" required>
                                <label for="name">Họ tên *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="email" class="form-control" id="email" name="email" placeholder="Email" required>
                                <label for="email">Email *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="tel" class="form-control" id="phone" name="phone" placeholder="Số điện thoại">
                                <label for="phone">Số điện thoại</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="role" name="role" required>
                                    <option value="">Chọn vai trò</option>
                                    <option value="admin">Admin</option>
                                    <option value="user">User</option>
                                    <option value="moderator">Moderator</option>
                                    <option value="guest">Guest</option>
                                    <option value="vip">VIP</option>
                                </select>
                                <label for="role">Vai trò *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="status" name="status" required>
                                    <option value="">Chọn trạng thái</option>
                                    <option value="active">Hoạt động</option>
                                    <option value="inactive">Không hoạt động</option>
                                    <option value="pending">Chờ duyệt</option>
                                    <option value="suspended">Tạm ngưng</option>
                                </select>
                                <label for="status">Trạng thái *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="salary" name="salary" placeholder="Lương" min="0">
                                <label for="salary">Lương (VNĐ)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="score" name="score" placeholder="Điểm" min="0" max="100">
                                <label for="score">Điểm đánh giá</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="department" name="department">
                                    <option value="">Chọn phòng ban</option>
                                    <option value="IT">IT</option>
                                    <option value="Marketing">Marketing</option>
                                    <option value="Sales">Sales</option>
                                    <option value="HR">HR</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Operations">Operations</option>
                                </select>
                                <label for="department">Phòng ban</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="position" name="position">
                                    <option value="">Chọn chức vụ</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Developer">Developer</option>
                                    <option value="Analyst">Analyst</option>
                                    <option value="Specialist">Specialist</option>
                                    <option value="Coordinator">Coordinator</option>
                                    <option value="Assistant">Assistant</option>
                                </select>
                                <label for="position">Chức vụ</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea class="form-control" id="notes" name="notes" placeholder="Ghi chú" style="height: 100px"></textarea>
                                <label for="notes">Ghi chú</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-primary" id="saveUser">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/css/components/datagrid.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/components/statistics-cards.js"></script>
    <script src="~/js/components/datagrid.js"></script>
    <script src="~/js/pages/demo-grid.js"></script>

    <script>
        // Select all functionality
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Action functions
        function viewUser(id) {
            Swal.fire({
                title: 'Chi tiết User',
                text: 'Xem chi tiết user ID: ' + id,
                icon: 'info',
                confirmButtonText: 'OK'
            });
        }

        function editUser(id) {
            document.getElementById('demoModalLabel').innerHTML = '<i class="bi bi-pencil me-2"></i>Chỉnh sửa User';
            // Load user data here...
            // Simulate loading data for edit
            if (id === 1) {
                document.getElementById('name').value = 'Nguyễn Văn An';
                document.getElementById('email').value = 'an.nguyen@company.com';
                document.getElementById('phone').value = '0901234567';
                document.getElementById('role').value = 'admin';
                document.getElementById('status').value = 'active';
            }
            new bootstrap.Modal(document.getElementById('demoModal')).show();
        }

        function deleteUser(id) {
            Swal.fire({
                title: 'Xác nhận xóa',
                text: 'Bạn có chắc chắn muốn xóa user này?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire(
                        'Đã xóa!',
                        'User đã được xóa thành công.',
                        'success'
                    );
                }
            });
        }

        // Save user
        document.getElementById('saveUser').addEventListener('click', function() {
            const form = document.getElementById('demoForm');
            if (form.checkValidity()) {
                Swal.fire({
                    title: 'Thành công!',
                    text: 'Đã lưu user thành công!',
                    icon: 'success',
                    timer: 2000
                });
                bootstrap.Modal.getInstance(document.getElementById('demoModal')).hide();
            } else {
                form.reportValidity();
            }
        });

        // Filter functionality - Component-based filter handles this automatically
        // No manual filter reset needed since component handles it internally

        // Reset modal when closed
        document.getElementById('demoModal').addEventListener('hidden.bs.modal', function() {
            document.getElementById('demoForm').reset();
            document.getElementById('demoModalLabel').innerHTML = '<i class="bi bi-person-plus me-2"></i>Thêm User mới';
        });

        // Demo statistics toggle
        document.getElementById('toggleDemoStats').addEventListener('click', function() {
            const stats = document.getElementById('demoStatistics');
            const toggleText = document.getElementById('toggleDemoStatsText');
            
            if (stats.style.display === 'none') {
                stats.style.display = 'block';
                toggleText.textContent = 'Ẩn thống kê';
                this.classList.remove('btn-outline-secondary');
                this.classList.add('btn-secondary');
            } else {
                stats.style.display = 'none';
                toggleText.textContent = 'Hiện thống kê';
                this.classList.remove('btn-secondary');
                this.classList.add('btn-outline-secondary');
            }
        });

        // Initialize demo statistics
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 Demo Grid initialized with CustomerAccount pattern');
        });
    </script>
}


