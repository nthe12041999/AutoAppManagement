@using AutoAppManagement.Models.Enums
@{
    ViewData["Title"] = "Demo DataGrid Component";
    ViewData["PageName"] = "demo-grid";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-table me-2 text-primary"></i>Demo DataGrid Component
        </h1>
        <p class="text-muted mb-0">Sử dụng DataGrid component với dữ liệu mẫu</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="toggleDemoStats">
            <i class="bi bi-bar-chart me-1"></i>
            <span id="toggleDemoStatsText">Hiện thống kê</span>
        </button>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active">Demo Grid</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Statistics Cards -->
<div id="demoStatistics" data-component="statistics" data-template="demo" style="display: none;">
    <!-- Cards will be auto-generated by StatisticsCards component -->
</div>
<!-- Demo Grid Filter - Card Filter Component (Bootstrap style) -->
<div data-component="card-filter"
     data-container-id="demoGridFilter"
     data-has-search="true"
     data-has-status="true"
     data-has-category="true"
     data-has-date-range="true"
     data-search-label="Tìm kiếm User"
     data-search-placeholder="Nhập tên, email, số điện thoại..."
     data-status-options="Active:Hoạt động,Inactive:Không hoạt động,Pending:Chờ duyệt,Suspended:Tạm ngưng"
     data-category-options="admin:Admin,user:User,guest:Guest,vip:VIP"
     data-debounce-ms="300"
     data-auto-apply="true">
</div>



<!-- Data Grid Component (Auto-generate with fake data) -->
<div data-component="data-grid"
     data-container-id="demoDataGrid"
     data-entity="User"
     data-entity-plural="Users"
     data-columns="avatar:Avatar:icon,name:Tên:text,email:Email:text,phone:Điện thoại:text,role:Vai trò:badge,status:Trạng thái:badge,lastLogin:Lần cuối:text,actions:Thao tác:actions"
     data-has-add="true"
     data-has-refresh="true"
     data-has-export="true"
     data-has-select-all="true"
     data-add-label="Thêm User"
     data-refresh-label="Làm mới"
     data-export-label="Xuất Excel"
     data-sample-data='[
         {"id":1,"avatar":"person-circle","name":"Nguyễn Văn An","email":"an.nguyen@company.com","phone":"0901234567","role":"Admin","status":"Hoạt động","badge":"success","lastLogin":"2 phút trước"},
         {"id":2,"avatar":"person-fill","name":"Trần Thị Bình","email":"binh.tran@company.com","phone":"0912345678","role":"User","status":"Hoạt động","badge":"success","lastLogin":"15 phút trước"},
         {"id":3,"avatar":"person","name":"Lê Minh Cường","email":"cuong.le@company.com","phone":"0923456789","role":"Moderator","status":"Không hoạt động","badge":"secondary","lastLogin":"2 giờ trước"},
         {"id":4,"avatar":"person-check","name":"Phạm Thu Dung","email":"dung.pham@company.com","phone":"0934567890","role":"User","status":"Chờ duyệt","badge":"warning","lastLogin":"1 ngày trước"},
         {"id":5,"avatar":"person-x","name":"Hoàng Văn Em","email":"em.hoang@company.com","phone":"0945678901","role":"Guest","status":"Tạm ngưng","badge":"danger","lastLogin":"3 ngày trước"},
         {"id":6,"avatar":"person-star","name":"Vũ Thị Phương","email":"phuong.vu@company.com","phone":"0956789012","role":"VIP","status":"Hoạt động","badge":"primary","lastLogin":"30 phút trước"},
         {"id":7,"avatar":"person-gear","name":"Đỗ Minh Giang","email":"giang.do@company.com","phone":"0967890123","role":"Admin","status":"Hoạt động","badge":"success","lastLogin":"1 giờ trước"},
         {"id":8,"avatar":"person-badge","name":"Bùi Thu Hà","email":"ha.bui@company.com","phone":"0978901234","role":"Support","status":"Hoạt động","badge":"info","lastLogin":"45 phút trước"},
         {"id":9,"avatar":"person-lines-fill","name":"Ngô Văn Inh","email":"inh.ngo@company.com","phone":"0989012345","role":"User","status":"Không hoạt động","badge":"secondary","lastLogin":"1 tuần trước"},
         {"id":10,"avatar":"person-plus","name":"Lý Thị Kim","email":"kim.ly@company.com","phone":"0990123456","role":"User","status":"Chờ duyệt","badge":"warning","lastLogin":"2 ngày trước"}
     ]'
     data-has-pagination="true"
     data-page-size="10"
     data-total-items="247">
</div>

<!-- Include Demo Modal (Create/Edit/View) -->
@await Html.PartialAsync("_DemoModal")

<!-- Demo Modal -->
<div class="modal fade" id="demoModal" tabindex="-1" aria-labelledby="demoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="demoModalLabel">
                    <i class="bi bi-person-plus me-2"></i>Thêm demo item
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="demoForm">
                    <input type="hidden" id="demoId" name="id">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="name" name="name" placeholder="Họ tên" required>
                                <label for="name">Họ tên *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="email" class="form-control" id="email" name="email" placeholder="Email" required>
                                <label for="email">Email *</label>
                            </div>
                        </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="phone">Số điện thoại</label>
                                <input type="text" class="form-control" id="phone" name="phone">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="department">Phòng ban</label>
                                <select class="form-control" id="department" name="department">
                                    <option value="">Chọn phòng ban</option>
                                    <option value="IT">IT</option>
                                    <option value="Marketing">Marketing</option>
                                    <option value="Sales">Sales</option>
                                    <option value="HR">HR</option>
                                    <option value="Finance">Finance</option>
                                    <option value="Operations">Operations</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="position">Chức vụ</label>
                                <select class="form-control" id="position" name="position">
                                    <option value="">Chọn chức vụ</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Developer">Developer</option>
                                    <option value="Analyst">Analyst</option>
                                    <option value="Specialist">Specialist</option>
                                    <option value="Coordinator">Coordinator</option>
                                    <option value="Assistant">Assistant</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="status">Trạng thái</label>
                                <select class="form-control" id="status" name="status">
                                    <option value="Active">Hoạt động</option>
                                    <option value="Inactive">Không hoạt động</option>
                                    <option value="Pending">Chờ duyệt</option>
                                    <option value="Suspended">Tạm ngưng</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="salary">Lương (VNĐ)</label>
                                <input type="number" class="form-control" id="salary" name="salary" min="0">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="score">Điểm</label>
                                <input type="number" class="form-control" id="score" name="score" min="0" max="100">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveItem()">Lưu</button>
            </div>
        </div>
    </div>
</div>


