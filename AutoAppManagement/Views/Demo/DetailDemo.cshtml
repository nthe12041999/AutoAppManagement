@using AutoAppManagement.Models.Enums
@using AutoAppManagement.Models
@{
    ViewData["Title"] = "Chi tiết Demo Components";
    ViewData["PageName"] = "detail-demo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-puzzle me-2 text-primary"></i>Chi tiết Demo Components
        </h1>
        <p class="text-muted mb-0">Liệt kê và giới thiệu các component được sử dụng trong hệ thống</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" id="expandAllComponents">
            <i class="bi bi-arrows-expand me-1"></i>Mở rộng tất cả
        </button>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Grid", "Demo")">Demo Grid</a></li>
                <li class="breadcrumb-item active">Chi tiết Components</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Components Overview Statistics -->
<div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="d-flex align-items-center justify-content-center mb-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-grid-3x3-gap text-primary fs-4"></i>
                    </div>
                </div>
                <h5 class="card-title mb-1">Data Grid</h5>
                <p class="text-muted small mb-2">Component hiển thị dữ liệu dạng bảng</p>
                <span class="badge bg-success-subtle text-success">Active</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="d-flex align-items-center justify-content-center mb-3">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-funnel text-success fs-4"></i>
                    </div>
                </div>
                <h5 class="card-title mb-1">Grid Filter</h5>
                <p class="text-muted small mb-2">Bộ lọc dữ liệu nâng cao</p>
                <span class="badge bg-success-subtle text-success">Active</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="d-flex align-items-center justify-content-center mb-3">
                    <div class="bg-info bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-bar-chart text-info fs-4"></i>
                    </div>
                </div>
                <h5 class="card-title mb-1">Statistics Cards</h5>
                <p class="text-muted small mb-2">Thẻ thống kê động</p>
                <span class="badge bg-success-subtle text-success">Active</span>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="d-flex align-items-center justify-content-center mb-3">
                    <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-check2-square text-warning fs-4"></i>
                    </div>
                </div>
                <h5 class="card-title mb-1">Form Validation</h5>
                <p class="text-muted small mb-2">Xác thực form nâng cao</p>
                <span class="badge bg-success-subtle text-success">Active</span>
            </div>
        </div>
    </div>
</div>

<!-- Component Details Accordion -->
<div class="accordion" id="componentDetailsAccordion">
    
    <!-- Data Grid Component -->
    <div class="accordion-item border-0 shadow-sm mb-3">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#dataGridComponent" aria-expanded="true" aria-controls="dataGridComponent">
                <i class="bi bi-grid-3x3-gap me-2 text-primary"></i>
                <strong>Data Grid Component</strong>
                <span class="badge bg-primary-subtle text-primary ms-auto me-2">Core</span>
            </button>
        </h2>
        <div id="dataGridComponent" class="accordion-collapse collapse show" data-bs-parent="#componentDetailsAccordion">
            <div class="accordion-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="mb-3">Mô tả</h5>
                        <p>Component chính để hiển thị dữ liệu dạng bảng với các tính năng nâng cao như phân trang, sắp xếp, tìm kiếm và CRUD operations.</p>
                        
                        <h6 class="mt-4 mb-2">Tính năng chính:</h6>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check2 text-success me-2"></i>Hiển thị dữ liệu dạng bảng responsive</li>
                            <li><i class="bi bi-check2 text-success me-2"></i>Phân trang tự động</li>
                            <li><i class="bi bi-check2 text-success me-2"></i>Sắp xếp theo cột</li>
                            <li><i class="bi bi-check2 text-success me-2"></i>AJAX loading</li>
                            <li><i class="bi bi-check2 text-success me-2"></i>Custom column types</li>
                            <li><i class="bi bi-check2 text-success me-2"></i>Action buttons (View, Edit, Delete)</li>
                        </ul>
                        
                        <h6 class="mt-4 mb-2">File liên quan:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <code class="bg-light px-2 py-1 rounded">data-grid.js</code>
                            <code class="bg-light px-2 py-1 rounded">demo-grid.js</code>
                            <code class="bg-light px-2 py-1 rounded">demo-grid.css</code>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0"><i class="bi bi-code-slash me-2"></i>Cách sử dụng</h6>
                            </div>
                            <div class="card-body">
                                <pre class="small mb-0"><code>&lt;div data-component="data-grid"
     data-container-id="userGrid"
     data-entity="User"
     data-get-url="/api/users"
     data-has-pagination="true"&gt;
&lt;/div&gt;</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Filter Component -->
    <div class="accordion-item border-0 shadow-sm mb-3">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#gridFilterComponent" aria-expanded="false" aria-controls="gridFilterComponent">
                <i class="bi bi-funnel me-2 text-success"></i>
                <strong>Grid Filter Component</strong>
                <span class="badge bg-success-subtle text-success ms-auto me-2">Filter</span>
            </button>
        </h2>
        <div id="gridFilterComponent" class="accordion-collapse collapse" data-bs-parent="#componentDetailsAccordion">
            <div class="accordion-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="mb-3">Mô tả</h5>
                        <p>Bộ lọc nâng cao cho DataGrid với nhiều loại filter khác nhau và khả năng tùy chỉnh cao.</p>
                        
                        <h6 class="mt-4 mb-2">Các loại filter:</h6>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-search text-primary me-2"></i>Text Search - Tìm kiếm văn bản</li>
                            <li><i class="bi bi-list-check text-info me-2"></i>Status Filter - Lọc theo trạng thái</li>
                            <li><i class="bi bi-tags text-warning me-2"></i>Category Filter - Lọc theo danh mục</li>
                            <li><i class="bi bi-calendar-range text-success me-2"></i>Date Range - Lọc theo khoảng thời gian</li>
                            <li><i class="bi bi-123 text-secondary me-2"></i>Number Range - Lọc theo khoảng số</li>
                        </ul>
                        
                        <h6 class="mt-4 mb-2">File liên quan:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <code class="bg-light px-2 py-1 rounded">grid-filter.js</code>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0"><i class="bi bi-code-slash me-2"></i>Cách sử dụng</h6>
                            </div>
                            <div class="card-body">
                                <pre class="small mb-0"><code>&lt;div data-component="card-filter"
     data-has-search="true"
     data-has-status="true"
     data-has-date-range="true"
     data-status-options="active:Active,inactive:Inactive"&gt;
&lt;/div&gt;</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards Component -->
    <div class="accordion-item border-0 shadow-sm mb-3">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#statisticsComponent" aria-expanded="false" aria-controls="statisticsComponent">
                <i class="bi bi-bar-chart me-2 text-info"></i>
                <strong>Statistics Cards Component</strong>
                <span class="badge bg-info-subtle text-info ms-auto me-2">Dashboard</span>
            </button>
        </h2>
        <div id="statisticsComponent" class="accordion-collapse collapse" data-bs-parent="#componentDetailsAccordion">
            <div class="accordion-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="mb-3">Mô tả</h5>
                        <p>Component hiển thị thống kê dưới dạng cards với hiệu ứng động và khả năng tùy chỉnh template.</p>
                        
                        <h6 class="mt-4 mb-2">Tính năng:</h6>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-speedometer2 text-primary me-2"></i>Loading animation</li>
                            <li><i class="bi bi-palette text-info me-2"></i>Multiple color themes</li>
                            <li><i class="bi bi-graph-up text-success me-2"></i>Trend indicators</li>
                            <li><i class="bi bi-arrow-clockwise text-warning me-2"></i>Auto refresh</li>
                            <li><i class="bi bi-file-earmark-code text-secondary me-2"></i>Template system</li>
                        </ul>
                        
                        <h6 class="mt-4 mb-2">Templates có sẵn:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-primary-subtle text-primary">default</span>
                            <span class="badge bg-success-subtle text-success">demo</span>
                            <span class="badge bg-info-subtle text-info">dashboard</span>
                            <span class="badge bg-warning-subtle text-warning">compact</span>
                        </div>
                        
                        <h6 class="mt-4 mb-2">File liên quan:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <code class="bg-light px-2 py-1 rounded">statistics-cards.js</code>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-code-slash me-2"></i>Cách sử dụng</h6>
                            </div>
                            <div class="card-body">
                                <pre class="small mb-0"><code>&lt;div data-component="statistics"
     data-template="demo"
     data-auto-refresh="30000"&gt;
&lt;/div&gt;</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Validation Component -->
    <div class="accordion-item border-0 shadow-sm mb-3">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#validationComponent" aria-expanded="false" aria-controls="validationComponent">
                <i class="bi bi-check2-square me-2 text-warning"></i>
                <strong>Form Validation Component</strong>
                <span class="badge bg-warning-subtle text-warning ms-auto me-2">Form</span>
            </button>
        </h2>
        <div id="validationComponent" class="accordion-collapse collapse" data-bs-parent="#componentDetailsAccordion">
            <div class="accordion-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="mb-3">Mô tả</h5>
                        <p>Hệ thống validation form toàn diện với jQuery, hỗ trợ real-time validation và Bootstrap 5 styling.</p>
                        
                        <h6 class="mt-4 mb-2">Validation types:</h6>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-asterisk text-danger me-2"></i>Required fields</li>
                            <li><i class="bi bi-envelope text-primary me-2"></i>Email format</li>
                            <li><i class="bi bi-telephone text-info me-2"></i>Phone number (Vietnam)</li>
                            <li><i class="bi bi-123 text-success me-2"></i>Number range</li>
                            <li><i class="bi bi-type text-warning me-2"></i>Text length</li>
                            <li><i class="bi bi-calendar text-secondary me-2"></i>Date validation</li>
                        </ul>
                        
                        <h6 class="mt-4 mb-2">Validation events:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-light text-dark">onBlur</span>
                            <span class="badge bg-light text-dark">onInput</span>
                            <span class="badge bg-light text-dark">onSubmit</span>
                        </div>
                        
                        <h6 class="mt-4 mb-2">File liên quan:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <code class="bg-light px-2 py-1 rounded">app-validation.js</code>
                            <code class="bg-light px-2 py-1 rounded">form-validation.js</code>
                            <code class="bg-light px-2 py-1 rounded">demo-modal-validation.js</code>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0">
                            <div class="card-header bg-warning text-white">
                                <h6 class="mb-0"><i class="bi bi-code-slash me-2"></i>Cách sử dụng</h6>
                            </div>
                            <div class="card-body">
                                <pre class="small mb-0"><code>&lt;form id="myForm" data-validate&gt;
  &lt;input type="email" required&gt;
  &lt;div class="invalid-feedback"&gt;
    Error message
  &lt;/div&gt;
&lt;/form&gt;

&lt;script&gt;
initFormValidation('myForm');
&lt;/script&gt;</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom Column Types -->
    <div class="accordion-item border-0 shadow-sm mb-3">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#columnTypesComponent" aria-expanded="false" aria-controls="columnTypesComponent">
                <i class="bi bi-columns-gap me-2 text-purple"></i>
                <strong>Custom Column Types</strong>
                <span class="badge bg-dark-subtle text-dark ms-auto me-2">Grid</span>
            </button>
        </h2>
        <div id="columnTypesComponent" class="accordion-collapse collapse" data-bs-parent="#componentDetailsAccordion">
            <div class="accordion-body">
                <div class="row">
                    <div class="col-12">
                        <h5 class="mb-3">Các loại cột tùy chỉnh</h5>
                        <p>DataGrid hỗ trợ nhiều loại cột tùy chỉnh với formatting và styling đặc biệt.</p>
                        
                        <div class="row g-3 mt-3">
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-start border-primary border-3 h-100">
                                    <div class="card-body">
                                        <h6 class="card-title text-primary"><i class="bi bi-person-circle me-2"></i>user-info</h6>
                                        <p class="card-text small">Hiển thị thông tin user với avatar và tên</p>
                                        <code class="small">type: 'user-info'</code>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-start border-success border-3 h-100">
                                    <div class="card-body">
                                        <h6 class="card-title text-success"><i class="bi bi-envelope me-2"></i>email-link</h6>
                                        <p class="card-text small">Email có thể click để gửi mail</p>
                                        <code class="small">type: 'email-link'</code>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-start border-info border-3 h-100">
                                    <div class="card-body">
                                        <h6 class="card-title text-info"><i class="bi bi-telephone me-2"></i>phone-number</h6>
                                        <p class="card-text small">Số điện thoại có format đẹp</p>
                                        <code class="small">type: 'phone-number'</code>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-start border-warning border-3 h-100">
                                    <div class="card-body">
                                        <h6 class="card-title text-warning"><i class="bi bi-shield-check me-2"></i>status-badge</h6>
                                        <p class="card-text small">Badge hiển thị trạng thái với màu sắc</p>
                                        <code class="small">type: 'status-badge'</code>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-start border-secondary border-3 h-100">
                                    <div class="card-body">
                                        <h6 class="card-title text-secondary"><i class="bi bi-calendar me-2"></i>datetime-formatted</h6>
                                        <p class="card-text small">Định dạng ngày giờ theo locale</p>
                                        <code class="small">type: 'datetime-formatted'</code>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-start border-danger border-3 h-100">
                                    <div class="card-body">
                                        <h6 class="card-title text-danger"><i class="bi bi-gear me-2"></i>actions</h6>
                                        <p class="card-text small">Cột action buttons (View, Edit, Delete)</p>
                                        <code class="small">type: 'actions'</code>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Demo Form Validation Example -->
<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-play-circle me-2"></i>Demo Form Validation</h5>
    </div>
    <div class="card-body">
        <p class="mb-3">Thử nghiệm form validation với các rule khác nhau:</p>
        
        <form id="demoValidationForm" data-validate class="row g-3">
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="text" class="form-control" id="demoName" name="name" placeholder="Họ tên" required minlength="2">
                    <label for="demoName">Họ tên *</label>
                    <div class="invalid-feedback">Vui lòng nhập họ tên (tối thiểu 2 ký tự)</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="email" class="form-control" id="demoEmail" name="email" placeholder="Email" required>
                    <label for="demoEmail">Email *</label>
                    <div class="invalid-feedback">Vui lòng nhập email hợp lệ</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="tel" class="form-control" id="demoPhone" name="phone" placeholder="Số điện thoại" data-phone-pattern="vietnam">
                    <label for="demoPhone">Số điện thoại</label>
                    <div class="invalid-feedback">Số điện thoại không đúng định dạng Việt Nam</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-floating">
                    <input type="number" class="form-control" id="demoAge" name="age" placeholder="Tuổi" min="18" max="100">
                    <label for="demoAge">Tuổi</label>
                    <div class="invalid-feedback">Tuổi phải từ 18 đến 100</div>
                </div>
            </div>
            <div class="col-12">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary" onclick="validateForm('demoValidationForm')">
                        <i class="bi bi-check-circle me-1"></i>Validate Form
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="resetFormValidation('demoValidationForm')">
                        <i class="bi bi-arrow-clockwise me-1"></i>Reset
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .border-start {
            border-left-width: 3px !important;
        }
        
        .accordion-button:not(.collapsed) {
            background-color: var(--bs-primary-bg-subtle);
            color: var(--bs-primary-text-emphasis);
        }
        
        .accordion-button:focus {
            box-shadow: none;
        }
        
        .bg-primary-bg-subtle {
            background-color: rgba(13, 110, 253, 0.1) !important;
        }
        
        .text-purple {
            color: #6f42c1 !important;
        }
        
        pre code {
            font-size: 0.75rem;
            line-height: 1.4;
        }
        
        .statistics-card {
            transition: all 0.3s ease;
        }
        
        .statistics-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }
    </style>
}

@section Scripts {
    <script src="~/js/components/app-validation.js"></script>
    <script src="~/js/components/form-validation.js"></script>
    
    <script>
        $(document).ready(function() {
            // Expand/Collapse all accordion items
            $('#expandAllComponents').on('click', function() {
                var $btn = $(this);
                var $icon = $btn.find('i');
                var $accordionItems = $('.accordion-collapse');
                
                if ($icon.hasClass('bi-arrows-expand')) {
                    // Expand all
                    $accordionItems.addClass('show');
                    $icon.removeClass('bi-arrows-expand').addClass('bi-arrows-collapse');
                    $btn.find('span').text('Thu gọn tất cả');
                } else {
                    // Collapse all
                    $accordionItems.removeClass('show');
                    $icon.removeClass('bi-arrows-collapse').addClass('bi-arrows-expand');
                    $btn.find('span').text('Mở rộng tất cả');
                }
            });
            
            // Add animation to statistics cards
            $('.card').hover(
                function() {
                    $(this).addClass('statistics-card');
                },
                function() {
                    $(this).removeClass('statistics-card');
                }
            );
            
            console.log('✅ Detail Demo Components page loaded');
        });
    </script>
}
