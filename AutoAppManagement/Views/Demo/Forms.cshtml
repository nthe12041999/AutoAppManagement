@using AutoAppManagement.Models.Enums
@using AutoAppManagement.Helpers
@{
    ViewData["Title"] = "Demo Forms";
    ViewData["PageName"] = "demo-forms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-ui-checks me-2 text-info"></i>Demo Forms
        </h1>
        <p class="text-muted mb-0">Demo các loại form controls cơ bản, data-binding và nút chức năng</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#optionsHelperDemo">
            <i class="bi bi-list-ul me-2"></i>Options Helper Demo
        </button>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Demo")">Demo</a></li>
                <li class="breadcrumb-item active">Forms</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Demo Form -->
<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-clipboard-data me-2"></i>Demo Form - Tất cả Controls
                </h5>
            </div>
            <div class="card-body">
                <form id="demoForm" novalidate>
                    <!-- Text Inputs với Data-Binding -->
                    <div class="row">
                        <div class="col-md-6">
                            <div data-type="@ControlType.Text"
                                 data-id="fullName"
                                 data-name="fullName"
                                 data-label="Họ và tên"
                                 data-placeholder="Nhập họ và tên"
                                 data-class="text-capitalize"
                                 data-required></div>
                        </div>
                        <div class="col-md-6">
                            <div data-type="@ControlType.Email"
                                 data-id="email"
                                 data-name="email"
                                 data-label="Email"
                                 data-placeholder="example@email.com"
                                 data-class="border-primary"
                                 data-required></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div data-type="@ControlType.Tel"
                                 data-id="phone"
                                 data-name="phone"
                                 data-label="Số điện thoại"
                                 data-placeholder="0XXX XXX XXX"
                                 data-class="border-info"
                                 data-help-text="Định dạng: 10 số bắt đầu bằng 03, 05, 07, 08, 09"></div>
                        </div>
                        <div class="col-md-6">
                            <div data-type="@ControlType.Number"
                                 data-id="age"
                                 data-name="age"
                                 data-label="Tuổi"
                                 data-min="18"
                                 data-max="65"
                                 data-value="25"
                                 data-class="text-center border-warning"
                                 data-required></div>
                        </div>
                    </div>

                    <!-- Select với Data-Binding -->
                    <div class="row">
                        <div class="col-md-6">
                            <div data-type="@ControlType.Select"
                                 data-id="position"
                                 data-name="position"
                                 data-label="Vị trí công việc"
                                 data-class="border-success"
                                 data-required
                                 data-options='[
                                     {"value":"","text":"Chọn vị trí"},
                                     {"value":"developer","text":"Developer"},
                                     {"value":"designer","text":"Designer"},
                                     {"value":"tester","text":"Tester"},
                                     {"value":"manager","text":"Manager"}
                                 ]'></div>
                        </div>
                        <div class="col-md-6">
                            <div data-type="@ControlType.Select"
                                 data-id="experience"
                                 data-name="experience"
                                 data-label="Kinh nghiệm"
                                 data-class="rounded-pill"
                                 data-options='[
                                     {"value":"","text":"Chọn kinh nghiệm"},
                                     {"value":"fresher","text":"Fresher"},
                                     {"value":"1-2","text":"1-2 năm"},
                                     {"value":"3-5","text":"3-5 năm"},
                                     {"value":"5+","text":"Trên 5 năm"}
                                 ]'></div>
                        </div>
                    </div>

                    <!-- Radio buttons -->
                    <div class="mb-3">
                        <label class="form-label">Giới tính *</label>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="gender" id="male" value="male" required>
                                    <label class="form-check-label" for="male">Nam</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="gender" id="female" value="female" required>
                                    <label class="form-check-label" for="female">Nữ</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="gender" id="other" value="other" required>
                                    <label class="form-check-label" for="other">Khác</label>
                                </div>
                            </div>
                        </div>
                        <div class="invalid-feedback">Vui lòng chọn giới tính</div>
                    </div>

                    <!-- Checkboxes -->
                    <div class="mb-3">
                        <label class="form-label">Kỹ năng *</label>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="html" value="html" name="skills">
                                    <label class="form-check-label" for="html">HTML</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="css" value="css" name="skills">
                                    <label class="form-check-label" for="css">CSS</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="javascript" value="javascript" name="skills">
                                    <label class="form-check-label" for="javascript">JavaScript</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="csharp" value="csharp" name="skills">
                                    <label class="form-check-label" for="csharp">C#</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-text">Chọn ít nhất 1 kỹ năng</div>
                        <div class="invalid-feedback" id="skillsError">Vui lòng chọn ít nhất 1 kỹ năng</div>
                    </div>

                    <!-- Date -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="startDate" class="form-label">Ngày bắt đầu làm việc *</label>
                            <input type="date" class="form-control" id="startDate" required>
                            <div class="invalid-feedback">Vui lòng chọn ngày bắt đầu làm việc</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="salary" class="form-label">Mức lương mong muốn (VNĐ) *</label>
                            <input type="number" class="form-control" id="salary" placeholder="15000000" step="1000000" min="5000000" max="100000000" required>
                            <div class="invalid-feedback">Mức lương phải từ 5 triệu đến 100 triệu VNĐ</div>
                        </div>
                    </div>

                    <!-- Range -->
                    <div class="mb-3">
                        <label for="workHours" class="form-label">Số giờ làm việc/tuần: <span id="hoursValue">40</span> giờ</label>
                        <input type="range" class="form-range" id="workHours" min="20" max="60" value="40">
                    </div>

                    <!-- Textarea -->
                    <div class="mb-3">
                        <label for="description" class="form-label">Mô tả bản thân *</label>
                        <textarea class="form-control" id="description" rows="4" placeholder="Viết về kinh nghiệm, sở thích, mục tiêu..." minlength="50" maxlength="500" required></textarea>
                        <div class="form-text">
                            <span id="charCount">0</span>/500 ký tự (tối thiểu 50 ký tự)
                        </div>
                        <div class="invalid-feedback">Mô tả phải có từ 50 đến 500 ký tự</div>
                    </div>

                    <!-- File Upload -->
                    <div class="mb-3">
                        <label for="resume" class="form-label">Upload CV (PDF, DOC) *</label>
                        <input class="form-control" type="file" id="resume" accept=".pdf,.doc,.docx" required>
                        <div class="form-text">Dung lượng tối đa: 5MB. Chỉ chấp nhận file PDF, DOC, DOCX</div>
                        <div class="invalid-feedback">Vui lòng chọn file CV</div>
                    </div>

                    <!-- Switch -->
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="newsletter">
                            <label class="form-check-label" for="newsletter">Đăng ký nhận thông tin việc làm</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="terms" required>
                            <label class="form-check-label" for="terms">Đồng ý với điều khoản sử dụng *</label>
                            <div class="invalid-feedback">Bạn phải đồng ý với điều khoản sử dụng</div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <button type="button" class="btn btn-secondary" id="cancelBtn">
                            <i class="bi bi-x-lg me-2"></i>Hủy
                        </button>
                        <button type="reset" class="btn btn-warning" id="resetBtn">
                            <i class="bi bi-arrow-clockwise me-2"></i>Reset
                        </button>
                        <button type="button" class="btn btn-info" id="validateBtn">
                            <i class="bi bi-shield-check me-2"></i>Test Validation
                        </button>
                        <button type="button" class="btn btn-outline-danger" id="getErrorsBtn">
                            <i class="bi bi-exclamation-triangle me-2"></i>Show Errors
                        </button>
                        <button type="submit" class="btn btn-primary" id="saveBtn">
                            <i class="bi bi-check-lg me-2"></i>Lưu (Validate)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Components Demo -->
<div class="row mt-5">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-window me-2"></i>Modal Components Demo
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">Demo các component modal header và footer với data-binding</p>

                <!-- Modal Header Demo -->
                <h6 class="text-primary mb-3">Modal Header</h6>
                <div class="border rounded p-3 mb-4">
                    <div data-type="@ControlType.ModalHeader"
                         data-id="demoModalHeader1"
                         data-label="<i class='bi bi-gear me-2'></i>Cài đặt hệ thống"
                         data-class="bg-primary text-white"></div>
                </div>

                <div class="border rounded p-3 mb-4">
                    <div data-type="@ControlType.ModalHeader"
                         data-id="demoModalHeader2"
                         data-label="<i class='bi bi-person-plus me-2'></i>Thêm người dùng mới"
                         data-class="bg-success text-white"></div>
                </div>

                <div class="border rounded p-3 mb-4">
                    <div data-type="@ControlType.ModalHeader"
                         data-id="demoModalHeader3"
                         data-label="<i class='bi bi-exclamation-triangle me-2'></i>Xác nhận xóa"
                         data-class="bg-danger text-white"
                         data-no-close></div>
                </div>

                <!-- Modal Footer Demo -->
                <h6 class="text-primary mb-3 mt-4">Modal Footer</h6>
                <div class="border rounded p-3 mb-4">
                    <div data-type="@ControlType.ModalFooter"
                         data-id="demoModalFooter1"
                         data-class="justify-content-end"
                         data-buttons='[
                             {"text":"Hủy","class":"btn btn-secondary","dismiss":true,"icon":"bi bi-x-lg"},
                             {"text":"Lưu","class":"btn btn-primary","id":"saveBtn1","icon":"bi bi-check-lg"}
                         ]'></div>
                </div>

                <div class="border rounded p-3 mb-4">
                    <div data-type="@ControlType.ModalFooter"
                         data-id="demoModalFooter2"
                         data-class="justify-content-between"
                         data-buttons='[
                             {"text":"Trợ giúp","class":"btn btn-outline-info","icon":"bi bi-question-circle"},
                             {"text":"Đóng","class":"btn btn-secondary","dismiss":true,"icon":"bi bi-x-lg"},
                             {"text":"Áp dụng","class":"btn btn-success","id":"applyBtn","icon":"bi bi-check2-all"}
                         ]'></div>
                </div>

                <div class="border rounded p-3 mb-4">
                    <div data-type="@ControlType.ModalFooter"
                         data-id="demoModalFooter3"
                         data-class="justify-content-center"
                         data-buttons='[
                             {"text":"Không","class":"btn btn-outline-secondary","dismiss":true},
                             {"text":"Có, xóa ngay","class":"btn btn-danger","id":"deleteBtn","icon":"bi bi-trash"}
                         ]'></div>
                </div>

                <!-- ControlType.Form Demo -->
                <h6 class="text-primary mb-3 mt-4">ControlType.Form Demo</h6>
                <p class="text-muted">Demo form wrapper với modal header/footer tự động</p>

                <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#formDemoModal">
                    <i class="bi bi-window me-2"></i>Mở Form Modal Demo
                </button>

                <button type="button" class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#cardFormDemo">
                    <i class="bi bi-card-text me-2"></i>Mở Card Form Demo
                </button>

                <button type="button" class="btn btn-warning ms-2" data-bs-toggle="modal" data-bs-target="#optionsHelperDemo">
                    <i class="bi bi-list-ul me-2"></i>Options Helper Demo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Demo Modal -->
<div class="modal fade" id="demoModal" tabindex="-1" aria-labelledby="demoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div data-type="@ControlType.ModalHeader"
                 data-id="demoModalLabel"
                 data-label="<i class='bi bi-magic me-2'></i>Modal với Data-Binding"
                 data-class="bg-gradient bg-info text-white"></div>

            <div class="modal-body">
                <p>Đây là modal được tạo hoàn toàn bằng data-binding!</p>
                <div class="row">
                    <div class="col-md-6">
                        <div data-type="@ControlType.Text"
                             data-id="modalDemoName"
                             data-name="name"
                             data-label="Tên"
                             data-placeholder="Nhập tên"
                             data-required></div>
                    </div>
                    <div class="col-md-6">
                        <div data-type="@ControlType.Email"
                             data-id="modalDemoEmail"
                             data-name="email"
                             data-label="Email"
                             data-placeholder="example@email.com"
                             data-required></div>
                    </div>
                </div>
            </div>

            <div data-type="@ControlType.ModalFooter"
                 data-id="demoModalFooter"
                 data-buttons='[
                     {"text":"Đóng","class":"btn btn-secondary","dismiss":true,"icon":"bi bi-x-lg"},
                     {"text":"Lưu thay đổi","class":"btn btn-primary","id":"saveModalBtn","icon":"bi bi-floppy"}
                 ]'></div>
        </div>
    </div>
</div>

<!-- Form Modal Demo -->
<div class="modal fade" id="formDemoModal" tabindex="-1" aria-labelledby="formDemoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div data-type="@ControlType.Form"
                 data-id="formDemo"
                 data-label="<i class='bi bi-person-plus me-2'></i>Thêm người dùng mới (Auto-Submit)"
                 data-class="bg-success text-white"
                 data-button-save-id="saveUserBtn"
                 data-button-cancel-id="cancelUserBtn"
                 data-form-id="userForm"
                 data-url="/Demo/SaveUser"
                 data-method="POST"
                 data-modal>

                <!-- Form Body Content với data-wrapper-class -->
                <div class="row">
                    <div data-type="@ControlType.Text"
                         data-id="userName"
                         data-name="userName"
                         data-label="Tên người dùng"
                         data-placeholder="Nhập tên người dùng"
                         data-wrapper-class="col-md-6"
                         data-required></div>

                    <div data-type="@ControlType.Email"
                         data-id="userEmail"
                         data-name="userEmail"
                         data-label="Email"
                         data-placeholder="user@example.com"
                         data-wrapper-class="col-md-6"
                         data-required></div>
                </div>

                <div class="row">
                    <div data-type="@ControlType.Select"
                         data-id="userRole"
                         data-name="userRole"
                         data-label="Vai trò"
                         data-wrapper-class="col-md-6"
                         data-required
                         data-options='[
                             {"value":"","text":"-- Chọn vai trò --"},
                             {"value":"admin","text":"Quản trị viên"},
                             {"value":"manager","text":"Quản lý"},
                             {"value":"user","text":"Người dùng"}
                         ]'></div>

                    <div data-type="@ControlType.Tel"
                         data-id="userPhone"
                         data-name="userPhone"
                         data-label="Số điện thoại"
                         data-placeholder="0123456789"
                         data-wrapper-class="col-md-6"></div>
                </div>

                <div class="row">
                    <div data-type="@ControlType.Textarea"
                         data-id="userNote"
                         data-name="userNote"
                         data-label="Ghi chú"
                         data-placeholder="Nhập ghi chú về người dùng"
                         data-rows="3"
                         data-wrapper-class="col-md-12"></div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Card Form Demo -->
<div class="modal fade" id="cardFormDemo" tabindex="-1" aria-labelledby="cardFormDemoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Card Form Demo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div data-type="@ControlType.Form"
                             data-id="cardFormDemo1"
                             data-label="<i class='bi bi-gear me-2'></i>Cài đặt hệ thống"
                             data-class="border-primary"
                             data-button-save-id="saveSettingsBtn"
                             data-form-id="settingsForm">

                            <div data-type="@ControlType.Text"
                                 data-id="siteName"
                                 data-name="siteName"
                                 data-label="Tên website"
                                 data-value="My Website"
                                 data-required></div>

                            <div data-type="@ControlType.Switch"
                                 data-id="maintenance"
                                 data-name="maintenance"
                                 data-label="Chế độ bảo trì"
                                 data-value="true"></div>

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div data-type="@ControlType.Form"
                             data-id="cardFormDemo2"
                             data-label="<i class='bi bi-envelope me-2'></i>Cài đặt Email (Auto-Submit)"
                             data-class="border-success"
                             data-button-save-id="saveEmailBtn"
                             data-form-id="emailForm"
                             data-url="/Demo/SaveEmailSettings"
                             data-method="POST"
                             data-buttons='[
                                 {"text":"Test","class":"btn btn-outline-info","id":"testEmailBtn","icon":"bi bi-send"},
                                 {"text":"Lưu","class":"btn btn-success","id":"saveEmailBtn","icon":"bi bi-check-lg"}
                             ]'>

                            <div data-type="@ControlType.Text"
                                 data-id="smtpHost"
                                 data-name="smtpHost"
                                 data-label="SMTP Host"
                                 data-placeholder="smtp.gmail.com"
                                 data-required></div>

                            <div data-type="@ControlType.Number"
                                 data-id="smtpPort"
                                 data-name="smtpPort"
                                 data-label="SMTP Port"
                                 data-value="587"
                                 data-required></div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Options Helper Demo Modal -->
<div class="modal fade" id="optionsHelperDemo" tabindex="-1" aria-labelledby="optionsHelperDemoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div data-type="@ControlType.Form"
                 data-id="optionsHelperForm"
                 data-label="<i class='bi bi-list-ul me-2'></i>FormOptionsHelper Demo"
                 data-class="bg-warning text-dark"
                 data-button-save-id="saveOptionsBtn"
                 data-form-id="optionsHelperForm"
                 data-modal>

                <!-- Options Helper Demo -->
                <div class="alert alert-info">
                    <strong>FormOptionsHelper Demo:</strong> Các select boxes dưới đây sử dụng FormOptionsHelper để generate options
                </div>

                <div class="row">
                    <div data-type="@ControlType.Select"
                         data-id="roleStatus"
                         data-name="roleStatus"
                         data-label="Role Status (Helper)"
                         data-wrapper-class="col-md-6"
                         data-options='@Html.Raw(FormOptionsHelper.GetRoleStatusOptions("active"))'></div>

                    <div data-type="@ControlType.Select"
                         data-id="rolePriority"
                         data-name="rolePriority"
                         data-label="Role Priority (Helper)"
                         data-wrapper-class="col-md-6"
                         data-options='@Html.Raw(FormOptionsHelper.GetRolePriorityOptions("2"))'></div>
                </div>

                <div class="row">
                    <div data-type="@ControlType.Select"
                         data-id="userRole"
                         data-name="userRole"
                         data-label="User Role (Helper)"
                         data-wrapper-class="col-md-6"
                         data-options='@Html.Raw(FormOptionsHelper.GetUserRoleOptions())'></div>

                    <div data-type="@ControlType.Select"
                         data-id="accountStatus"
                         data-name="accountStatus"
                         data-label="Account Status (Helper)"
                         data-wrapper-class="col-md-6"
                         data-options='@Html.Raw(FormOptionsHelper.GetAccountStatusOptions())'></div>
                </div>

                <div class="row">
                    <div data-type="@ControlType.Select"
                         data-id="gender"
                         data-name="gender"
                         data-label="Gender (Helper)"
                         data-wrapper-class="col-md-4"
                         data-options='@Html.Raw(FormOptionsHelper.GetGenderOptions())'></div>

                    <div data-type="@ControlType.Select"
                         data-id="customerType"
                         data-name="customerType"
                         data-label="Customer Type (Helper)"
                         data-wrapper-class="col-md-4"
                         data-options='@Html.Raw(FormOptionsHelper.GetCustomerTypeOptions())'></div>

                    <div data-type="@ControlType.Select"
                         data-id="yesNo"
                         data-name="yesNo"
                         data-label="Yes/No (Helper)"
                         data-wrapper-class="col-md-4"
                         data-options='@Html.Raw(FormOptionsHelper.GetYesNoOptions())'></div>
                </div>

                <div class="row">
                    <div data-type="@ControlType.Select"
                         data-id="month"
                         data-name="month"
                         data-label="Month (Helper)"
                         data-wrapper-class="col-md-6"
                         data-options='@Html.Raw(FormOptionsHelper.GetMonthOptions())'></div>

                    <div data-type="@ControlType.Select"
                         data-id="year"
                         data-name="year"
                         data-label="Year (Helper)"
                         data-wrapper-class="col-md-6"
                         data-options='@Html.Raw(FormOptionsHelper.GetYearOptions(2020, 2030))'></div>
                </div>

            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize form control binder for data-binding controls với validation
            window.formControlBinder.init('#demoForm');

            // Initialize modal components
            window.formControlBinder.init('#demoModal');
            window.formControlBinder.init('#formDemoModal');
            window.formControlBinder.init('#cardFormDemo');
            window.formControlBinder.init('#optionsHelperDemo');

            const form = document.getElementById('demoForm');
            const cancelBtn = document.getElementById('cancelBtn');
            const resetBtn = document.getElementById('resetBtn');

            // Listen for form validation event
            form.addEventListener('formValidated', function(e) {
                if (e.detail.isValid) {
                    showFormSummary();
                    showNotification('✅ Form hợp lệ! Dữ liệu đã được xử lý.', 'success');
                } else {
                    showNotification('❌ Form có lỗi! Vui lòng kiểm tra lại.', 'error');
                }
            });

            // Test validation button
            document.getElementById('validateBtn').addEventListener('click', function() {
                const isValid = window.formControlBinder.validateForm(form);
                if (isValid) {
                    showNotification('✅ Form validation passed!', 'success');
                } else {
                    showNotification('❌ Form validation failed!', 'error');
                }
            });

            // Show errors button
            document.getElementById('getErrorsBtn').addEventListener('click', function() {
                const errors = window.formControlBinder.getValidationSummary(form);
                if (errors.length === 0) {
                    showNotification('✅ Không có lỗi validation!', 'success');
                } else {
                    let errorMessage = '❌ Danh sách lỗi:\\n\\n';
                    errors.forEach((error, index) => {
                        errorMessage += `${index + 1}. ${error.label}: ${error.message}\\n`;
                    });

                    Swal.fire({
                        title: 'Validation Errors',
                        text: errorMessage,
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            });
            const saveBtn = document.getElementById('saveBtn');
            const hoursRange = document.getElementById('workHours');
            const hoursValue = document.getElementById('hoursValue');
            const descriptionTextarea = document.getElementById('description');
            const charCount = document.getElementById('charCount');

            // Character count for textarea
            descriptionTextarea.addEventListener('input', function() {
                const length = this.value.length;
                charCount.textContent = length;
                
                if (length < 50) {
                    charCount.style.color = '#dc3545';
                } else if (length > 450) {
                    charCount.style.color = '#ffc107';
                } else {
                    charCount.style.color = '#28a745';
                }
            });

            // Range slider update
            hoursRange.addEventListener('input', function() {
                hoursValue.textContent = this.value;
            });

            // Real-time validation for inputs
            const inputs = form.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    validateField(this);
                });
                
                if (input.type === 'email' || input.type === 'tel') {
                    input.addEventListener('input', function() {
                        if (this.value.length > 3) {
                            validateField(this);
                        }
                    });
                }
            });

            // Custom validation function
            function validateField(field) {
                const value = field.value.trim();
                let isValid = true;
                let errorMessage = '';

                // Email validation
                if (field.type === 'email' && value) {
                    const emailRegex = /^[^\\s@@]+@@[^\\s@@]+\\.[^\\s@@]+$/;
                    if (!emailRegex.test(value)) {
                        isValid = false;
                        errorMessage = 'Email không đúng định dạng';
                    }
                }

                // Phone validation
                if (field.type === 'tel' && value) {
                    const phoneRegex = /^(0[3|5|7|8|9])+([0-9]{8})$/;
                    if (!phoneRegex.test(value)) {
                        isValid = false;
                        errorMessage = 'Số điện thoại phải đúng định dạng VN (10 số)';
                    }
                }

                // Age validation
                if (field.id === 'age' && value) {
                    const age = parseInt(value);
                    if (age < 18 || age > 65) {
                        isValid = false;
                        errorMessage = 'Tuổi phải từ 18 đến 65';
                    }
                }

                // Salary validation
                if (field.id === 'salary' && value) {
                    const salary = parseInt(value);
                    if (salary < 5000000 || salary > 100000000) {
                        isValid = false;
                        errorMessage = 'Mức lương phải từ 5 triệu đến 100 triệu VNĐ';
                    }
                }

                // Date validation (không được chọn ngày trong quá khứ)
                if (field.type === 'date' && value) {
                    const selectedDate = new Date(value);
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    
                    if (selectedDate < today) {
                        isValid = false;
                        errorMessage = 'Ngày bắt đầu không được là ngày trong quá khứ';
                    }
                }

                // Update field validation state
                if (isValid) {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                } else {
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                    
                    // Update custom error message
                    const feedback = field.parentNode.querySelector('.invalid-feedback');
                    if (feedback && errorMessage) {
                        feedback.textContent = errorMessage;
                    }
                }
            }

            // Form validation
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                event.stopPropagation();
                
                let isFormValid = true;
                
                // Check required fields
                const requiredFields = form.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        isFormValid = false;
                        field.classList.add('is-invalid');
                    } else {
                        validateField(field);
                        if (field.classList.contains('is-invalid')) {
                            isFormValid = false;
                        }
                    }
                });
                
                // Check if at least one skill is selected
                const skills = form.querySelectorAll('input[name="skills"]:checked');
                const skillsError = document.getElementById('skillsError');
                
                if (skills.length === 0) {
                    isFormValid = false;
                    skillsError.style.display = 'block';
                    skillsError.classList.add('d-block');
                } else {
                    skillsError.style.display = 'none';
                    skillsError.classList.remove('d-block');
                }
                
                // Check radio button (gender)
                const genderSelected = form.querySelector('input[name="gender"]:checked');
                if (!genderSelected) {
                    isFormValid = false;
                    const genderRadios = form.querySelectorAll('input[name="gender"]');
                    genderRadios.forEach(radio => radio.classList.add('is-invalid'));
                }
                
                // Check file upload
                const resumeFile = document.getElementById('resume').files[0];
                if (!resumeFile) {
                    isFormValid = false;
                    document.getElementById('resume').classList.add('is-invalid');
                }
                
                // Check terms agreement
                const termsChecked = document.getElementById('terms').checked;
                if (!termsChecked) {
                    isFormValid = false;
                    document.getElementById('terms').classList.add('is-invalid');
                }
                
                if (isFormValid) {
                    showNotification('✅ Form validation thành công! Đang lưu dữ liệu...', 'success');
                    
                    // Simulate saving process
                    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
                    saveBtn.disabled = true;
                    
                    // Simulate API call
                    setTimeout(() => {
                        saveBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Lưu';
                        saveBtn.disabled = false;
                        showNotification('💾 Dữ liệu đã được lưu thành công vào database!', 'success');
                        
                        // Show submitted data summary
                        setTimeout(() => {
                            showFormSummary();
                        }, 1000);
                    }, 2000);
                } else {
                    showNotification('❌ Vui lòng kiểm tra lại các trường bắt buộc và sửa lỗi', 'error');
                }
                
                form.classList.add('was-validated');
            });

            // Reset button
            resetBtn.addEventListener('click', function() {
                form.classList.remove('was-validated');
                window.formControlBinder.resetValidation(form);
                hoursValue.textContent = '40';
                showNotification('🔄 Form đã được reset', 'info');
            });

            // Cancel button
            cancelBtn.addEventListener('click', function() {
                if (confirm('Bạn có chắc muốn hủy? Dữ liệu sẽ không được lưu.')) {
                    form.reset();
                    form.classList.remove('was-validated');
                    hoursValue.textContent = '40';
                    showNotification('❌ Đã hủy thao tác', 'warning');
                    
                    // Close modal if form is in modal
                    const modalContainer = this.closest('.modal-container');
                    if (modalContainer) {
                        modalContainer.remove();
                    }
                }
            });

            // File upload validation
            document.getElementById('resume').addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const maxSize = 5 * 1024 * 1024; // 5MB
                    const allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
                    
                    if (file.size > maxSize) {
                        showNotification('⚠️ File quá lớn. Vui lòng chọn file nhỏ hơn 5MB', 'warning');
                        this.value = '';
                        this.classList.add('is-invalid');
                        return;
                    }
                    
                    if (!allowedTypes.includes(file.type)) {
                        showNotification('⚠️ Chỉ chấp nhận file PDF, DOC, DOCX', 'warning');
                        this.value = '';
                        this.classList.add('is-invalid');
                        return;
                    }
                    
                    this.classList.remove('is-invalid');
                    this.classList.add('is-valid');
                    showNotification(`📄 Đã chọn file: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`, 'success');
                }
            });

            // Skills checkbox validation
            const skillCheckboxes = document.querySelectorAll('input[name="skills"]');
            skillCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const checkedSkills = document.querySelectorAll('input[name="skills"]:checked');
                    const skillsError = document.getElementById('skillsError');
                    
                    if (checkedSkills.length > 0) {
                        skillsError.style.display = 'none';
                        skillCheckboxes.forEach(cb => cb.classList.remove('is-invalid'));
                    }
                });
            });
        });

        function showFormSummary() {
            const form = document.getElementById('demoForm');
            const formData = new FormData(form);
            
            let summary = '📋 **Thông tin đã lưu:**\\n\\n';
            summary += `👤 Họ tên: ${formData.get('fullName') || form.getElementById('fullName').value}\\n`;
            summary += `📧 Email: ${formData.get('email') || form.getElementById('email').value}\\n`;
            summary += `📱 SĐT: ${formData.get('phone') || form.getElementById('phone').value || 'Chưa nhập'}\\n`;
            summary += `🎂 Tuổi: ${formData.get('age') || form.getElementById('age').value}\\n`;
            summary += `💼 Vị trí: ${form.getElementById('position').selectedOptions[0]?.text}\\n`;
            summary += `⏰ Giờ làm việc: ${form.getElementById('workHours').value} giờ/tuần\\n`;
            
            const skills = Array.from(document.querySelectorAll('input[name="skills"]:checked')).map(cb => cb.nextElementSibling.textContent);
            summary += `🛠️ Kỹ năng: ${skills.join(', ')}\\n`;
            
            showNotification(summary, 'info');
        }

        function showNotification(message, type = 'info') {
            const alertClass = type === 'error' ? 'alert-danger' : 
                              type === 'success' ? 'alert-success' : 
                              type === 'warning' ? 'alert-warning' : 'alert-info';
            
            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 350px; max-width: 500px;';
            notification.innerHTML = `
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="d-flex align-items-center">
                    ${message}
                </div>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 4000);
        }

        // ===== MODAL DEMO HANDLERS =====

        // Modal demo button handlers
        $(document).on('click', '#saveModalBtn', function() {
            const modalForm = document.querySelector('#demoModal');
            const isValid = window.formControlBinder.validateForm(modalForm);

            if (isValid) {
                const formData = window.formControlBinder.getFormData(modalForm);
                showNotification(`✅ Modal form saved! Name: ${formData.name}, Email: ${formData.email}`, 'success');
                $('#demoModal').modal('hide');
            } else {
                showNotification('❌ Vui lòng kiểm tra lại thông tin!', 'error');
            }
        });

        // Demo modal footer button handlers
        $(document).on('click', '#saveBtn1', function() {
            showNotification('💾 Nút Lưu được click!', 'info');
        });

        $(document).on('click', '#applyBtn', function() {
            showNotification('✅ Nút Áp dụng được click!', 'success');
        });

        $(document).on('click', '#deleteBtn', function() {
            showNotification('🗑️ Nút Xóa được click!', 'error');
        });

        // ===== FORM DEMO HANDLERS =====

        // Listen for form submit events
        $(document).on('formSubmitSuccess', '#userForm', function(e) {
            console.log('User form submitted successfully:', e.detail);
            showNotification(`✅ User saved! Name: ${e.detail.formData.userName}`, 'success');
        });

        $(document).on('formSubmitSuccess', '#settingsForm', function(e) {
            console.log('Settings form submitted successfully:', e.detail);
            showNotification(`⚙️ Settings saved! Site: ${e.detail.formData.siteName}`, 'success');
        });

        $(document).on('formSubmitSuccess', '#emailForm', function(e) {
            console.log('Email form submitted successfully:', e.detail);
            showNotification(`📧 Email settings saved! Host: ${e.detail.formData.smtpHost}`, 'success');
        });

        // Test email button (không phải submit)
        $(document).on('click', '#testEmailBtn', function() {
            showNotification('📤 Đang test kết nối email...', 'info');
            setTimeout(() => {
                showNotification('✅ Test email thành công!', 'success');
            }, 2000);
        });

    </script>
}
