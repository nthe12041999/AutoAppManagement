@{
    ViewData["Title"] = "Messages";
    ViewData["PageName"] = "messages";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Messages</h1>
        <p class="text-muted mb-0">Chat and communicate with your team</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newMessageModal">
            <i class="bi bi-plus-circle me-2"></i>New Message
        </button>
    </div>
</div>

<div class="row">
    <!-- Messages Sidebar -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Conversations</h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="bi bi-check-all me-2"></i>Mark all as read</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-archive me-2"></i>Archive all</a></li>
                        </ul>
                    </div>
                </div>
                <div class="mt-3">
                    <input type="text" class="form-control" placeholder="Search conversations...">
                </div>
            </div>
            <div class="card-body p-0">
                <div class="conversation-list">
                    <div class="conversation-item active">
                        <div class="d-flex align-items-center p-3">
                            <div class="avatar me-3">
                                <img src="https://via.placeholder.com/40" class="rounded-circle" alt="Avatar">
                                <span class="status-indicator online"></span>
                            </div>
                            <div class="conversation-info flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="mb-1">John Doe</h6>
                                    <small class="text-muted">2m</small>
                                </div>
                                <p class="mb-0 text-muted small">Hey, how's the project going?</p>
                                <span class="badge bg-primary rounded-pill">2</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="conversation-item">
                        <div class="d-flex align-items-center p-3">
                            <div class="avatar me-3">
                                <img src="https://via.placeholder.com/40" class="rounded-circle" alt="Avatar">
                                <span class="status-indicator away"></span>
                            </div>
                            <div class="conversation-info flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="mb-1">Jane Smith</h6>
                                    <small class="text-muted">1h</small>
                                </div>
                                <p class="mb-0 text-muted small">Can you review the design files?</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="conversation-item">
                        <div class="d-flex align-items-center p-3">
                            <div class="avatar me-3">
                                <div class="avatar-placeholder bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                                    <i class="bi bi-people"></i>
                                </div>
                            </div>
                            <div class="conversation-info flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="mb-1">Development Team</h6>
                                    <small class="text-muted">3h</small>
                                </div>
                                <p class="mb-0 text-muted small">Mike: The new feature is ready for testing</p>
                                <span class="badge bg-primary rounded-pill">5</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="conversation-item">
                        <div class="d-flex align-items-center p-3">
                            <div class="avatar me-3">
                                <img src="https://via.placeholder.com/40" class="rounded-circle" alt="Avatar">
                                <span class="status-indicator offline"></span>
                            </div>
                            <div class="conversation-info flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="mb-1">Sarah Wilson</h6>
                                    <small class="text-muted">1d</small>
                                </div>
                                <p class="mb-0 text-muted small">Thanks for the update!</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Chat Area -->
    <div class="col-lg-8">
        <div class="card chat-container">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <div class="avatar me-3">
                        <img src="https://via.placeholder.com/40" class="rounded-circle" alt="Avatar">
                        <span class="status-indicator online"></span>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="mb-0">John Doe</h6>
                        <small class="text-success">Online</small>
                    </div>
                    <div class="chat-actions">
                        <button class="btn btn-sm btn-outline-secondary me-2">
                            <i class="bi bi-telephone"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary me-2">
                            <i class="bi bi-camera-video"></i>
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>View Profile</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-bell-slash me-2"></i>Mute</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-archive me-2"></i>Archive</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-body chat-messages" id="chatMessages">
                <div class="message received">
                    <div class="message-avatar">
                        <img src="https://via.placeholder.com/32" class="rounded-circle" alt="Avatar">
                    </div>
                    <div class="message-content">
                        <div class="message-bubble">
                            <p class="mb-0">Hey! How's the project going?</p>
                        </div>
                        <small class="text-muted">10:30 AM</small>
                    </div>
                </div>
                
                <div class="message sent">
                    <div class="message-content">
                        <div class="message-bubble">
                            <p class="mb-0">It's going well! We're on track to finish by the deadline.</p>
                        </div>
                        <small class="text-muted">10:32 AM</small>
                    </div>
                </div>
                
                <div class="message received">
                    <div class="message-avatar">
                        <img src="https://via.placeholder.com/32" class="rounded-circle" alt="Avatar">
                    </div>
                    <div class="message-content">
                        <div class="message-bubble">
                            <p class="mb-0">That's great to hear! Do you need any help with anything?</p>
                        </div>
                        <small class="text-muted">10:35 AM</small>
                    </div>
                </div>
                
                <div class="message sent">
                    <div class="message-content">
                        <div class="message-bubble">
                            <p class="mb-0">Actually, could you review the latest design mockups when you have a chance?</p>
                        </div>
                        <small class="text-muted">10:37 AM</small>
                    </div>
                </div>
                
                <div class="message received">
                    <div class="message-avatar">
                        <img src="https://via.placeholder.com/32" class="rounded-circle" alt="Avatar">
                    </div>
                    <div class="message-content">
                        <div class="message-bubble">
                            <p class="mb-0">Of course! I'll take a look this afternoon and get back to you.</p>
                        </div>
                        <small class="text-muted">10:40 AM</small>
                    </div>
                </div>
                
                <div class="typing-indicator">
                    <div class="message-avatar">
                        <img src="https://via.placeholder.com/32" class="rounded-circle" alt="Avatar">
                    </div>
                    <div class="message-content">
                        <div class="typing-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-footer">
                <form class="message-form">
                    <div class="input-group">
                        <button type="button" class="btn btn-outline-secondary">
                            <i class="bi bi-paperclip"></i>
                        </button>
                        <input type="text" class="form-control" placeholder="Type a message..." id="messageInput">
                        <button type="button" class="btn btn-outline-secondary">
                            <i class="bi bi-emoji-smile"></i>
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- New Message Modal -->
<div class="modal fade" id="newMessageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label for="recipient" class="form-label">To</label>
                        <select class="form-select" id="recipient" multiple>
                            <option value="john">John Doe</option>
                            <option value="jane">Jane Smith</option>
                            <option value="mike">Mike Johnson</option>
                            <option value="sarah">Sarah Wilson</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="messageText" class="form-label">Message</label>
                        <textarea class="form-control" id="messageText" rows="4" placeholder="Type your message..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Send Message</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .chat-container {
            height: 600px;
            display: flex;
            flex-direction: column;
        }
        
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }
        
        .conversation-item {
            border-bottom: 1px solid #f0f0f0;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }
        
        .conversation-item:hover {
            background-color: #f8f9fa;
        }
        
        .conversation-item.active {
            background-color: #e3f2fd;
        }
        
        .avatar {
            position: relative;
            width: 40px;
            height: 40px;
        }
        
        .avatar img {
            width: 40px;
            height: 40px;
            object-fit: cover;
        }
        
        .avatar-placeholder {
            width: 40px;
            height: 40px;
        }
        
        .status-indicator {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid white;
        }
        
        .status-indicator.online {
            background-color: #28a745;
        }
        
        .status-indicator.away {
            background-color: #ffc107;
        }
        
        .status-indicator.offline {
            background-color: #6c757d;
        }
        
        .message {
            display: flex;
            margin-bottom: 1rem;
        }
        
        .message.sent {
            justify-content: flex-end;
        }
        
        .message.sent .message-content {
            text-align: right;
        }
        
        .message-avatar {
            width: 32px;
            height: 32px;
            margin-right: 0.5rem;
        }
        
        .message.sent .message-avatar {
            display: none;
        }
        
        .message-bubble {
            background-color: #f8f9fa;
            border-radius: 1rem;
            padding: 0.75rem 1rem;
            max-width: 300px;
            word-wrap: break-word;
        }
        
        .message.sent .message-bubble {
            background-color: #6366f1;
            color: white;
        }
        
        .typing-indicator {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .typing-dots {
            background-color: #f8f9fa;
            border-radius: 1rem;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
        }
        
        .typing-dots span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #6c757d;
            margin: 0 2px;
            animation: typing 1.4s infinite ease-in-out;
        }
        
        .typing-dots span:nth-child(1) {
            animation-delay: -0.32s;
        }
        
        .typing-dots span:nth-child(2) {
            animation-delay: -0.16s;
        }
        
        @@keyframes typing {
            0%, 80%, 100% {
                transform: scale(0.8);
                opacity: 0.5;
            }
            40% {
                transform: scale(1);
                opacity: 1;
            }
        }
    </style>
}

@section Scripts {
    <script type="module" src="~/admin-template/messages-CRvs10Nl.js"></script>
}
