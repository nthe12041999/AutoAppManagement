@{
    ViewData["Title"] = "Notification Settings";
    ViewData["PageName"] = "settings-notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Notification Settings</h1>
        <p class="text-muted mb-0">Manage how you receive notifications</p>
    </div>
</div>

<div class="row">
    <!-- Settings Navigation -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Index", "Settings")" class="list-group-item list-group-item-action">
                        <i class="bi bi-gear me-2"></i>General
                    </a>
                    <a href="@Url.Action("Profile", "Settings")" class="list-group-item list-group-item-action">
                        <i class="bi bi-person me-2"></i>Profile
                    </a>
                    <a href="@Url.Action("Security", "Settings")" class="list-group-item list-group-item-action">
                        <i class="bi bi-shield-lock me-2"></i>Security
                    </a>
                    <a href="@Url.Action("Notifications", "Settings")" class="list-group-item list-group-item-action active">
                        <i class="bi bi-bell me-2"></i>Notifications
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Notifications Content -->
    <div class="col-lg-9">
        <!-- Email Notifications -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Email Notifications</h5>
            </div>
            <div class="card-body">
                <div class="notification-item d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <h6 class="mb-1">New Messages</h6>
                        <p class="text-muted mb-0">Get notified when you receive new messages</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="emailMessages" checked>
                    </div>
                </div>
                
                <div class="notification-item d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <h6 class="mb-1">Task Updates</h6>
                        <p class="text-muted mb-0">Notifications about task assignments and updates</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="emailTasks" checked>
                    </div>
                </div>
                
                <div class="notification-item d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <h6 class="mb-1">Project Updates</h6>
                        <p class="text-muted mb-0">Updates about projects you're involved in</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="emailProjects">
                    </div>
                </div>
                
                <div class="notification-item d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <h6 class="mb-1">Weekly Summary</h6>
                        <p class="text-muted mb-0">Weekly digest of your activity and updates</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="emailSummary" checked>
                    </div>
                </div>
                
                <div class="notification-item d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="mb-1">Marketing Updates</h6>
                        <p class="text-muted mb-0">Product updates and promotional content</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="emailMarketing">
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Push Notifications -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Push Notifications</h5>
            </div>
            <div class="card-body">
                <div class="notification-item d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <h6 class="mb-1">Browser Notifications</h6>
                        <p class="text-muted mb-0">Show notifications in your browser</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="pushBrowser" checked>
                    </div>
                </div>
                
                <div class="notification-item d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <h6 class="mb-1">Desktop Notifications</h6>
                        <p class="text-muted mb-0">Show desktop notifications when app is closed</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="pushDesktop">
                    </div>
                </div>
                
                <div class="notification-item d-flex justify-content-between align-items-center py-3">
                    <div>
                        <h6 class="mb-1">Mobile Push</h6>
                        <p class="text-muted mb-0">Push notifications to your mobile device</p>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="pushMobile" checked>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Notification Schedule -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Notification Schedule</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="quietHours" checked>
                        <label class="form-check-label" for="quietHours">
                            Enable quiet hours
                        </label>
                    </div>
                    <small class="text-muted">Pause notifications during specified hours</small>
                </div>
                
                <div class="row" id="quietHoursSettings">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="quietStart" class="form-label">Start Time</label>
                            <input type="time" class="form-control" id="quietStart" value="22:00">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="quietEnd" class="form-label">End Time</label>
                            <input type="time" class="form-control" id="quietEnd" value="08:00">
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Quiet Days</label>
                    <div class="d-flex flex-wrap gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="quietSun">
                            <label class="form-check-label" for="quietSun">Sun</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="quietMon">
                            <label class="form-check-label" for="quietMon">Mon</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="quietTue">
                            <label class="form-check-label" for="quietTue">Tue</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="quietWed">
                            <label class="form-check-label" for="quietWed">Wed</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="quietThu">
                            <label class="form-check-label" for="quietThu">Thu</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="quietFri">
                            <label class="form-check-label" for="quietFri">Fri</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="quietSat" checked>
                            <label class="form-check-label" for="quietSat">Sat</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Notification Preferences -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Notification Preferences</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="notificationSound" class="form-label">Notification Sound</label>
                    <select class="form-select" id="notificationSound">
                        <option value="default" selected>Default</option>
                        <option value="chime">Chime</option>
                        <option value="bell">Bell</option>
                        <option value="pop">Pop</option>
                        <option value="none">None (Silent)</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="notificationFrequency" class="form-label">Email Frequency</label>
                    <select class="form-select" id="notificationFrequency">
                        <option value="instant" selected>Instant</option>
                        <option value="hourly">Hourly Digest</option>
                        <option value="daily">Daily Digest</option>
                        <option value="weekly">Weekly Digest</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="groupNotifications" checked>
                        <label class="form-check-label" for="groupNotifications">
                            Group similar notifications
                        </label>
                    </div>
                    <small class="text-muted">Combine multiple notifications of the same type</small>
                </div>
                
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Save Notification Settings</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/admin-template/settings-Bnfw1kFC.js"></script>
    <script>
        // Toggle quiet hours settings
        document.getElementById('quietHours').addEventListener('change', function() {
            const settings = document.getElementById('quietHoursSettings');
            if (this.checked) {
                settings.style.display = 'block';
            } else {
                settings.style.display = 'none';
            }
        });
    </script>
}
