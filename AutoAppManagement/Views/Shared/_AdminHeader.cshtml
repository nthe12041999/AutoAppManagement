<!-- Left Side - Search -->
<div class="header-left">
    <div class="main-search">
        <input type="text" placeholder="Tìm kiếm..." />
        <i class="bi bi-search"></i>
    </div>
</div>

<!-- Right Side - Actions and Avatar -->
<div class="header-right">
    <button class="action-btn" title="Thông báo">
        <i class="bi bi-bell"></i>
    </button>
    <button class="action-btn" title="Cài đặt">
        <i class="bi bi-gear"></i>
    </button>
    <div class="user-profile">
        <img src="" alt="User" class="user-avatar" 
             id="userProfileAvatar" />
        
        <!-- Dropdown Menu -->
        <ul class="dropdown-menu user-dropdown" id="userDropdownMenu">
            <li class="dropdown-header">
                <div class="user-info">
                    <img src="" alt="User" class="user-avatar-large" />
                    <div class="user-details">
                        <div class="user-name">Admin User</div>
                        <div class="user-email">admin@example.com</div>
                    </div>
                </div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item" href="/Account/Profile">
                    <i class="bi bi-person me-2"></i>Thông tin cá nhân
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="/Account/Settings">
                    <i class="bi bi-gear me-2"></i>Cài đặt
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="/Account/ChangePassword">
                    <i class="bi bi-lock me-2"></i>Đổi mật khẩu
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item text-danger" href="#" id="logoutBtn">
                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                </a>
            </li>
        </ul>
    </div>
</div>
