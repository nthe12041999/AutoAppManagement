@model AutoAppManagement.Models.Components.CustomControlFilterModel

<div class="card mb-4" id="@Model.ContainerId">
    <div class="card-body">
        <div class="row g-3">
            @if (Model.ShowSearchInput)
            {
                <div class="col-md-@Model.SearchInputColSize">
                    <div class="form-floating">
                        <input type="text" 
                               class="form-control" 
                               id="@Model.SearchInputId" 
                               placeholder="@Model.SearchPlaceholder"
                               value="@Model.SearchValue">
                        <label for="@Model.SearchInputId">
                            <i class="bi bi-search me-2"></i>@Model.SearchLabel
                        </label>
                    </div>
                </div>
            }

            @if (Model.FilterControls?.Any() == true)
            {
                @foreach (var filter in Model.FilterControls)
                {
                    <div class="col-md-@filter.ColSize">
                        @if (filter.Type == "select")
                        {
                            <select class="form-select" id="@filter.Id" data-filter-name="@filter.Name">
                                @if (!string.IsNullOrEmpty(filter.DefaultOption))
                                {
                                    <option value="">@filter.DefaultOption</option>
                                }
                                @if (filter.Options?.Any() == true)
                                {
                                    @foreach (var option in filter.Options)
                                    {
                                        <option value="@option.Value" selected="@option.Selected">
                                            @option.Text
                                        </option>
                                    }
                                }
                            </select>
                        }
                        else if (filter.Type == "input")
                        {
                            <div class="form-floating">
                                <input type="@filter.InputType" 
                                       class="form-control" 
                                       id="@filter.Id" 
                                       placeholder="@filter.Placeholder"
                                       value="@filter.Value"
                                       data-filter-name="@filter.Name">
                                <label for="@filter.Id">@filter.Label</label>
                            </div>
                        }
                        else if (filter.Type == "daterange")
                        {
                            <div class="input-group">
                                <input type="date" 
                                       class="form-control" 
                                       id="@(filter.Id)_from" 
                                       data-filter-name="@(filter.Name)_from"
                                       value="@filter.FromValue">
                                <span class="input-group-text">đến</span>
                                <input type="date" 
                                       class="form-control" 
                                       id="@(filter.Id)_to" 
                                       data-filter-name="@(filter.Name)_to"
                                       value="@filter.ToValue">
                            </div>
                        }
                    </div>
                }
            }

            @if (Model.ShowClearButton)
            {
                <div class="col-md-@Model.ClearButtonColSize">
                    <button type="button" 
                            class="btn btn-outline-secondary btn-block" 
                            id="@Model.ClearButtonId">
                        <i class="bi bi-x-lg me-1"></i> @Model.ClearButtonText
                    </button>
                </div>
            }

            @if (Model.CustomButtons?.Any() == true)
            {
                @foreach (var button in Model.CustomButtons)
                {
                    <div class="col-md-@button.ColSize">
                        <button type="button" 
                                class="btn @button.CssClass" 
                                id="@button.Id"
                                @if (!string.IsNullOrEmpty(button.OnClick))
                                {
                                    @:onclick="@button.OnClick"
                                }>
                            @if (!string.IsNullOrEmpty(button.Icon))
                            {
                                <i class="@button.Icon me-1"></i>
                            }
                            @button.Text
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        customControlFilter.init('@Model.ContainerId', @Html.Raw(Json.Serialize(Model.Config)));
    });
</script>
