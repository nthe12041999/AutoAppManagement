@model AutoAppManagement.Models.Components.DataGridModel

<div class="card">
    @if (!string.IsNullOrEmpty(Model.Title))
    {
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="@Model.TitleIcon me-2"></i>@Model.Title
            </h5>
            @if (Model.ShowActions)
            {
                <div class="d-flex gap-2">
                    @if (Model.ShowExport)
                    {
                        <button class="btn btn-outline-success btn-sm" onclick="@Model.ExportAction">
                            <i class="bi bi-file-earmark-excel me-1"></i></button>
                    }
                    @if (Model.ShowRefresh)
                    {
                        <button class="btn btn-outline-primary btn-sm" onclick="@Model.RefreshAction">
                            <i class="bi bi-arrow-clockwise me-1"></i></button>
                    }
                </div>
            }
        </div>
    }
    
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="@Model.TableId">
                <thead class="table-light">
                    <tr>
                        @if (Model.ShowCheckbox)
                        {
                            <th scope="col" width="50">
                                <input type="checkbox" class="form-check-input" id="@(Model.TableId)_selectAll">
                            </th>
                        }
                        @foreach (var column in Model.Columns)
                        {
                            <th scope="col" @(column.Width > 0 ? $"width=\"{column.Width}\"" : "")>
                                @column.Title
                            </th>
                        }
                        @if (Model.ShowActions && Model.ActionButtons?.Any() == true)
                        {
                            <th scope="col" width="120">Thao tác</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Data)
                    {
                        <tr>
                            @if (Model.ShowCheckbox)
                            {
                                <td>
                                    <input type="checkbox" class="form-check-input row-checkbox" value="@row.Id">
                                </td>
                            }
                            @foreach (var column in Model.Columns)
                            {
                                <td>
                                    @await Html.PartialAsync("_DataGridCell", new { 
                                        Column = column, 
                                        Row = row, 
                                        Value = GetCellValue(row, column.BindingField) 
                                    })
                                </td>
                            }
                            @if (Model.ShowActions && Model.ActionButtons?.Any() == true)
                            {
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @foreach (var action in Model.ActionButtons)
                                        {
                                            <button class="btn @action.CssClass" 
                                                    title="@action.Title" 
                                                    onclick="@action.OnClick(@row.Id)">
                                                <i class="@action.Icon"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (Model.ShowPagination)
    {
        <div class="card-footer">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Hiển thị @Model.PageStart-@Model.PageEnd trong tổng số @Model.TotalRecords bản ghi
                </div>
                <nav aria-label="Phân trang">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="@Model.PaginationAction(Model.CurrentPage - 1)" tabindex="-1">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="#" onclick="@Model.PaginationAction(i)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="@Model.PaginationAction(Model.CurrentPage + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<style>
    /* Product Catalog style checkboxes - Override toggle switches */
    .table input[type="checkbox"].form-check-input {
        width: 16px !important;
        height: 16px !important;
        border: 1px solid var(--bs-border-color) !important;
        border-radius: 3px !important;
        background: var(--bs-body-bg) !important;
        transition: all 0.2s ease-in-out !important;
        margin: 0 !important;
        appearance: none !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        background-size: contain !important;
        background-repeat: no-repeat !important;
        background-position: center !important;
        position: relative !important;
        z-index: 1 !important;
    }

    .table input[type="checkbox"].form-check-input::before,
    .table input[type="checkbox"].form-check-input::after {
        display: none !important;
        content: none !important;
    }

    .table input[type="checkbox"].form-check-input:checked {
        background-color: var(--bs-primary) !important;
        border-color: var(--bs-primary) !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/%3e%3c/svg%3e") !important;
    }

    .table input[type="checkbox"].form-check-input:checked::before,
    .table input[type="checkbox"].form-check-input:checked::after {
        display: none !important;
        content: none !important;
    }

    .table input[type="checkbox"].form-check-input:focus {
        box-shadow: 0 0 0 0.2rem rgba(var(--bs-primary-rgb), 0.25) !important;
        border-color: var(--bs-primary) !important;
        outline: none !important;
    }

    .table input[type="checkbox"].form-check-input:hover {
        border-color: var(--bs-primary) !important;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
</style>

@functions {
    private object GetCellValue(dynamic row, string bindingField)
    {
        if (string.IsNullOrEmpty(bindingField)) return "";
        
        var properties = bindingField.Split('.');
        object value = row;
        
        foreach (var prop in properties)
        {
            if (value == null) return "";
            var property = value.GetType().GetProperty(prop);
            if (property == null) return "";
            value = property.GetValue(value);
        }
        
        return value ?? "";
    }
}
