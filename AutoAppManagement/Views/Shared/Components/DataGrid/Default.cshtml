@model AutoAppManagement.Models.Components.DataGridModel
@using AutoAppManagement.Models.Enums

<!-- DataGrid Component -->
<div class="card" data-component="datagrid"
     data-table-id="@Model.TableId"
     data-get-url="@Model.GetUrl"
     data-base-url="@Model.BaseUrl"
     data-entity="@Model.Entity"
     data-page-size="@Model.PageSize"
     data-auto-load="@Model.AutoLoad.ToString().ToLower()"
     data-has-paging="@Model.HasPaging.ToString().ToLower()"
     data-title="@Model.Title"
     data-title-icon="@Model.TitleIcon"
     data-has-export="@Model.HasExport.ToString().ToLower()"
     data-has-refresh="@Model.HasRefresh.ToString().ToLower()"
     data-has-add="@Model.HasAdd.ToString().ToLower()"
     data-title-add="@Model.TitleAdd"
     data-add-action="@Model.AddAction"
     data-add-target="@Model.AddTarget">

    <!-- Header will be auto-generated by DataGrid -->
    <div class="card-body p-0" data-section="table-container">
        <div class="table-responsive" data-element="table-wrapper">
            <table class="table table-hover mb-0" id="@Model.TableId">
                <thead class="table-light" data-section="table-header">
                    <tr data-row="header">
                        @foreach (var column in Model.Columns)
                        {
                            var field = column.BindingField;
                            var type = column.Type;
                            var title = column.Title;
                            var width = column.Width > 0 ? column.Width.ToString() : "";
                            var sortable = column.Sortable.ToString().ToLower();

                            if (field == "checkbox")
                            {
                                <th width="@(string.IsNullOrEmpty(width) ? "50" : width)"
                                    data-type="@DataGridColumnType.Checkbox"
                                    data-sortable="false"
                                    class="text-center">
                                    <input type="checkbox" class="form-check-input" id="selectAll" data-action="select-all" data-target="all-rows">
                                </th>
                            }
                            else if (field == "actions")
                            {
                                <th width="@(string.IsNullOrEmpty(width) ? "150" : width)"
                                    data-type="@DataGridColumnType.Actions"
                                    data-sortable="false">
                                    @title
                                </th>
                            }
                            else
                            {
                                <th data-field="@field"
                                    data-type="@type"
                                    data-sortable="@sortable"
                                    @(string.IsNullOrEmpty(width) ? "" : $"width=\"{width}\"")>
                                    @title
                                </th>
                            }
                        }
                    </tr>
                </thead>
                <!-- tbody will be auto-generated by DataGrid with loading state -->
            </table>
        </div>
    </div>
    <!-- Pagination will be auto-generated by DataGrid when data-has-paging="true" -->
</div>
