<div class="sidebar-content">
    <!-- Logo/Brand Section -->
    <div class="sidebar-brand">
        <div class="brand-icon">
            <i class="bi bi-box-seam"></i>
        </div>
        <span class="brand-text">AutoApp</span>
        <button class="pin-toggle" id="sidebarPin" data-tooltip="Ghim/Bỏ ghim menu">
            <i class="bi bi-pin-angle"></i>
        </button>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">
        <ul class="nav">
            
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="@Url.Action("Index", "Home")" data-tooltip="Trang chủ">
                    <i class="bi bi-house"></i>
                    <span>Trang chủ</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analytics" ? "active" : "")" href="@Url.Action("Index", "Analytics")" data-tooltip="Thống kê">
                    <i class="bi bi-graph-up"></i>
                    <span>Thống kê</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminAccount" ? "active" : "")" href="@Url.Action("Accounts", "AdminAccount")" data-tooltip="Tài khoản Admin">
                    <i class="bi bi-person-gear"></i>
                    <span>Tài khoản Admin</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")" href="@Url.Action("Index", "Account")" data-tooltip="Tài khoản khách hàng">
                    <i class="bi bi-person"></i>
                    <span>Tài khoản khách hàng</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "License" ? "active" : "")" href="@Url.Action("Index", "License")" data-tooltip="License">
                    <i class="bi bi-key"></i>
                    <span>License</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Role" ? "active" : "")" href="@Url.Action("Index", "Role")" data-tooltip="Vai trò">
                    <i class="bi bi-person-badge"></i>
                    <span>Vai trò</span>
                </a>
            </li>



        </ul>
    </nav>
</div>
