@{
    var row = ViewBag.Row;
    var value = ViewBag.Value;
}

<div class="d-flex align-items-center">
    @if (!string.IsNullOrEmpty(GetAvatarUrl(row)))
    {
        <img src="@GetAvatarUrl(row)" class="avatar-circle me-3" alt="Avatar" style="width: 40px; height: 40px; object-fit: cover;">
    }
    else
    {
        <div class="avatar-circle @GetAvatarClass(row) text-white me-3">
            <i class="@GetAvatarIcon(row)"></i>
        </div>
    }
    <div>
        <div class="fw-bold">@GetDisplayText(row)</div>
        @if (!string.IsNullOrEmpty(GetSubText(row)))
        {
            <small class="text-muted">@GetSubText(row)</small>
        }
    </div>
</div>

@functions {
    private string GetAvatarUrl(dynamic row)
    {
        return row?.Avatar ?? row?.AvatarUrl ?? row?.Image ?? row?.ImageUrl ?? "";
    }
    
    private string GetDisplayText(dynamic row)
    {
        return row?.Name ?? row?.Title ?? row?.DisplayName ?? ViewBag.Value?.ToString() ?? "Unknown";
    }
    
    private string GetSubText(dynamic row)
    {
        return row?.Description ?? row?.SubTitle ?? row?.Category ?? "";
    }
    
    private string GetAvatarClass(dynamic row)
    {
        var colors = new[] { "bg-primary", "bg-success", "bg-info", "bg-warning", "bg-danger", "bg-secondary" };
        var hash = (GetDisplayText(row)?.GetHashCode() ?? 0) % colors.Length;
        return colors[Math.Abs(hash)];
    }
    
    private string GetAvatarIcon(dynamic row)
    {
        var type = row?.Type?.ToString()?.ToLower() ?? "";
        return type switch
        {
            "user" or "person" => "bi bi-person-fill",
            "product" => "bi bi-box",
            "order" => "bi bi-bag-check",
            "file" => "bi bi-file-earmark",
            "folder" => "bi bi-folder",
            _ => "bi bi-circle-fill"
        };
    }
}
