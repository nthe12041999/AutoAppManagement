<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Auto App Management - Modern Admin Dashboard">
    <meta name="keywords" content="bootstrap, admin, dashboard, template, modern, responsive">
    <meta name="author" content="Auto App Management">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Auto App Management">
    <meta property="og:description" content="Modern admin dashboard for auto app management">
    <meta property="og:type" content="website">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/admin-template/favicon.svg">
    <link rel="icon" type="image/png" href="~/admin-template/favicon.png">

    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Title -->
    <title>@ViewData["Title"] - Auto App Management</title>

    <!-- Theme Color -->
    <meta name="theme-color" content="#6366f1">

    <!-- PWA Manifest -->
    <link rel="manifest" href="~/admin-template/manifest.json">

    <!-- Admin Template CSS -->
    <link rel="stylesheet" crossorigin href="~/admin-template/admin-main.css">

    <!-- Clean Layout CSS -->
    <link rel="stylesheet" href="~/css/clean-layout.css">

    <!-- Minimalist Sidebar CSS -->
    <link rel="stylesheet" href="~/css/minimalist-sidebar.css">

    <!-- DataGrid Component CSS -->
    <link rel="stylesheet" href="~/css/components/datagrid.css">

    <!-- jQuery Core -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Original Scripts for backward compatibility -->
 @*    <script src="~/js/Constant/Constant.js"></script>
    <script src="~/js/Constant/enum.js"></script>
    <script src="~/js/Mixin/messagebox.js"></script>
    <script src="~/js/Mixin/paging.js"></script>
    <script src="~/js/Page/Base/detailConfig.js"></script> *@

    <!-- DataTables CSS -->
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.js"></script>
    @*<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.css">*@
    @*<link rel="stylesheet" href="/css/Component/grid.css">*@

    <!-- Page-specific Styles -->
    @RenderSection("Styles", required: false)

</head>
<body data-page="@ViewData["PageName"]" class="admin-layout">

    <!-- Main App Container -->
    <div class="app-container">
        
        <!-- Left Sidebar -->
        <div class="app-sidebar">
            @await Html.PartialAsync("_AdminSidebar")
        </div>

        <!-- Right Content Area -->
        <div class="app-content">
            <!-- Header Bar -->
            <div class="app-header">
                @await Html.PartialAsync("_AdminHeader")
            </div>

            <!-- Main Content -->
            <div class="app-main-wrapper">
                <div class="app-main">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div> <!-- /.admin-wrapper -->

    <!-- Toast Container -->
    <div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 11">
        <div id="toast-container"></div>
    </div>

    <!-- Original Scripts for backward compatibility -->
    <script>
        let userInfor = localStorage.getItem("userInfor"),
            userInforJson = userInfor ? JSON.parse(userInfor) : null;
        let _mainConfig = {
            userName: userInforJson && userInforJson.userName ? userInforJson.userName : '',
            avatar: userInforJson && userInforJson.avatar ? userInforJson.avatar : ''
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    @* <script src="/js/Mixin/notification.js"></script>
    <script src="~/js/Page/Base/detail.js"></script> *@

    <!-- Custom Control Filter Component -->
  @*   <script src="~/js/components/custom-control-filter.js"></script>

    <!-- Filter Base Class -->
    <script src="~/js/filters/base-filter.js"></script> *@

    <!-- Grid Filter Component (Bootstrap Card style - Standard) -->
    <script src="~/js/components/grid-filter.js"></script>

    <!-- Data Grid Component (Auto-generate table) -->
    <script src="~/js/components/data-grid.js"></script>

    <!-- Form Control Binder (Auto-bind data attributes to form controls) -->
    <script src="~/js/form-control-binder.js"></script>

    <!-- Sidebar Handler for Fixed Position -->
    <script src="~/js/sidebar-handler.js"></script>

    <script src="~/js/fetch-api.js"></script>

    <!-- User Profile Dropdown -->
    <script src="~/js/user-profile.js"></script>

    <!-- Page-specific Scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
