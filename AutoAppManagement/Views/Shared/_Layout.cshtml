<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <!-- Meta Tags -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Auto App Management - Modern Admin Dashboard">
    <meta name="keywords" content="bootstrap, admin, dashboard, template, modern, responsive">
    <meta name="author" content="Auto App Management">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Auto App Management">
    <meta property="og:description" content="Modern admin dashboard for auto app management">
    <meta property="og:type" content="website">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/admin-template/favicon-CvUZKS4z.svg">
    <link rel="icon" type="image/png" href="~/admin-template/favicon-B_cwPWBd.png">

    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Title -->
    <title>@ViewData["Title"] - Auto App Management</title>

    <!-- Theme Color -->
    <meta name="theme-color" content="#6366f1">

    <!-- PWA Manifest -->
    <link rel="manifest" href="~/admin-template/manifest-DTaoG9pG.json">

    <!-- Admin Template CSS -->
    <link rel="stylesheet" crossorigin href="~/admin-template/main-D9K-blpF.css">

    <!-- Sidebar Submenu CSS -->
    <link rel="stylesheet" href="~/css/sidebar-submenu.css">

    <!-- jQuery Core -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Original Scripts for backward compatibility -->
 @*    <script src="~/js/Constant/Constant.js"></script>
    <script src="~/js/Constant/enum.js"></script>
    <script src="~/js/Mixin/messagebox.js"></script>
    <script src="~/js/Mixin/paging.js"></script>
    <script src="~/js/Page/Base/detailConfig.js"></script> *@

    <!-- DataTables CSS -->
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.js"></script>
    @*<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.css">*@
    @*<link rel="stylesheet" href="/css/Component/grid.css">*@

    <!-- Page-specific Styles -->
    @RenderSection("Styles", required: false)

</head>
<body data-page="@ViewData["PageName"]" class="admin-layout">
    <!-- Loading Screen -->
    <div id="loading-screen" class="loading-screen">
        <div class="loading-spinner">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <!-- Main Wrapper -->
    <div class="admin-wrapper" id="admin-wrapper">

        <!-- Header -->
        <header class="admin-header">
            @await Html.PartialAsync("_AdminHeader")
        </header>

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="admin-sidebar">
            @await Html.PartialAsync("_AdminSidebar")
        </aside>

        <!-- Floating Hamburger Menu -->
        <button class="hamburger-menu"
                type="button"
                data-sidebar-toggle
                aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>

        <!-- Main Content -->
        <main class="admin-main">
            <div class="container-fluid p-4 p-lg-5">
                @RenderBody()
            </div>
        </main>

        <!-- Footer -->
        <footer class="admin-footer">
            @await Html.PartialAsync("_AdminFooter")
        </footer>
    </div> <!-- /.admin-wrapper -->

    <!-- Toast Container -->
    <div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 11">
        <div id="toast-container"></div>
    </div>

    <!-- Original Scripts for backward compatibility -->
    <script>
        let userInfor = localStorage.getItem("userInfor"),
            userInforJson = userInfor ? JSON.parse(userInfor) : null;
        let _mainConfig = {
            userName: userInforJson && userInforJson.userName ? userInforJson.userName : '',
            avatar: userInforJson && userInforJson.avatar ? userInforJson.avatar : ''
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script src="/js/Mixin/notification.js"></script>
    <script src="~/js/Page/Base/detail.js"></script>

    <!-- Admin Template Main JS -->
    <script type="module" crossorigin src="~/admin-template/main-BPhDq89w.js"></script>

    <!-- Sidebar Submenu JS -->
    <script src="~/js/sidebar-submenu.js"></script>

    <!-- Sidebar Toggle Script -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleButton = document.querySelector('[data-sidebar-toggle]');
        const wrapper = document.getElementById('admin-wrapper');

        if (toggleButton && wrapper) {
          // Set initial state from localStorage
          const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
          if (isCollapsed) {
            wrapper.classList.add('sidebar-collapsed');
            toggleButton.classList.add('is-active');
          }

          // Attach click listener
          toggleButton.addEventListener('click', () => {
            const isCurrentlyCollapsed = wrapper.classList.contains('sidebar-collapsed');

            if (isCurrentlyCollapsed) {
              wrapper.classList.remove('sidebar-collapsed');
              toggleButton.classList.remove('is-active');
              localStorage.setItem('sidebar-collapsed', 'false');
            } else {
              wrapper.classList.add('sidebar-collapsed');
              toggleButton.classList.add('is-active');
              localStorage.setItem('sidebar-collapsed', 'true');
            }
          });
        }
      });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
