@{
    var row = ViewBag.Row;
    var value = ViewBag.Value;
}

<div class="d-flex align-items-center">
    <div class="avatar-circle @GetAvatarClass(row) text-white me-3">
        <i class="@GetAvatarIcon(row)"></i>
    </div>
    <div>
        <div class="fw-bold">@GetDisplayName(row)</div>
        <small class="text-muted">@GetUsername(row)</small>
        <div class="d-flex align-items-center mt-1">
            @if (!string.IsNullOrEmpty(GetOnlineStatus(row)))
            {
                <span class="badge @GetOnlineStatusClass(row) me-2">@GetOnlineStatus(row)</span>
            }
            @if (!string.IsNullOrEmpty(GetUserId(row)))
            {
                <small class="text-muted">ID: @GetUserId(row)</small>
            }
        </div>
    </div>
</div>

@functions {
    private string GetDisplayName(dynamic row)
    {
        return row?.FullName ?? row?.Name ?? row?.DisplayName ?? "Unknown User";
    }
    
    private string GetUsername(dynamic row)
    {
        return row?.Username ?? row?.UserName ?? row?.Email ?? "";
    }
    
    private string GetUserId(dynamic row)
    {
        return row?.Id?.ToString() ?? row?.UserId?.ToString() ?? "";
    }
    
    private string GetOnlineStatus(dynamic row)
    {
        return row?.OnlineStatus ?? row?.Status ?? "";
    }
    
    private string GetAvatarClass(dynamic row)
    {
        var role = row?.Role?.ToString()?.ToLower() ?? "";
        return role switch
        {
            "super admin" or "superadmin" => "bg-danger",
            "admin" => "bg-primary", 
            "moderator" => "bg-warning",
            "support" => "bg-info",
            _ => "bg-secondary"
        };
    }
    
    private string GetAvatarIcon(dynamic row)
    {
        var role = row?.Role?.ToString()?.ToLower() ?? "";
        return role switch
        {
            "super admin" or "superadmin" => "bi bi-shield-fill",
            "admin" => "bi bi-person-gear",
            "moderator" => "bi bi-person-check",
            "support" => "bi bi-headset",
            _ => "bi bi-person-fill"
        };
    }
    
    private string GetOnlineStatusClass(dynamic row)
    {
        var status = GetOnlineStatus(row)?.ToLower() ?? "";
        return status switch
        {
            "online" or "đang online" => "bg-success",
            "offline" or "đã offline" => "bg-secondary",
            "away" or "vắng mặt" => "bg-warning",
            _ => "bg-secondary"
        };
    }
}
