<!-- Change User Role Modal -->
<div class="modal fade" id="changeRoleModal" tabindex="-1" aria-labelledby="changeRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changeRoleModalLabel">
                    <i class="bi bi-arrow-left-right me-2"></i>Thay đổi vai trò
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changeRoleForm">
                    <div class="mb-3">
                        <label class="form-label">Người dùng</label>
                        <input type="text" class="form-control" id="selectedUser" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vai trò hiện tại</label>
                        <input type="text" class="form-control" id="currentRole" readonly>
                    </div>
                    <div class="mb-3">
                        <div class="form-floating">
                            <select class="form-select" id="newRole" required>
                                <option value="">Chọn vai trò mới</option>
                                <option value="admin">Admin</option>
                                <option value="customer">Customer</option>
                                <option value="support">Support</option>
                            </select>
                            <label for="newRole">Vai trò mới *</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-floating">
                            <textarea class="form-control" id="changeReason" placeholder="Lý do thay đổi" style="height: 80px"></textarea>
                            <label for="changeReason">Lý do thay đổi</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-warning" id="confirmChangeRole">
                    <i class="bi bi-arrow-left-right me-1"></i>Thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .role-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }
</style>

@section Scripts {
    <script>
        // Role functions
        function viewRolePermissions(id) {
            alert('Xem quyền hạn của vai trò ID: ' + id);
        }

        function editRole(id) {
            alert('Chỉnh sửa vai trò ID: ' + id);
        }

        function deleteRole(id) {
            if (confirm('Bạn có chắc chắn muốn xóa vai trò này?')) {
                alert('Đã xóa vai trò ID: ' + id);
            }
        }

        // Permission functions
        function editPermission(code) {
            alert('Chỉnh sửa quyền: ' + code);
        }

        function deletePermission(code) {
            if (confirm('Bạn có chắc chắn muốn xóa quyền này?')) {
                alert('Đã xóa quyền: ' + code);
            }
        }

        // Assignment functions
        function changeUserRole(userId) {
            document.getElementById('selectedUser').value = 'Người dùng ID: ' + userId;
            document.getElementById('currentRole').value = 'Admin';
            new bootstrap.Modal(document.getElementById('changeRoleModal')).show();
        }

        function viewUserPermissions(userId) {
            alert('Xem quyền hạn của người dùng ID: ' + userId);
        }

        function resetAssignmentFilter() {
            document.getElementById('searchUser').value = '';
            document.getElementById('filterRole').value = '';
            document.getElementById('filterStatus').value = '';
        }

        // Save functions
        document.getElementById('saveRole').addEventListener('click', function() {
            const form = document.getElementById('roleForm');
            if (form.checkValidity()) {
                alert('Đã lưu vai trò thành công!');
                bootstrap.Modal.getInstance(document.getElementById('addRoleModal')).hide();
            } else {
                form.reportValidity();
            }
        });

        document.getElementById('savePermission').addEventListener('click', function() {
            const form = document.getElementById('permissionForm');
            if (form.checkValidity()) {
                alert('Đã lưu quyền hạn thành công!');
                bootstrap.Modal.getInstance(document.getElementById('addPermissionModal')).hide();
            } else {
                form.reportValidity();
            }
        });

        document.getElementById('confirmChangeRole').addEventListener('click', function() {
            const newRole = document.getElementById('newRole').value;
            if (newRole) {
                alert('Đã thay đổi vai trò thành công!');
                bootstrap.Modal.getInstance(document.getElementById('changeRoleModal')).hide();
            } else {
                alert('Vui lòng chọn vai trò mới!');
            }
        });
    </script>
}
