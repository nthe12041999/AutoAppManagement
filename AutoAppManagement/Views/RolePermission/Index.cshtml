                        <h3 class="mb-0">6</h3>
                    </div>
                    <i class="bi bi-check-circle fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs mb-4" id="rolesTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="roles-tab" data-bs-toggle="tab" data-bs-target="#roles" type="button" role="tab">
            <i class="bi bi-person-badge me-2"></i>Vai trò
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="permissions-tab" data-bs-toggle="tab" data-bs-target="#permissions" type="button" role="tab">
            <i class="bi bi-shield-check me-2"></i>Quyền hạn
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments" type="button" role="tab">
            <i class="bi bi-people me-2"></i>Phân quyền
        </button>
    </li>
</ul>

