    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-key me-2 text-primary"></i>Quản lý quyền hạn
        </h1>
        <p class="text-muted mb-0">Quản lý vai trò và phân quyền trong hệ thống</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item active">Quyền hạn</li>
        </ol>
    </nav>
</div>

<!-- Statistics Cards -->
