@{
    ViewData["Title"] = "Quản lý quyền hạn";
    ViewData["PageName"] = "roles-permissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">
                        <i class="bi bi-shield-check me-2 text-primary"></i>Quản lý quyền hạn
                    </h1>
                    <p class="text-muted mb-0">Quản lý các quyền hạn trong hệ thống</p>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                        <li class="breadcrumb-item active">Quyền hạn</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Role Permission Grid Filter - Card Filter Component -->
    <div data-component="card-filter"
         data-container-id="rolePermissionGridFilter"
         data-has-search="true"
         data-has-status="true"
         data-has-category="false"
         data-has-group="true"
         data-has-date-range="false"
         data-search-label="Tìm kiếm quyền hạn"
         data-search-placeholder="Nhập tên quyền hạn, mã..."
         data-status-options="active:Hoạt động,inactive:Không hoạt động,pending:Chờ phê duyệt"
         data-group-options="users:Người dùng,license:License,reports:Báo cáo,settings:Cài đặt,orders:Đơn hàng,system:Hệ thống"
         data-debounce-ms="300"
         data-auto-apply="true">
    </div>

    <!-- DataGrid Component với AJAX -->
    <div class="card" data-component="data-grid"
         data-container-id="rolePermissionDataGrid"
         data-entity="RolePermission"
         data-entity-plural="RolePermissions"
         data-title-grid="Danh sách quyền hạn hệ thống"
         data-get-url="@Url.Action("GetRolePermissions", "RolePermission")"
         data-detail-url="@Url.Action("DetailRolePermission", "RolePermission")"
         data-detail-form="RolePermissionForms"
         data-has-add="true"
         data-has-refresh="true"
         data-has-export="true"
         data-has-select-all="true"
         data-has-pagination="true"
         data-page-size="10"
         data-total-items="20">
    </div>
</div>

@section Styles {
    <link href="~/css/pages/role-permission-grid.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/enums/column-types.js"></script>
    <script src="~/js/pages/role-permission-grid.js"></script>
}
