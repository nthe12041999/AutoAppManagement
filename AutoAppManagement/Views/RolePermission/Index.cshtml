                                <th scope="col">Trạng thái</th>
                                <th scope="col" width="120">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-danger text-white me-3">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">Nguyễn Văn Admin</div>
                                            <small class="text-muted">ID: 001</small>
                                        </div>
                                    </div>
                                </td>
                                <td>admin@autoapp.com</td>
                                <td><span class="badge bg-danger">Super Admin</span></td>
                                <td>01/01/2024</td>
                                <td><span class="badge bg-success">Hoạt động</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-warning" title="Thay đổi vai trò" onclick="changeUserRole(1)">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </button>
                                        <button class="btn btn-outline-primary" title="Xem quyền" onclick="viewUserPermissions(1)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white me-3">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">Trần Thị Manager</div>
                                            <small class="text-muted">ID: 002</small>
                                        </div>
                                    </div>
                                </td>
                                <td>manager@autoapp.com</td>
                                <td><span class="badge bg-primary">Admin</span></td>
                                <td>05/01/2024</td>
                                <td><span class="badge bg-success">Hoạt động</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-warning" title="Thay đổi vai trò" onclick="changeUserRole(2)">
                                            <i class="bi bi-arrow-left-right"></i>
                                        </button>
                                        <button class="btn btn-outline-primary" title="Xem quyền" onclick="viewUserPermissions(2)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Role Modal -->
<div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addRoleModalLabel">
                    <i class="bi bi-person-badge me-2"></i>Thêm vai trò mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="roleName" placeholder="Tên vai trò" required>
                            <label for="roleName">Tên vai trò *</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="roleCode" placeholder="Mã vai trò" required>
                            <label for="roleCode">Mã vai trò *</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-floating">
                            <textarea class="form-control" id="roleDescription" placeholder="Mô tả" style="height: 100px"></textarea>
                            <label for="roleDescription">Mô tả</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Chọn quyền hạn</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="perm1" value="users.view">
                                    <label class="form-check-label" for="perm1">Xem người dùng</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="perm2" value="users.create">
