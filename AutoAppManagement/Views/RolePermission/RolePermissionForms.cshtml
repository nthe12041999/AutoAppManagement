@{
    string mode = ViewBag.Mode?.ToString() ?? "add";
    string modalTitle = mode switch {
        "add" => "Thêm mới quyền hạn",
        "edit" => "Chỉnh sửa quyền hạn", 
        "view" => "Xem chi tiết quyền hạn",
        _ => "Quản lý quyền hạn"
    };
}

<div class="modal-header">
    <h5 class="modal-title">@modalTitle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="rolePermissionForm" method="post">
    <div class="modal-body">
        <!-- Tab Selection -->
        <div class="mb-3">
            <label class="form-label">Loại thông tin</label>
            <div class="btn-group d-flex" role="group">
                <input type="radio" class="btn-check" name="entityType" id="roleType" value="role" checked>
                <label class="btn btn-outline-primary" for="roleType">
                    <i class="bi bi-person-badge me-2"></i>Vai trò
                </label>
                
                <input type="radio" class="btn-check" name="entityType" id="permissionType" value="permission">
                <label class="btn btn-outline-primary" for="permissionType">
                    <i class="bi bi-shield-check me-2"></i>Quyền hạn
                </label>
            </div>
        </div>

        @if (mode == "add" || mode == "edit")
        {
            <!-- Role Form -->
            <div id="roleForm" class="entity-form">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="roleName" class="form-label">Tên vai trò <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="roleName" name="RoleName" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="roleCode" class="form-label">Mã vai trò <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="roleCode" name="RoleCode" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="roleDescription" class="form-label">Mô tả</label>
                    <textarea class="form-control" id="roleDescription" name="RoleDescription" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label for="roleGroup" class="form-label">Nhóm vai trò</label>
                    <select class="form-select" id="roleGroup" name="RoleGroup">
                        <option value="">-- Chọn nhóm --</option>
                        <option value="admin">Quản trị</option>
                        <option value="management">Quản lý</option>
                        <option value="staff">Nhân viên</option>
                        <option value="customer">Khách hàng</option>
                    </select>
                </div>

                <!-- Role Status -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="roleStatus" class="form-label">Trạng thái <span class="text-danger">*</span></label>
                        <select class="form-select" id="roleStatus" name="RoleStatus" required>
                            <option value="">-- Chọn trạng thái --</option>
                            <option value="active">Hoạt động</option>
                            <option value="inactive">Không hoạt động</option>
                            <option value="pending">Chờ phê duyệt</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="rolePriority" class="form-label">Độ ưu tiên</label>
                        <input type="number" class="form-control" id="rolePriority" name="RolePriority" min="1" max="10" value="5">
                    </div>
                </div>

                <!-- Role Permissions -->
                <div class="mb-3">
                    <label class="form-label">Quyền hạn</label>
                    <div class="card">
                        <div class="card-body">
                            <div class="row g-2">
                                <!-- User Management -->
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-primary">
                                        <i class="bi bi-people me-2"></i>Quản lý người dùng
                                    </h6>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_users_view" name="Permissions" value="users.view">
                                        <label class="form-check-label" for="perm_users_view">Xem người dùng</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_users_create" name="Permissions" value="users.create">
                                        <label class="form-check-label" for="perm_users_create">Tạo người dùng</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_users_edit" name="Permissions" value="users.edit">
                                        <label class="form-check-label" for="perm_users_edit">Chỉnh sửa người dùng</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_users_delete" name="Permissions" value="users.delete">
                                        <label class="form-check-label" for="perm_users_delete">Xóa người dùng</label>
                                    </div>
                                </div>

                                <!-- License Management -->
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-success">
                                        <i class="bi bi-key me-2"></i>Quản lý License
                                    </h6>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_license_view" name="Permissions" value="license.view">
                                        <label class="form-check-label" for="perm_license_view">Xem license</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_license_create" name="Permissions" value="license.create">
                                        <label class="form-check-label" for="perm_license_create">Tạo license</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_license_renew" name="Permissions" value="license.renew">
                                        <label class="form-check-label" for="perm_license_renew">Gia hạn license</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_license_suspend" name="Permissions" value="license.suspend">
                                        <label class="form-check-label" for="perm_license_suspend">Tạm dừng license</label>
                                    </div>
                                </div>

                                <!-- Reports -->
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-warning">
                                        <i class="bi bi-graph-up me-2"></i>Báo cáo
                                    </h6>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_reports_view" name="Permissions" value="reports.view">
                                        <label class="form-check-label" for="perm_reports_view">Xem báo cáo</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_reports_export" name="Permissions" value="reports.export">
                                        <label class="form-check-label" for="perm_reports_export">Xuất báo cáo</label>
                                    </div>
                                </div>

                                <!-- System Settings -->
                                <div class="col-md-6">
                                    <h6 class="fw-bold text-danger">
                                        <i class="bi bi-gear me-2"></i>Cài đặt hệ thống
                                    </h6>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_settings_view" name="Permissions" value="settings.view">
                                        <label class="form-check-label" for="perm_settings_view">Xem cài đặt</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="perm_settings_edit" name="Permissions" value="settings.edit">
                                        <label class="form-check-label" for="perm_settings_edit">Thay đổi cài đặt</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Permission Form -->
            <div id="permissionForm" class="entity-form" style="display: none;">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="permissionName" class="form-label">Tên quyền <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="permissionName" name="PermissionName" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="permissionCode" class="form-label">Mã quyền <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="permissionCode" name="PermissionCode" placeholder="vd: users.view" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="permissionDescription" class="form-label">Mô tả</label>
                    <textarea class="form-control" id="permissionDescription" name="PermissionDescription" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="permissionGroup" class="form-label">Nhóm quyền <span class="text-danger">*</span></label>
                        <select class="form-select" id="permissionGroup" name="PermissionGroup" required>
                            <option value="">-- Chọn nhóm --</option>
                            <option value="users">Quản lý người dùng</option>
                            <option value="license">Quản lý License</option>
                            <option value="reports">Báo cáo</option>
                            <option value="settings">Cài đặt hệ thống</option>
                            <option value="finance">Tài chính</option>
                            <option value="support">Hỗ trợ</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="permissionLevel" class="form-label">Cấp độ quyền</label>
                        <select class="form-select" id="permissionLevel" name="PermissionLevel">
                            <option value="read">Chỉ đọc</option>
                            <option value="write">Ghi</option>
                            <option value="admin">Quản trị</option>
                            <option value="super">Siêu quản trị</option>
                        </select>
                    </div>
                </div>

                <!-- Permission Resource -->
                <div class="mb-3">
                    <label for="permissionResource" class="form-label">Tài nguyên áp dụng</label>
                    <input type="text" class="form-control" id="permissionResource" name="PermissionResource" placeholder="vd: /users, /license, *">
                </div>

                <!-- Permission Conditions -->
                <div class="mb-3">
                    <label for="permissionConditions" class="form-label">Điều kiện áp dụng</label>
                    <textarea class="form-control" id="permissionConditions" name="PermissionConditions" rows="2" placeholder="Điều kiện JSON (tùy chọn)"></textarea>
                </div>
            </div>
        }
        else if (mode == "view")
        {
            <!-- View Mode - Display Only -->
            <div class="row">
                <div class="col-12 mb-4 text-center">
                    <div class="role-icon bg-primary text-white mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="mt-2 mb-0" id="viewEntityName">Tên vai trò/quyền</h5>
                    <span class="badge bg-primary" id="viewEntityType">Vai trò</span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Mã:</label>
                    <p class="mb-0" id="viewEntityCode">-</p>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Trạng thái:</label>
                    <p class="mb-0">
                        <span class="badge" id="viewEntityStatus">-</span>
                    </p>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">Mô tả:</label>
                    <p class="mb-0" id="viewEntityDescription">-</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Ngày tạo:</label>
                    <p class="mb-0" id="viewCreatedDate">-</p>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Cập nhật lần cuối:</label>
                    <p class="mb-0" id="viewUpdatedDate">-</p>
                </div>
            </div>

            <!-- View Permissions (for Role) -->
            <div id="viewPermissions" class="mb-3">
                <label class="form-label fw-bold">Quyền hạn:</label>
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-1" id="viewPermissionsList">
                            <!-- Permission badges will be loaded here -->
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="modal-footer">
        @if (mode == "add" || mode == "edit")
        {
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-primary">
                @(mode == "add" ? "Thêm mới" : "Cập nhật")
            </button>
        }
        else
        {
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="button" class="btn btn-primary" onclick="editRolePermission()">Chỉnh sửa</button>
        }
    </div>
</form>

<style>
    .role-icon {
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .entity-form .form-check {
        margin-bottom: 0.5rem;
    }
    .entity-form .form-check-label {
        font-size: 0.9rem;
    }
</style>

<script>
$(document).ready(function() {
    // Toggle between Role and Permission forms
    $('input[name="entityType"]').on('change', function() {
        const selectedType = $(this).val();
        
        if (selectedType === 'role') {
            $('#roleForm').show();
            $('#permissionForm').hide();
            // Enable/disable validation
            $('#roleForm input[required], #roleForm select[required]').prop('required', true);
            $('#permissionForm input[required], #permissionForm select[required]').prop('required', false);
        } else {
            $('#roleForm').hide();
            $('#permissionForm').show();
            // Enable/disable validation
            $('#roleForm input[required], #roleForm select[required]').prop('required', false);
            $('#permissionForm input[required], #permissionForm select[required]').prop('required', true);
        }
    });

    // Form submission
    $('#rolePermissionForm').on('submit', function(e) {
        e.preventDefault();
        
        const entityType = $('input[name="entityType"]:checked').val();
        const mode = '@mode';
        
        // Show loading
        Swal.fire({
            title: 'Đang xử lý...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        // Simulate API call
        setTimeout(() => {
            Swal.fire({
                title: 'Thành công!',
                text: `${entityType === 'role' ? 'Vai trò' : 'Quyền hạn'} đã được ${mode === 'add' ? 'tạo' : 'cập nhật'} thành công.`,
                icon: 'success'
            }).then(() => {
                // Close modal and refresh grid
                $('.modal-container').remove();
                if (window.dataGridInstance) {
                    const config = window.dataGridInstance.getGrid('rolePermissionDataGrid');
                    if (config) {
                        window.dataGridInstance.refreshData(config);
                    }
                }
            });
        }, 1500);
    });

    // Auto-generate role code from name
    $('#roleName').on('input', function() {
        const name = $(this).val();
        const code = name.toLowerCase()
                         .replace(/\s+/g, '_')
                         .replace(/[^a-z0-9_]/g, '');
        $('#roleCode').val(code);
    });

    // Auto-generate permission code from name and group
    $('#permissionName, #permissionGroup').on('input change', function() {
        const name = $('#permissionName').val();
        const group = $('#permissionGroup').val();
        
        if (name && group) {
            const action = name.toLowerCase()
                              .replace(/\s+/g, '_')
                              .replace(/[^a-z0-9_]/g, '');
            const code = `${group}.${action}`;
            $('#permissionCode').val(code);
        }
    });
});

function editRolePermission() {
    // Close current modal and open edit mode
    $('.modal-container').remove();
    
    // Get entity ID from the current view
    const entityId = $('#rolePermissionModal').data('entity-id');
    
    // Load edit form
    setTimeout(() => {
        if (window.dataGridInstance) {
            window.dataGridInstance.loadDetailFormModal('rolePermissionDataGrid', entityId, 'edit');
        }
    }, 500);
}
</script>
