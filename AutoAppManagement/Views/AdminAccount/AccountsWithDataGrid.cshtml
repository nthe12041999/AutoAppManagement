@using AutoAppManagement.Helpers
@using AutoAppManagement.Models.Components
@{
    ViewData["Title"] = "Quản lý tài khoản Admin - DataGrid Component";
    ViewData["PageName"] = "admin-accounts";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get data from ViewBag or Model
    var adminData = ViewBag.AdminData as List<dynamic> ?? Model as List<dynamic> ?? new List<dynamic>();

    // Fallback sample data if no data provided
    if (!adminData.Any())
    {
        adminData = new List<dynamic>
        {
            new {
                Id = 1,
                FullName = "Nguyễn Văn Admin",
                Username = "superadmin",
                Email = "admin@autoapp.com",
                Role = "Super Admin",
                Status = "Hoạt động",
                OnlineStatus = "Online",
                LastLogin = DateTime.Now.AddHours(-2),
                CreatedDate = DateTime.Now.AddDays(-30)
            },
            new {
                Id = 2,
                FullName = "Trần Thị Manager",
                Username = "manager01",
                Email = "manager@autoapp.com",
                Role = "Admin",
                Status = "Hoạt động",
                OnlineStatus = "Offline",
                LastLogin = DateTime.Now.AddHours(-5),
                CreatedDate = DateTime.Now.AddDays(-25)
            },
            new {
                Id = 3,
                FullName = "Lê Minh Support",
                Username = "support01",
                Email = "support@autoapp.com",
                Role = "Support",
                Status = "Hoạt động",
                OnlineStatus = "Online",
                LastLogin = DateTime.Now.AddMinutes(-30),
                CreatedDate = DateTime.Now.AddDays(-20)
            }
        };
    }

    // Create DataGrid using object initialization
    var gridModel = new DataGridModel
    {
        TableId = "adminTable",
        Title = "Danh sách tài khoản Admin",
        TitleIcon = "bi bi-shield-check",
        Data = adminData,
        ShowCheckbox = true,
        ShowActions = true,
        ShowPagination = true,
        ShowExport = true,
        ShowRefresh = true,
        TotalRecords = adminData.Count,
        Columns = new List<DataGridColumn>
        {
            new DataGridColumn { Title = "Thông tin Admin", BindingField = "", Type = "user" },
            new DataGridColumn { Title = "Email", BindingField = "Email", Type = "text" },
            new DataGridColumn { Title = "Vai trò", BindingField = "Role", Type = "badge" },
            new DataGridColumn { Title = "Trạng thái", BindingField = "Status", Type = "badge" },
            new DataGridColumn { Title = "Lần đăng nhập cuối", BindingField = "LastLogin", Type = "datetime" }
        },
        ActionButtons = new List<DataGridAction>
        {
            new DataGridAction { Title = "Xem chi tiết", Icon = "bi bi-eye", CssClass = "btn-outline-primary", Action = "viewAdmin" },
            new DataGridAction { Title = "Chỉnh sửa", Icon = "bi bi-pencil", CssClass = "btn-outline-warning", Action = "editAdmin" },
            new DataGridAction { Title = "Phân quyền", Icon = "bi bi-key", CssClass = "btn-outline-secondary", Action = "managePermissions" }
        }
    };
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-shield-check me-2 text-primary"></i>Quản lý tài khoản Admin (DataGrid Component)
        </h1>
        <p class="text-muted mb-0">Sử dụng DataGrid Component có thể tái sử dụng</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item active">Admin DataGrid</li>
        </ol>
    </nav>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Tổng Admin</h6>
                        <h3 class="mb-0">@adminData.Count</h3>
                    </div>
                    <i class="bi bi-shield-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Đang hoạt động</h6>
                        <h3 class="mb-0">@adminData.Count(x => x.Status == "Hoạt động")</h3>
                    </div>
                    <i class="bi bi-check-circle-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Super Admin</h6>
                        <h3 class="mb-0">@adminData.Count(x => x.Role == "Super Admin")</h3>
                    </div>
                    <i class="bi bi-star-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Online</h6>
                        <h3 class="mb-0">@adminData.Count(x => x.OnlineStatus == "Online")</h3>
                    </div>
                    <i class="bi bi-circle-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter and Actions -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="form-floating">
                    <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm...">
                    <label for="searchInput">
                        <i class="bi bi-search me-2"></i>Tìm kiếm Admin
                    </label>
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="roleFilter">
                    <option value="">Tất cả vai trò</option>
                    <option value="super_admin">Super Admin</option>
                    <option value="admin">Admin</option>
                    <option value="support">Support</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="statusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Hoạt động</option>
                    <option value="inactive">Không hoạt động</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <input type="date" class="form-control" id="dateFrom">
                    <span class="input-group-text">đến</span>
                    <input type="date" class="form-control" id="dateTo">
                </div>
            </div>
            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" id="resetFilter">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAdminModal">
                        <i class="bi bi-plus-lg me-1"></i>Thêm Admin
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DataGrid Component -->
@await Html.PartialAsync("~/Views/Shared/Components/DataGrid/DataGrid.cshtml", gridModel)

@section Scripts {
    <script>
        // Select all functionality
        document.getElementById('adminTable_selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Action functions
        function viewAdmin(id) {
            alert('Xem chi tiết admin ID: ' + id);
        }

        function editAdmin(id) {
            alert('Chỉnh sửa admin ID: ' + id);
        }

        function managePermissions(id) {
            alert('Quản lý quyền hạn cho admin ID: ' + id);
        }

        function exportData() {
            alert('Xuất dữ liệu Excel');
        }

        function refreshData() {
            alert('Làm mới dữ liệu');
            location.reload();
        }

        function goToPage(page) {
            alert('Chuyển đến trang: ' + page);
        }
    </script>
}
