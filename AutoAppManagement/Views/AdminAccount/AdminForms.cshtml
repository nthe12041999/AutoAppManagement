@using AutoAppManagement.Models.Enums
@{
    ViewData["Title"] = "Admin Forms";
    ViewData["PageName"] = "admin-forms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Admin Form -->
<div class="row">
    <div class="col-lg-8 mx-auto">
        <div data-type="@ControlType.Form"
             data-id="adminForm"
             data-label="<i class='bi bi-shield-check me-2'></i>Thông tin tài khoản Admin"
             data-class="border-primary"
             data-button-save-id="saveAdminBtn"
             data-button-cancel-id="cancelAdminBtn"
             data-form-id="adminForm"
             data-url="/AdminAccount/SaveAdmin"
             data-method="POST">
                    <!-- Personal Info -->
                    <div class="row">
                        <div data-type="@ControlType.Text"
                             data-id="fullName"
                             data-name="fullName"
                             data-label="Họ và tên"
                             data-placeholder="Nhập họ và tên"
                             data-wrapper-class="col-md-6"
                             data-required></div>

                        <div data-type="@ControlType.Email"
                             data-id="email"
                             data-name="email"
                             data-label="Email"
                             data-placeholder="admin@company.com"
                             data-wrapper-class="col-md-6"
                             data-required></div>
                    </div>

                    <div class="row">
                        <div data-type="@ControlType.Tel"
                             data-id="phone"
                             data-name="phone"
                             data-label="Số điện thoại"
                             data-placeholder="0XXX XXX XXX"
                             data-wrapper-class="col-md-6"></div>

                        <div data-type="@ControlType.Text"
                             data-id="username"
                             data-name="username"
                             data-label="Tên đăng nhập"
                             data-placeholder="username"
                             data-wrapper-class="col-md-6"
                             data-required></div>
                    </div>

                    <!-- Account Info -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="role" class="form-label">Vai trò *</label>
                            <select class="form-select" id="role" required>
                                <option value="">Chọn vai trò</option>
                                <option value="super_admin">Super Admin</option>
                                <option value="admin">Admin</option>
                                <option value="moderator">Moderator</option>
                                <option value="support">Support</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn vai trò</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="status" class="form-label">Trạng thái *</label>
                            <select class="form-select" id="status" required>
                                <option value="">Chọn trạng thái</option>
                                <option value="active">Hoạt động</option>
                                <option value="inactive">Không hoạt động</option>
                                <option value="pending">Chờ xác thực</option>
                                <option value="locked">Bị khóa</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn trạng thái</div>
                        </div>
                    </div>

                    <!-- Password (for new accounts) -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="password" class="form-label">Mật khẩu *</label>
                            <input type="password" class="form-control" id="password" placeholder="Nhập mật khẩu" required>
                            <div class="invalid-feedback">Mật khẩu phải có ít nhất 8 ký tự</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="confirmPassword" class="form-label">Xác nhận mật khẩu *</label>
                            <input type="password" class="form-control" id="confirmPassword" placeholder="Nhập lại mật khẩu" required>
                            <div class="invalid-feedback">Mật khẩu xác nhận không khớp</div>
                        </div>
                    </div>

                    <!-- Permissions -->
                    <div class="mb-3">
                        <label class="form-label">Quyền hạn</label>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="permUser" value="user_management">
                                    <label class="form-check-label" for="permUser">Quản lý User</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="permLicense" value="license_management">
                                    <label class="form-check-label" for="permLicense">Quản lý License</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="permReport" value="reports">
                                    <label class="form-check-label" for="permReport">Báo cáo</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="permSystem" value="system_settings">
                                    <label class="form-check-label" for="permSystem">Cài đặt hệ thống</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="permAudit" value="audit_logs">
                                    <label class="form-check-label" for="permAudit">Nhật ký hệ thống</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="permBackup" value="backup">
                                    <label class="form-check-label" for="permBackup">Sao lưu</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Info -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="department" class="form-label">Phòng ban</label>
                            <select class="form-select" id="department">
                                <option value="">Chọn phòng ban</option>
                                <option value="it">Công nghệ thông tin</option>
                                <option value="hr">Nhân sự</option>
                                <option value="finance">Tài chính</option>
                                <option value="marketing">Marketing</option>
                                <option value="support">Hỗ trợ khách hàng</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="manager" class="form-label">Quản lý trực tiếp</label>
                            <select class="form-select" id="manager">
                                <option value="">Chọn quản lý</option>
                                <option value="1">Nguyễn Văn A - CEO</option>
                                <option value="2">Trần Thị B - CTO</option>
                                <option value="3">Lê Minh C - Manager</option>
                            </select>
                        </div>
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label for="notes" class="form-label">Ghi chú</label>
                        <textarea class="form-control" id="notes" rows="3" placeholder="Ghi chú về tài khoản admin..." maxlength="500"></textarea>
                        <div class="form-text">
                            <span id="notesCount">0</span>/500 ký tự
                        </div>
                    </div>

                    <!-- Switch -->
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="requirePasswordChange">
                            <label class="form-check-label" for="requirePasswordChange">Yêu cầu đổi mật khẩu lần đăng nhập đầu</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="twoFactorAuth">
                            <label class="form-check-label" for="twoFactorAuth">Bật xác thực 2 bước</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="sendWelcomeEmail" checked>
                            <label class="form-check-label" for="sendWelcomeEmail">Gửi email chào mừng</label>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-secondary" id="cancelBtn">
                            <i class="bi bi-x-lg me-2"></i>Hủy
                        </button>
                        <button type="reset" class="btn btn-warning" id="resetBtn">
                            <i class="bi bi-arrow-clockwise me-2"></i>Reset
                        </button>
                        <button type="submit" class="btn btn-primary" id="saveBtn">
                            <i class="bi bi-check-lg me-2"></i>Lưu tài khoản
                        </button>
                    </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize form control binder
            window.formControlBinder.init('#adminForm');

            const form = document.getElementById('adminForm');
            const cancelBtn = document.getElementById('cancelBtn');
            const resetBtn = document.getElementById('resetBtn');
            const saveBtn = document.getElementById('saveBtn');
            const notesTextarea = document.getElementById('notes');
            const notesCount = document.getElementById('notesCount');
            const passwordField = document.getElementById('password');
            const confirmPasswordField = document.getElementById('confirmPassword');

            // Character count for notes
            notesTextarea.addEventListener('input', function() {
                const length = this.value.length;
                notesCount.textContent = length;
                
                if (length > 450) {
                    notesCount.style.color = '#ffc107';
                } else {
                    notesCount.style.color = '#6c757d';
                }
            });

            // Password validation
            function validatePassword() {
                const password = passwordField.value;
                const confirmPassword = confirmPasswordField.value;
                
                if (password.length > 0 && password.length < 8) {
                    passwordField.classList.add('is-invalid');
                    return false;
                }
                
                if (confirmPassword.length > 0 && password !== confirmPassword) {
                    confirmPasswordField.classList.add('is-invalid');
                    return false;
                }
                
                if (password.length >= 8) {
                    passwordField.classList.remove('is-invalid');
                    passwordField.classList.add('is-valid');
                }
                
                if (confirmPassword.length > 0 && password === confirmPassword) {
                    confirmPasswordField.classList.remove('is-invalid');
                    confirmPasswordField.classList.add('is-valid');
                }
                
                return true;
            }

            passwordField.addEventListener('input', validatePassword);
            confirmPasswordField.addEventListener('input', validatePassword);

            // Form validation
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                event.stopPropagation();
                
                let isFormValid = true;
                
                // Check required fields
                const requiredFields = form.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        isFormValid = false;
                        field.classList.add('is-invalid');
                    } else {
                        field.classList.remove('is-invalid');
                        field.classList.add('is-valid');
                    }
                });

                // Validate password
                if (!validatePassword()) {
                    isFormValid = false;
                }
                
                if (isFormValid) {
                    showNotification('✅ Admin validation thành công! Đang lưu...', 'success');
                    
                    // Simulate saving process
                    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
                    saveBtn.disabled = true;
                    
                    setTimeout(() => {
                        saveBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Lưu tài khoản';
                        saveBtn.disabled = false;
                        showNotification('💾 Tài khoản admin đã được lưu thành công!', 'success');
                        
                        // Close modal if in modal
                        const modalContainer = form.closest('.modal-container');
                        if (modalContainer) {
                            setTimeout(() => {
                                modalContainer.remove();
                            }, 1500);
                        }
                    }, 2000);
                } else {
                    showNotification('❌ Vui lòng kiểm tra lại các trường bắt buộc', 'error');
                }
                
                form.classList.add('was-validated');
            });

            // Reset button
            resetBtn.addEventListener('click', function() {
                form.classList.remove('was-validated');
                notesCount.textContent = '0';
                showNotification('🔄 Form đã được reset', 'info');
            });

            // Cancel button
            cancelBtn.addEventListener('click', function() {
                if (confirm('Bạn có chắc muốn hủy? Dữ liệu sẽ không được lưu.')) {
                    form.reset();
                    form.classList.remove('was-validated');
                    notesCount.textContent = '0';
                    showNotification('❌ Đã hủy thao tác', 'warning');
                    
                    // Close modal if form is in modal
                    const modalContainer = this.closest('.modal-container');
                    if (modalContainer) {
                        modalContainer.remove();
                    }
                }
            });
        });

        function showNotification(message, type = 'info') {
            const alertClass = type === 'error' ? 'alert-danger' : 
                              type === 'success' ? 'alert-success' : 
                              type === 'warning' ? 'alert-warning' : 'alert-info';
            
            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 350px; max-width: 500px;';
            notification.innerHTML = `
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="d-flex align-items-center">
                    ${message}
                </div>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 4000);
        }
    </script>
}
