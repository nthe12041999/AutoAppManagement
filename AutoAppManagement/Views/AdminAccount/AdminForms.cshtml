@using AutoAppManagement.Models.Enums
@{
    ViewData["Title"] = "Admin Forms";
    ViewData["PageName"] = "admin-forms";
}


<!-- Admin Form - Sử dụng data-type để binding giống RoleForms và LicenseForms -->
<form id="adminForm" action="/AdminAccount/SaveAdmin" method="POST">
    <!-- Personal Info -->
    <div class="row">
        <div data-type="Text"
             data-id="fullName"
             data-name="fullName"
             data-label="Họ và tên"
             data-placeholder="Nhập họ và tên"
             data-wrapper-class="col-md-6"
             data-required></div>
        <div data-type="Email"
             data-id="email"
             data-name="email"
             data-label="Email"
             data-placeholder="admin@company.com"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <div class="row">
        <div data-type="Tel"
             data-id="phone"
             data-name="phone"
             data-label="Số điện thoại"
             data-placeholder="0XXX XXX XXX"
             data-wrapper-class="col-md-6"></div>
        <div data-type="Text"
             data-id="username"
             data-name="username"
             data-label="Tên đăng nhập"
             data-placeholder="username"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Account Info -->
    <div class="row">
        <div data-type="Select"
             data-id="role"
             data-name="role"
             data-label="Vai trò"
             data-wrapper-class="col-md-6"
             data-options='[
                {"value":"","text":"Chọn vai trò"},
                {"value":"super_admin","text":"Super Admin"},
                {"value":"admin","text":"Admin"},
                {"value":"moderator","text":"Moderator"},
                {"value":"support","text":"Support"}
             ]'
             data-required></div>
        <div data-type="Select"
             data-id="status"
             data-name="status"
             data-label="Trạng thái"
             data-wrapper-class="col-md-6"
             data-options='[
                {"value":"","text":"Chọn trạng thái"},
                {"value":"active","text":"Hoạt động"},
                {"value":"inactive","text":"Không hoạt động"},
                {"value":"pending","text":"Chờ xác thực"},
                {"value":"locked","text":"Bị khóa"}
             ]'
             data-required></div>
    </div>

    <!-- Password (for new accounts) -->
    <div class="row">
        <div data-type="Password"
             data-id="password"
             data-name="password"
             data-label="Mật khẩu"
             data-placeholder="Nhập mật khẩu"
             data-wrapper-class="col-md-6"
             data-required></div>
        <div data-type="Password"
             data-id="confirmPassword"
             data-name="confirmPassword"
             data-label="Xác nhận mật khẩu"
             data-placeholder="Nhập lại mật khẩu"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Permissions -->
    <div class="mb-3">
        <label class="form-label">Quyền hạn</label>
        <div class="row">
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Quản lý User" data-value="user_management" data-name="permissions[]" data-id="permUser"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Quản lý License" data-value="license_management" data-name="permissions[]" data-id="permLicense"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Báo cáo" data-value="reports" data-name="permissions[]" data-id="permReport"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Cài đặt hệ thống" data-value="system_settings" data-name="permissions[]" data-id="permSystem"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Nhật ký hệ thống" data-value="audit_logs" data-name="permissions[]" data-id="permAudit"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Sao lưu" data-value="backup" data-name="permissions[]" data-id="permBackup"></div>
            </div>
        </div>
    </div>

    <!-- Additional Info -->
    <div class="row">
        <div data-type="Select"
             data-id="department"
             data-name="department"
             data-label="Phòng ban"
             data-wrapper-class="col-md-6"
             data-options='[
                {"value":"","text":"Chọn phòng ban"},
                {"value":"it","text":"Công nghệ thông tin"},
                {"value":"hr","text":"Nhân sự"},
                {"value":"finance","text":"Tài chính"},
                {"value":"marketing","text":"Marketing"},
                {"value":"support","text":"Hỗ trợ khách hàng"}
             ]'></div>
        <div data-type="Select"
             data-id="manager"
             data-name="manager"
             data-label="Quản lý trực tiếp"
             data-wrapper-class="col-md-6"
             data-options='[
                {"value":"","text":"Chọn quản lý"},
                {"value":"1","text":"Nguyễn Văn A - CEO"},
                {"value":"2","text":"Trần Thị B - CTO"},
                {"value":"3","text":"Lê Minh C - Manager"}
             ]'></div>
    </div>

    <!-- Notes -->
    <div class="mb-3">
        <div data-type="Textarea"
             data-id="notes"
             data-name="notes"
             data-label="Ghi chú"
             data-placeholder="Ghi chú về tài khoản admin..."
             data-rows="3"
             data-maxlength="500"
             data-wrapper-class="col-md-12"></div>
        <div class="form-text">
            <span id="notesCount">0</span>/500 ký tự
        </div>
    </div>

    <!-- Switch -->
    <div class="mb-3">
        <div data-type="Switch" data-id="requirePasswordChange" data-name="requirePasswordChange" data-label="Yêu cầu đổi mật khẩu lần đăng nhập đầu"></div>
        <div data-type="Switch" data-id="twoFactorAuth" data-name="twoFactorAuth" data-label="Bật xác thực 2 bước"></div>
        <div data-type="Switch" data-id="sendWelcomeEmail" data-name="sendWelcomeEmail" data-label="Gửi email chào mừng" data-checked="true"></div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize form control binder
            window.formControlBinder.init('#adminForm');

            const form = document.getElementById('adminForm');
            const cancelBtn = document.getElementById('cancelBtn');
            const resetBtn = document.getElementById('resetBtn');
            const saveBtn = document.getElementById('saveBtn');
            const notesTextarea = document.getElementById('notes');
            const notesCount = document.getElementById('notesCount');
            const passwordField = document.getElementById('password');
            const confirmPasswordField = document.getElementById('confirmPassword');

            // Character count for notes
            notesTextarea.addEventListener('input', function() {
                const length = this.value.length;
                notesCount.textContent = length;
                
                if (length > 450) {
                    notesCount.style.color = '#ffc107';
                } else {
                    notesCount.style.color = '#6c757d';
                }
            });

            // Password validation
            function validatePassword() {
                const password = passwordField.value;
                const confirmPassword = confirmPasswordField.value;
                
                if (password.length > 0 && password.length < 8) {
                    passwordField.classList.add('is-invalid');
                    return false;
                }
                
                if (confirmPassword.length > 0 && password !== confirmPassword) {
                    confirmPasswordField.classList.add('is-invalid');
                    return false;
                }
                
                if (password.length >= 8) {
                    passwordField.classList.remove('is-invalid');
                    passwordField.classList.add('is-valid');
                }
                
                if (confirmPassword.length > 0 && password === confirmPassword) {
                    confirmPasswordField.classList.remove('is-invalid');
                    confirmPasswordField.classList.add('is-valid');
                }
                
                return true;
            }

            passwordField.addEventListener('input', validatePassword);
            confirmPasswordField.addEventListener('input', validatePassword);

            // Form validation
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                event.stopPropagation();
                
                let isFormValid = true;
                
                // Check required fields
                const requiredFields = form.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        isFormValid = false;
                        field.classList.add('is-invalid');
                    } else {
                        field.classList.remove('is-invalid');
                        field.classList.add('is-valid');
                    }
                });

                // Validate password
                if (!validatePassword()) {
                    isFormValid = false;
                }
                
                if (isFormValid) {
                    showNotification('✅ Admin validation thành công! Đang lưu...', 'success');
                    
                    // Simulate saving process
                    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
                    saveBtn.disabled = true;
                    
                    setTimeout(() => {
                        saveBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Lưu tài khoản';
                        saveBtn.disabled = false;
                        showNotification('💾 Tài khoản admin đã được lưu thành công!', 'success');
                        
                        // Close modal if in modal
                        const modalContainer = form.closest('.modal-container');
                        if (modalContainer) {
                            setTimeout(() => {
                                modalContainer.remove();
                            }, 1500);
                        }
                    }, 2000);
                } else {
                    showNotification('❌ Vui lòng kiểm tra lại các trường bắt buộc', 'error');
                }
                
                form.classList.add('was-validated');
            });

            // Reset button
            resetBtn.addEventListener('click', function() {
                form.classList.remove('was-validated');
                notesCount.textContent = '0';
                showNotification('🔄 Form đã được reset', 'info');
            });

            // Cancel button
            cancelBtn.addEventListener('click', function() {
                if (confirm('Bạn có chắc muốn hủy? Dữ liệu sẽ không được lưu.')) {
                    form.reset();
                    form.classList.remove('was-validated');
                    notesCount.textContent = '0';
                    showNotification('❌ Đã hủy thao tác', 'warning');
                    
                    // Close modal if form is in modal
                    const modalContainer = this.closest('.modal-container');
                    if (modalContainer) {
                        modalContainer.remove();
                    }
                }
            });
        });

        function showNotification(message, type = 'info') {
            const alertClass = type === 'error' ? 'alert-danger' : 
                              type === 'success' ? 'alert-success' : 
                              type === 'warning' ? 'alert-warning' : 'alert-info';
            
            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 350px; max-width: 500px;';
            notification.innerHTML = `
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="d-flex align-items-center">
                    ${message}
                </div>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 4000);
        }
    </script>
}
