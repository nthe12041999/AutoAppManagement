<!-- Modal Create Admin -->
<div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="createAdminModalLabel">
                    <i class="bi bi-person-plus me-2"></i>Thêm tài khoản quản trị
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="container-fluid p-4">
                    <div class="row">
                        <div class="col-lg-8">
                            <!-- Main Form Card -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-person-badge me-2"></i>Thông tin tài khoản
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <form id="adminCreateForm" 
                                          data-validate="true" 
                                          data-api-url="/AdminAccount/CreateAdmin"
                                          data-method="POST"
                                          data-confirm-submit="true"
                                          data-confirm-message="Bạn có chắc chắn muốn tạo admin này?"
                                          data-success-message="Tạo admin thành công!"
                                          data-redirect-url="/AdminAccount/Accounts">
                                        
                                        <div class="row">
                                            <!-- Họ và tên -->
                                            <div class="col-md-6 mb-3">
                                                <label for="fullName" class="form-label required">Họ và tên</label>
                                                <input type="text" 
                                                       class="form-control" 
                                                       id="fullName" 
                                                       name="FullName"
                                                       data-field="fullName"
                                                       data-validate="required|min:3|max:50"
                                                       data-validate-message="Họ và tên là bắt buộc và phải từ 3-50 ký tự"
                                                       placeholder="Nhập họ và tên">
                                                <div class="invalid-feedback"></div>
                                            </div>

                                            <!-- Email -->
                                            <div class="col-md-6 mb-3">
                                                <label for="email" class="form-label required">Email</label>
                                                <input type="email" 
                                                       class="form-control" 
                                                       id="email" 
                                                       name="Email"
                                                       data-field="email"
                                                       data-validate="required|email"
                                                       data-validate-message="Email không hợp lệ"
                                                       placeholder="admin@example.com">
                                                <div class="invalid-feedback"></div>
                                            </div>

                                            <!-- Số điện thoại -->
                                            <div class="col-md-6 mb-3">
                                                <label for="phone" class="form-label required">Số điện thoại</label>
                                                <input type="tel" 
                                                       class="form-control" 
                                                       id="phone" 
                                                       name="Phone"
                                                       data-field="phone"
                                                       data-validate="required|phone"
                                                       data-validate-message="Số điện thoại không hợp lệ"
                                                       placeholder="0123456789">
                                                <div class="invalid-feedback"></div>
                                            </div>

                                            <!-- Tên đăng nhập -->
                                            <div class="col-md-6 mb-3">
                                                <label for="username" class="form-label required">Tên đăng nhập</label>
                                                <input type="text" 
                                                       class="form-control" 
                                                       id="username" 
                                                       name="Username"
                                                       data-field="username"
                                                       data-validate="required|min:3|max:20|regex:^[a-zA-Z0-9_]+$"
                                                       data-validate-message="Tên đăng nhập phải từ 3-20 ký tự, chỉ chứa chữ, số và dấu gạch dưới"
                                                       placeholder="admin_user">
                                                <div class="invalid-feedback"></div>
                                            </div>

                                            <!-- Mật khẩu -->
                                            <div class="col-md-6 mb-3">
                                                <label for="password" class="form-label required">Mật khẩu</label>
                                                <div class="input-group">
                                                    <input type="password" 
                                                           class="form-control" 
                                                           id="password" 
                                                           name="Password"
                                                           data-field="password"
                                                           data-validate="required|min:6|max:50"
                                                           data-validate-message="Mật khẩu phải từ 6-50 ký tự"
                                                           placeholder="Nhập mật khẩu">
                                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('password')">
                                                        <i class="bi bi-eye" id="password-icon"></i>
                                                    </button>
                                                </div>
                                                <div class="invalid-feedback"></div>
                                            </div>

                                            <!-- Xác nhận mật khẩu -->
                                            <div class="col-md-6 mb-3">
                                                <label for="confirmPassword" class="form-label required">Xác nhận mật khẩu</label>
                                                <div class="input-group">
                                                    <input type="password" 
                                                           class="form-control" 
                                                           id="confirmPassword" 
                                                           name="ConfirmPassword"
                                                           data-field="confirmPassword"
                                                           data-validate="required|confirm:password"
                                                           data-validate-message="Mật khẩu xác nhận không khớp"
                                                           placeholder="Nhập lại mật khẩu">
                                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword')">
                                                        <i class="bi bi-eye" id="confirmPassword-icon"></i>
                                                    </button>
                                                </div>
                                                <div class="invalid-feedback"></div>
                                            </div>
                                        </div>

                                        <!-- Vai trò -->
                                        <div class="mb-3">
                                            <label class="form-label required">Vai trò</label>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="radio" 
                                                               name="Role" 
                                                               id="roleAdmin" 
                                                               value="Admin"
                                                               data-field="role"
                                                               data-validate="required"
                                                               data-validate-message="Vui lòng chọn vai trò">
                                                        <label class="form-check-label" for="roleAdmin">
                                                            <i class="bi bi-shield-check text-primary me-1"></i>Admin
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="radio" 
                                                               name="Role" 
                                                               id="roleModerator" 
                                                               value="Moderator">
                                                        <label class="form-check-label" for="roleModerator">
                                                            <i class="bi bi-person-gear text-info me-1"></i>Moderator
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="radio" 
                                                               name="Role" 
                                                               id="roleSupport" 
                                                               value="Support">
                                                        <label class="form-check-label" for="roleSupport">
                                                            <i class="bi bi-headset text-success me-1"></i>Support
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="invalid-feedback"></div>
                                        </div>

                                        <!-- Quyền hạn -->
                                        <div class="mb-3">
                                            <label class="form-label">Quyền hạn</label>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="checkbox" 
                                                               name="Permissions" 
                                                               value="user_management" 
                                                               id="permUserManagement">
                                                        <label class="form-check-label" for="permUserManagement">
                                                            <i class="bi bi-people me-1"></i>Quản lý người dùng
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="checkbox" 
                                                               name="Permissions" 
                                                               value="license_management" 
                                                               id="permLicenseManagement">
                                                        <label class="form-check-label" for="permLicenseManagement">
                                                            <i class="bi bi-key me-1"></i>Quản lý license
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="checkbox" 
                                                               name="Permissions" 
                                                               value="system_settings" 
                                                               id="permSystemSettings">
                                                        <label class="form-check-label" for="permSystemSettings">
                                                            <i class="bi bi-gear me-1"></i>Cài đặt hệ thống
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="checkbox" 
                                                               name="Permissions" 
                                                               value="reports" 
                                                               id="permReports">
                                                        <label class="form-check-label" for="permReports">
                                                            <i class="bi bi-graph-up me-1"></i>Báo cáo
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Trạng thái -->
                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" 
                                                       type="checkbox" 
                                                       name="IsActive" 
                                                       id="isActive" 
                                                       checked
                                                       data-field="isActive">
                                                <label class="form-check-label" for="isActive">
                                                    <i class="bi bi-toggle-on text-success me-1"></i>Kích hoạt tài khoản
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Ghi chú -->
                                        <div class="mb-3">
                                            <label for="bio" class="form-label">Ghi chú</label>
                                            <textarea class="form-control" 
                                                      id="bio" 
                                                      name="Bio"
                                                      data-field="bio"
                                                      data-validate="max:500"
                                                      data-validate-message="Ghi chú không được quá 500 ký tự"
                                                      rows="3" 
                                                      placeholder="Ghi chú về admin này..."></textarea>
                                            <div class="invalid-feedback"></div>
                                            <div class="form-text">Tối đa 500 ký tự</div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <!-- Form Status Panel -->
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-info-circle me-2"></i>Trạng thái Form
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div id="formStatus">
                                        <div class="d-flex align-items-center text-muted">
                                            <i class="bi bi-circle me-2"></i>
                                            <span>Chưa có thay đổi</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Validation Summary -->
                            <div class="card border-0 shadow-sm mb-3" id="validationSummaryCard" style="display: none;">
                                <div class="card-header bg-danger text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-exclamation-triangle me-2"></i>Lỗi Validation
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <ul id="validationSummary" class="list-unstyled mb-0"></ul>
                                </div>
                            </div>

                            <!-- Help Panel -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-question-circle me-2"></i>Hướng dẫn
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="small text-muted">
                                        <p class="mb-2"><strong>Tên đăng nhập:</strong> Chỉ chứa chữ, số và dấu gạch dưới</p>
                                        <p class="mb-2"><strong>Mật khẩu:</strong> Tối thiểu 6 ký tự</p>
                                        <p class="mb-2"><strong>Vai trò:</strong> Admin có quyền cao nhất</p>
                                        <p class="mb-0"><strong>Quyền hạn:</strong> Có thể chọn nhiều quyền</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Hủy
                </button>
                <button type="submit" form="adminCreateForm" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Tạo Admin
                </button>
            </div>
        </div>
    </div>
</div>
