<!-- Modal Admin (Create/Edit/View) -->
<div class="modal fade" id="adminModal" tabindex="-1" aria-labelledby="adminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="adminModalLabel">
                    <i class="bi bi-person-plus me-2" id="adminModalIcon"></i>
                    <span id="adminModalTitle">Thêm tài khoản quản trị</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="container-fluid p-4">
                    <div class="row">
                        <div class="col-lg-8">
                            <!-- Main Form Card -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-person-badge me-2"></i>Thông tin tài khoản
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <form id="adminForm" 
                                          data-validate="true" 
                                          data-api-url=""
                                          data-method="POST"
                                          data-confirm-submit="true"
                                          data-confirm-message=""
                                          data-success-message=""
                                          data-redirect-url="/AdminAccount/Accounts">

                                        <!-- Hidden fields for mode and ID -->
                                        <input type="hidden" id="adminId" name="Id" value="" />
                                        <input type="hidden" id="adminMode" name="Mode" value="create" />

                                        <div class="row g-3">
                                            <!-- Họ và tên -->
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <input type="text" 
                                                           class="form-control" 
                                                           id="fullName" 
                                                           name="FullName"
                                                           placeholder="Nhập họ và tên"
                                                           data-validate="required|min:3|max:50"
                                                           data-validate-message="Họ và tên là bắt buộc và phải từ 3-50 ký tự">
                                                    <label for="fullName">
                                                        <i class="bi bi-person me-1"></i>Họ và tên *
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Email -->
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <input type="email" 
                                                           class="form-control" 
                                                           id="email" 
                                                           name="Email"
                                                           placeholder="Nhập email"
                                                           data-validate="required|email"
                                                           data-validate-message="Email là bắt buộc và phải đúng định dạng">
                                                    <label for="email">
                                                        <i class="bi bi-envelope me-1"></i>Email *
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Số điện thoại -->
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <input type="tel" 
                                                           class="form-control" 
                                                           id="phoneNumber" 
                                                           name="PhoneNumber"
                                                           placeholder="Nhập số điện thoại"
                                                           data-validate="required|phone"
                                                           data-validate-message="Số điện thoại là bắt buộc và phải đúng định dạng">
                                                    <label for="phoneNumber">
                                                        <i class="bi bi-telephone me-1"></i>Số điện thoại *
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Tên đăng nhập -->
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <input type="text" 
                                                           class="form-control" 
                                                           id="userName" 
                                                           name="UserName"
                                                           placeholder="Nhập tên đăng nhập"
                                                           data-validate="required|min:3|max:20|regex:^[a-zA-Z0-9_]+$"
                                                           data-validate-message="Tên đăng nhập là bắt buộc, 3-20 ký tự, chỉ chứa chữ, số và dấu gạch dưới">
                                                    <label for="userName">
                                                        <i class="bi bi-person-circle me-1"></i>Tên đăng nhập *
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Mật khẩu (chỉ hiển thị khi Create) -->
                                            <div class="col-md-6" id="passwordField">
                                                <div class="form-floating">
                                                    <input type="password" 
                                                           class="form-control" 
                                                           id="password" 
                                                           name="Password"
                                                           placeholder="Nhập mật khẩu"
                                                           data-validate="required|min:6|max:50"
                                                           data-validate-message="Mật khẩu là bắt buộc và phải từ 6-50 ký tự">
                                                    <label for="password">
                                                        <i class="bi bi-lock me-1"></i>Mật khẩu *
                                                    </label>
                                                    <button type="button" 
                                                            class="btn btn-outline-secondary position-absolute end-0 top-50 translate-middle-y me-3 border-0"
                                                            onclick="togglePassword('password')"
                                                            style="z-index: 10;">
                                                        <i class="bi bi-eye" id="password-icon"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Xác nhận mật khẩu (chỉ hiển thị khi Create) -->
                                            <div class="col-md-6" id="confirmPasswordField">
                                                <div class="form-floating">
                                                    <input type="password" 
                                                           class="form-control" 
                                                           id="confirmPassword" 
                                                           name="ConfirmPassword"
                                                           placeholder="Xác nhận mật khẩu"
                                                           data-validate="required|confirm:password"
                                                           data-validate-message="Xác nhận mật khẩu là bắt buộc và phải khớp với mật khẩu">
                                                    <label for="confirmPassword">
                                                        <i class="bi bi-lock-fill me-1"></i>Xác nhận mật khẩu *
                                                    </label>
                                                    <button type="button" 
                                                            class="btn btn-outline-secondary position-absolute end-0 top-50 translate-middle-y me-3 border-0"
                                                            onclick="togglePassword('confirmPassword')"
                                                            style="z-index: 10;">
                                                        <i class="bi bi-eye" id="confirmPassword-icon"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Vai trò -->
                                            <div class="col-12">
                                                <label class="form-label fw-bold">
                                                    <i class="bi bi-shield-check me-1"></i>Vai trò *
                                                </label>
                                                <div class="row g-2">
                                                    <div class="col-md-4">
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" 
                                                                   type="radio" 
                                                                   name="Role" 
                                                                   id="roleAdmin" 
                                                                   value="admin"
                                                                   data-validate="required"
                                                                   data-validate-message="Vui lòng chọn vai trò">
                                                            <label class="form-check-label" for="roleAdmin">
                                                                <i class="bi bi-person-gear me-1"></i>Admin
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" 
                                                                   type="radio" 
                                                                   name="Role" 
                                                                   id="roleModerator" 
                                                                   value="moderator">
                                                            <label class="form-check-label" for="roleModerator">
                                                                <i class="bi bi-person-check me-1"></i>Moderator
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="form-check form-check-inline">
                                                            <input class="form-check-input" 
                                                                   type="radio" 
                                                                   name="Role" 
                                                                   id="roleSupport" 
                                                                   value="support">
                                                            <label class="form-check-label" for="roleSupport">
                                                                <i class="bi bi-headset me-1"></i>Support
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Quyền hạn -->
                                            <div class="col-12">
                                                <label class="form-label fw-bold">
                                                    <i class="bi bi-key me-1"></i>Quyền hạn
                                                </label>
                                                <div class="row g-2">
                                                    <div class="col-md-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input" 
                                                                   type="checkbox" 
                                                                   name="Permissions" 
                                                                   id="permissionUsers" 
                                                                   value="manage_users">
                                                            <label class="form-check-label" for="permissionUsers">
                                                                <i class="bi bi-people me-1"></i>Quản lý người dùng
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input" 
                                                                   type="checkbox" 
                                                                   name="Permissions" 
                                                                   id="permissionProducts" 
                                                                   value="manage_products">
                                                            <label class="form-check-label" for="permissionProducts">
                                                                <i class="bi bi-box me-1"></i>Quản lý sản phẩm
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input" 
                                                                   type="checkbox" 
                                                                   name="Permissions" 
                                                                   id="permissionOrders" 
                                                                   value="manage_orders">
                                                            <label class="form-check-label" for="permissionOrders">
                                                                <i class="bi bi-cart me-1"></i>Quản lý đơn hàng
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-check">
                                                            <input class="form-check-input" 
                                                                   type="checkbox" 
                                                                   name="Permissions" 
                                                                   id="permissionReports" 
                                                                   value="view_reports">
                                                            <label class="form-check-label" for="permissionReports">
                                                                <i class="bi bi-graph-up me-1"></i>Xem báo cáo
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Trạng thái -->
                                            <div class="col-12">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           role="switch" 
                                                           id="isActive" 
                                                           name="IsActive"
                                                           checked>
                                                    <label class="form-check-label fw-bold" for="isActive">
                                                        <i class="bi bi-toggle-on me-1"></i>Kích hoạt tài khoản
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Ghi chú -->
                                            <div class="col-12">
                                                <div class="form-floating">
                                                    <textarea class="form-control" 
                                                              id="notes" 
                                                              name="Notes"
                                                              placeholder="Nhập ghi chú"
                                                              style="height: 100px"
                                                              data-validate="max:500"
                                                              data-validate-message="Ghi chú không được vượt quá 500 ký tự"></textarea>
                                                    <label for="notes">
                                                        <i class="bi bi-chat-text me-1"></i>Ghi chú
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <!-- Validation Summary Card -->
                            <div class="card border-warning" id="validationSummaryCard" style="display: none;">
                                <div class="card-header bg-warning text-dark">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-exclamation-triangle me-2"></i>Lỗi xác thực
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <ul class="list-unstyled mb-0" id="validationSummary">
                                        <!-- Validation errors will be populated here -->
                                    </ul>
                                </div>
                            </div>

                            <!-- Form Status Card -->
                            <div class="card border-info mt-3">
                                <div class="card-header bg-info text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-info-circle me-2"></i>Trạng thái form
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div id="formStatus">
                                        <div class="d-flex align-items-center text-muted">
                                            <i class="bi bi-circle me-2"></i>
                                            <span>Chưa có thay đổi</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Help Card -->
                            <div class="card border-secondary mt-3">
                                <div class="card-header bg-secondary text-white">
                                    <h6 class="card-title mb-0">
                                        <i class="bi bi-question-circle me-2"></i>Hướng dẫn
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="small text-muted">
                                        <p class="mb-2"><strong>Lưu ý:</strong></p>
                                        <ul class="mb-0">
                                            <li>Các trường có dấu (*) là bắt buộc</li>
                                            <li>Mật khẩu phải có ít nhất 6 ký tự</li>
                                            <li>Tên đăng nhập chỉ chứa chữ, số và dấu gạch dưới</li>
                                            <li>Email phải đúng định dạng</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Hủy
                </button>
                <button type="submit" form="adminForm" class="btn btn-primary" id="submitButton">
                    <i class="bi bi-check-circle me-1"></i>
                    <span id="submitButtonText">Tạo Admin</span>
                </button>
            </div>
        </div>
    </div>
</div>
