@{
    ViewData["Title"] = "Thêm Admin";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Thêm Admin</h1>
            <p class="text-muted mb-0">Tạo tài khoản quản trị viên mới</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Accounts", "AdminAccount")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Main Form Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-person-plus me-2"></i>Thông tin Admin
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Form using FormMixin -->
                    <form id="adminCreateForm" 
                          data-validate
                          data-api-url="@Url.Action("CreateAdmin", "AdminAccount")" 
                          data-method="POST"
                          data-redirect-success="@Url.Action("Accounts", "AdminAccount")"
                          data-confirm-before-submit="true">
                        
                        <div class="row">
                            <!-- Full Name -->
                            <div class="col-md-6 mb-3">
                                <label for="fullName" class="form-label">
                                    Họ và tên <span class="text-danger">*</span>
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="fullName" 
                                       name="fullName"
                                       data-field="fullName"
                                       placeholder="Nhập họ và tên"
                                       data-validate="required|min:3|max:50"
                                       data-message="Họ tên là bắt buộc, từ 3-50 ký tự">
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label">
                                    Email <span class="text-danger">*</span>
                                </label>
                                <input type="email" 
                                       class="form-control" 
                                       id="email" 
                                       name="email"
                                       data-field="email"
                                       placeholder="admin@example.com"
                                       data-validate="required|email"
                                       data-message="Email hợp lệ là bắt buộc">
                            </div>
                        </div>

                        <div class="row">
                            <!-- Phone -->
                            <div class="col-md-6 mb-3">
                                <label for="phone" class="form-label">
                                    Số điện thoại <span class="text-danger">*</span>
                                </label>
                                <input type="tel" 
                                       class="form-control" 
                                       id="phone" 
                                       name="phone"
                                       data-field="phone"
                                       placeholder="0987654321"
                                       data-validate="required|phone"
                                       data-message="Số điện thoại Việt Nam hợp lệ là bắt buộc">
                            </div>

                            <!-- Username -->
                            <div class="col-md-6 mb-3">
                                <label for="username" class="form-label">
                                    Tên đăng nhập <span class="text-danger">*</span>
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="username" 
                                       name="username"
                                       data-field="username"
                                       placeholder="admin_user"
                                       data-validate="required|min:3|max:20"
                                       data-pattern="^[a-zA-Z0-9_]+$"
                                       data-message="Tên đăng nhập chỉ chứa chữ, số và dấu gạch dưới">
                            </div>
                        </div>

                        <div class="row">
                            <!-- Password -->
                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label">
                                    Mật khẩu <span class="text-danger">*</span>
                                </label>
                                <input type="password" 
                                       class="form-control" 
                                       id="password" 
                                       name="password"
                                       data-field="password"
                                       placeholder="Nhập mật khẩu"
                                       data-validate="required|min:6|max:50"
                                       data-message="Mật khẩu tối thiểu 6 ký tự">
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6 mb-3">
                                <label for="confirmPassword" class="form-label">
                                    Xác nhận mật khẩu <span class="text-danger">*</span>
                                </label>
                                <input type="password" 
                                       class="form-control" 
                                       id="confirmPassword" 
                                       name="confirmPassword"
                                       data-field="confirmPassword"
                                       placeholder="Nhập lại mật khẩu"
                                       data-validate="required|confirm:password"
                                       data-message="Xác nhận mật khẩu phải khớp">
                            </div>
                        </div>

                        <!-- Role Selection -->
                        <div class="mb-3">
                            <label class="form-label">
                                Vai trò <span class="text-danger">*</span>
                            </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="radio" 
                                               name="role" 
                                               id="roleAdmin" 
                                               value="Admin"
                                               data-field="role"
                                               data-validate="required"
                                               data-message="Vui lòng chọn vai trò">
                                        <label class="form-check-label" for="roleAdmin">
                                            <i class="bi bi-shield-check text-primary me-1"></i>Admin
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="radio" 
                                               name="role" 
                                               id="roleModerator" 
                                               value="Moderator"
                                               data-field="role">
                                        <label class="form-check-label" for="roleModerator">
                                            <i class="bi bi-shield text-warning me-1"></i>Moderator
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="radio" 
                                               name="role" 
                                               id="roleSupport" 
                                               value="Support"
                                               data-field="role">
                                        <label class="form-check-label" for="roleSupport">
                                            <i class="bi bi-headset text-info me-1"></i>Support
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="radio" 
                                               name="role" 
                                               id="roleEditor" 
                                               value="Editor"
                                               data-field="role">
                                        <label class="form-check-label" for="roleEditor">
                                            <i class="bi bi-pencil text-secondary me-1"></i>Editor
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Permissions -->
                        <div class="mb-3">
                            <label class="form-label">Quyền hạn</label>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               name="permissions" 
                                               id="permUserManagement" 
                                               value="UserManagement"
                                               data-field="permissions">
                                        <label class="form-check-label" for="permUserManagement">
                                            <i class="bi bi-people me-1"></i>Quản lý người dùng
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               name="permissions" 
                                               id="permContentManagement" 
                                               value="ContentManagement"
                                               data-field="permissions">
                                        <label class="form-check-label" for="permContentManagement">
                                            <i class="bi bi-file-text me-1"></i>Quản lý nội dung
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               name="permissions" 
                                               id="permOrderManagement" 
                                               value="OrderManagement"
                                               data-field="permissions">
                                        <label class="form-check-label" for="permOrderManagement">
                                            <i class="bi bi-cart me-1"></i>Quản lý đơn hàng
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               name="permissions" 
                                               id="permSystemSettings" 
                                               value="SystemSettings"
                                               data-field="permissions">
                                        <label class="form-check-label" for="permSystemSettings">
                                            <i class="bi bi-gear me-1"></i>Cài đặt hệ thống
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               name="permissions" 
                                               id="permReports" 
                                               value="Reports"
                                               data-field="permissions">
                                        <label class="form-check-label" for="permReports">
                                            <i class="bi bi-graph-up me-1"></i>Báo cáo thống kê
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               name="permissions" 
                                               id="permFinancial" 
                                               value="Financial"
                                               data-field="permissions">
                                        <label class="form-check-label" for="permFinancial">
                                            <i class="bi bi-currency-dollar me-1"></i>Quản lý tài chính
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       id="isActive" 
                                       name="isActive"
                                       data-field="isActive"
                                       checked>
                                <label class="form-check-label" for="isActive">
                                    <i class="bi bi-check-circle me-1"></i>Kích hoạt tài khoản
                                </label>
                            </div>
                        </div>

                        <!-- Bio/Notes -->
                        <div class="mb-3">
                            <label for="bio" class="form-label">Ghi chú</label>
                            <textarea class="form-control" 
                                      id="bio" 
                                      name="bio" 
                                      data-field="bio"
                                      rows="3"
                                      placeholder="Thông tin bổ sung về admin..."
                                      data-validate="max:500"
                                      data-message="Ghi chú không được quá 500 ký tự"></textarea>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" data-action="reset" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise me-1"></i>Đặt lại
                            </button>
                            <button type="button" data-action="cancel" class="btn btn-outline-danger">
                                <i class="bi bi-x-lg me-1"></i>Hủy
                            </button>
                            <button type="submit" data-action="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Lưu Admin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Form Status -->
            <div class="card">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Trạng thái Form
                    </h6>
                </div>
                <div class="card-body">
                    <div id="formStatus">
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-circle me-2"></i>
                            <span>Chưa có thay đổi</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Validation Summary -->
            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Lỗi Validation
                    </h6>
                </div>
                <div class="card-body">
                    <div id="validationSummary" class="d-none">
                        <ul class="list-unstyled mb-0" id="validationErrors"></ul>
                    </div>
                    <div id="noErrors" class="text-muted small">
                        <i class="bi bi-check-circle me-1"></i>Không có lỗi
                    </div>
                </div>
            </div>

            <!-- Help -->
            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="card-title mb-0">
                        <i class="bi bi-question-circle me-2"></i>Hướng dẫn
                    </h6>
                </div>
                <div class="card-body">
                    <div class="small">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <i class="bi bi-dot"></i>
                                Các trường có dấu <span class="text-danger">*</span> là bắt buộc
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-dot"></i>
                                Mật khẩu tối thiểu 6 ký tự
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-dot"></i>
                                Tên đăng nhập chỉ chứa chữ, số và dấu gạch dưới
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-dot"></i>
                                Email phải đúng định dạng
                            </li>
                            <li>
                                <i class="bi bi-dot"></i>
                                Số điện thoại theo định dạng Việt Nam
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Import Form Mixins -->
    <script src="~/js/mixins/form.mixin.js"></script>
    
    <!-- SweetAlert2 for notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function() {
            console.log('🚀 Admin Create Form loaded');
            
            // Initialize form with FormMixin
            const adminForm = new FormMixin('#adminCreateForm', {
                autoValidate: true,
                showValidationSummary: true,
                trackChanges: true,
                confirmBeforeSubmit: true,
                apiUrl: '@Url.Action("CreateAdmin", "AdminAccount")',
                method: 'POST'
            });

            // Custom form event handlers
            adminForm.onSubmitSuccess = function(response) {
                console.log('✅ Admin created successfully:', response);
                
                Swal.fire({
                    title: 'Thành công!',
                    text: 'Admin đã được tạo thành công',
                    icon: 'success',
                    confirmButtonText: 'OK'
                }).then(() => {
                    window.location.href = '@Url.Action("Accounts", "AdminAccount")';
                });
            };

            adminForm.onSubmitError = function(error) {
                console.error('❌ Error creating admin:', error);
                
                Swal.fire({
                    title: 'Lỗi!',
                    text: error.message || 'Có lỗi xảy ra khi tạo admin',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            };

            adminForm.onValidationChange = function(isValid, errors) {
                updateValidationSummary(isValid, errors);
            };

            adminForm.onFormChange = function(hasChanges) {
                updateFormStatus(hasChanges);
            };

            // Update validation summary
            function updateValidationSummary(isValid, errors) {
                const $summary = $('#validationSummary');
                const $noErrors = $('#noErrors');
                const $errorsList = $('#validationErrors');

                if (isValid || Object.keys(errors).length === 0) {
                    $summary.addClass('d-none');
                    $noErrors.removeClass('d-none');
                } else {
                    $summary.removeClass('d-none');
                    $noErrors.addClass('d-none');
                    
                    $errorsList.empty();
                    Object.values(errors).forEach(error => {
                        $errorsList.append(`<li class="text-danger small"><i class="bi bi-x-circle me-1"></i>${error}</li>`);
                    });
                }
            }

            // Update form status
            function updateFormStatus(hasChanges) {
                const $status = $('#formStatus');
                
                if (hasChanges) {
                    $status.html(`
                        <div class="d-flex align-items-center text-warning">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <span>Form có thay đổi</span>
                        </div>
                    `);
                } else {
                    $status.html(`
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-circle me-2"></i>
                            <span>Chưa có thay đổi</span>
                        </div>
                    `);
                }
            }
        });
    </script>
}
