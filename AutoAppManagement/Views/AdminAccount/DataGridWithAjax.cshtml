@using AutoAppManagement.Helpers
@using AutoAppManagement.Models.Enums
@using AutoAppManagement.Models
@{
    ViewData["Title"] = "DataGrid với Ajax";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="bi bi-cloud-download me-2 text-primary"></i>DataGrid với Ajax
            </h1>
            <p class="text-muted mb-0">Sử dụng jQuery để call API và bind data động</p>
        </div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Accounts", "AdminAccount")">Admin</a></li>
                <li class="breadcrumb-item active">DataGrid Ajax</li>
            </ol>
        </nav>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4" id="statsCards">
        <div class="col-md-3">
            <div class="card border-0 bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Tổng Admin</h6>
                            <h3 class="mb-0" id="totalAdmins">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                            </h3>
                        </div>
                        <i class="bi bi-people-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Đang hoạt động</h6>
                            <h3 class="mb-0" id="activeAdmins">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                            </h3>
                        </div>
                        <i class="bi bi-check-circle-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Online</h6>
                            <h3 class="mb-0" id="onlineAdmins">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                            </h3>
                        </div>
                        <i class="bi bi-circle-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Trang hiện tại</h6>
                            <h3 class="mb-0" id="currentPageInfo">1 / 1</h3>
                        </div>
                        <i class="bi bi-file-earmark-text fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-4" data-component="filter" data-target="adminTable">
        <div class="card-header" data-section="filter-header">
            <h5 class="card-title mb-0" data-element="filter-title">
                <i class="bi bi-funnel me-2" data-element="filter-icon"></i>Bộ lọc và Tìm kiếm
            </h5>
        </div>
        <div class="card-body" data-section="filter-body">
            <div class="row g-3" data-layout="filter-form">
                <div class="col-md-3" data-field="search">
                    <div class="form-floating" data-element="search-wrapper">
                        <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm..."
                               data-filter="search" data-field="global" data-trigger="enter">
                        <label for="searchInput" data-element="search-label">
                            <i class="bi bi-search me-2"></i>Tìm kiếm
                        </label>
                    </div>
                </div>
                <div class="col-md-2" data-field="role">
                    <select class="form-select" id="roleFilter" data-filter="role" data-field="role" data-trigger="change">
                        <option value="" data-value="">Tất cả vai trò</option>
                        <option value="Super Admin" data-value="Super Admin">Super Admin</option>
                        <option value="Admin" data-value="Admin">Admin</option>
                        <option value="Moderator" data-value="Moderator">Moderator</option>
                        <option value="Support" data-value="Support">Support</option>
                        <option value="Editor" data-value="Editor">Editor</option>
                    </select>
                </div>
                <div class="col-md-2" data-field="status">
                    <select class="form-select" id="statusFilter" data-filter="status" data-field="status" data-trigger="change">
                        <option value="" data-value="">Tất cả trạng thái</option>
                        <option value="Hoạt động" data-value="active">Hoạt động</option>
                        <option value="Không hoạt động" data-value="inactive">Không hoạt động</option>
                    </select>
                </div>
                <div class="col-md-2" data-field="pageSize">
                    <select class="form-select" id="pageSizeSelect" data-filter="pageSize" data-field="pageSize" data-trigger="change">
                        <option value="5" data-value="5">5 / trang</option>
                        <option value="10" selected data-value="10">10 / trang</option>
                        <option value="25" data-value="25">25 / trang</option>
                        <option value="50" data-value="50">50 / trang</option>
                    </select>
                </div>
                <div class="col-md-3" data-section="filter-actions">
                    <div class="d-flex gap-2" data-layout="action-buttons">
                        <button type="button" class="btn btn-primary" id="searchBtn"
                                data-action="search" data-target="adminTable" data-trigger="click">
                            <i class="bi bi-search me-1"></i>Tìm kiếm
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="resetBtn"
                                data-action="reset" data-target="filters" data-trigger="click">
                            <i class="bi bi-arrow-clockwise me-1"></i>Reset
                        </button>
                        <button type="button" class="btn btn-success" id="addBtn"
                                data-action="add" data-target="modal" data-entity="admin">
                            <i class="bi bi-plus-lg me-1"></i>Thêm Admin
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DataGrid -->
    <div class="card" data-component="datagrid"
         data-table-id="adminTable"
         data-get-url="@Url.Action("GetAdminDataAjax", "AdminAccount")"
         data-base-url="/AdminAccount"
         data-entity="admin"
         data-page-size="10"
         data-auto-load="true"
         data-has-paging="true"
         data-title="Danh sách Admin (Ajax)"
         data-title-icon="bi bi-database"
         data-has-export="true"
         data-has-refresh="true"
         data-columns='[
             {"field":"","type":"@DataGridColumnType.Checkbox","title":"","width":"50","sortable":false},
             {"field":"@nameof(Account.FullName)","type":"@DataGridColumnType.User","title":"Thông tin Admin"},
             {"field":"@nameof(Account.Email)","type":"@DataGridColumnType.Email","title":"Email"},
             {"field":"@nameof(Account.Role)","type":"@DataGridColumnType.Badge","title":"Vai trò","width":"120"},
             {"field":"@nameof(Account.Status)","type":"@DataGridColumnType.Badge","title":"Trạng thái","width":"120"},
             {"field":"@nameof(Account.LastLogin)","type":"@DataGridColumnType.DateTime","title":"Lần đăng nhập cuối","width":"180"},
             {"field":"","type":"@DataGridColumnType.Actions","title":"Thao tác","width":"150","sortable":false}
         ]'>

        <!-- Header will be auto-generated by DataGrid -->

        <!-- Table will be auto-generated by DataGrid from data-columns attribute -->

        <!-- Pagination will be auto-generated by DataGrid when data-has-paging="true" -->
    </div>



<!-- Product Catalog style checkboxes -->
<style>
    .table input[type="checkbox"].form-check-input {
        width: 16px !important;
        height: 16px !important;
        border: 1px solid var(--bs-border-color) !important;
        border-radius: 3px !important;
        background: var(--bs-body-bg) !important;
        transition: all 0.2s ease-in-out !important;
        margin: 0 !important;
        appearance: none !important;
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        background-size: contain !important;
        background-repeat: no-repeat !important;
        background-position: center !important;
        position: relative !important;
        z-index: 1 !important;
    }

    .table input[type="checkbox"].form-check-input::before,
    .table input[type="checkbox"].form-check-input::after {
        display: none !important;
        content: none !important;
    }

    .table input[type="checkbox"].form-check-input:checked {
        background-color: var(--bs-primary) !important;
        border-color: var(--bs-primary) !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/%3e%3c/svg%3e") !important;
    }

    .table input[type="checkbox"].form-check-input:focus {
        box-shadow: 0 0 0 0.2rem rgba(var(--bs-primary-rgb), 0.25) !important;
        border-color: var(--bs-primary) !important;
        outline: none !important;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
</style>

@section Scripts {
    <!-- Import Mixins -->
    <script src="~/js/mixins/datagrid.mixin.js"></script>
    <script src="~/js/mixins/filter.mixin.js"></script>
    <script src="~/js/mixins/modal.mixin.js"></script>

    <!-- Page-specific Script -->
    <script src="~/js/pages/admin-datagrid.js"></script>
}
