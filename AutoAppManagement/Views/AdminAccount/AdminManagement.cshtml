@{
    ViewData["Title"] = "Quản lý Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Quản lý Admin</h1>
            <p class="mb-0 text-muted">Quản lý tài khoản quản trị viên hệ thống</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary" onclick="window.adminModal?.showCreateModal()">
                <i class="bi bi-plus-circle me-2"></i>Thêm Admin
            </button>
        </div>
    </div>

    <!-- Statistics Cards - Sử dụng admin template -->
    <div id="adminStatistics" data-component="statistics" data-template="admin">
        <!-- Cards sẽ được tự động tạo bởi StatisticsCards component -->
    </div>

    <!-- Admin DataGrid -->
    <div class="card shadow">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách Admin</h6>
        </div>
        <div class="card-body">
            <!-- DataGrid sẽ được render ở đây -->
            <div id="adminTable"></div>
        </div>
    </div>
</div>

<!-- Include required scripts -->
<script src="~/js/components/statistics-cards.js"></script>
<script src="~/js/components/datagrid.js"></script>
<script src="~/js/pages/admin-datagrid.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('🚀 Initializing Admin Management Page...');
    
    // Initialize Admin DataGrid
    window.adminTableGrid = new AdminDataGrid();
    
    // Configure DataGrid
    window.adminTableGrid.configure({
        apiUrl: '/AdminAccount/GetAdminAccounts',
        tableId: 'adminTable',
        columns: [
            { data: 'Id', title: 'ID', visible: false },
            { data: 'Username', title: 'Tên đăng nhập', searchable: true },
            { data: 'Email', title: 'Email', searchable: true },
            { data: 'FullName', title: 'Họ tên', searchable: true },
            { data: 'Role', title: 'Vai trò' },
            { data: 'Status', title: 'Trạng thái' },
            { data: 'IsEmailVerified', title: 'Xác thực Email', render: function(data) {
                return data ? '<span class="badge bg-success">Đã xác thực</span>' : '<span class="badge bg-warning">Chưa xác thực</span>';
            }},
            { data: 'OnlineStatus', title: 'Trạng thái online', render: function(data) {
                const statusClass = data === 'Online' ? 'success' : 'secondary';
                return `<span class="badge bg-${statusClass}">${data === 'Online' ? 'Trực tuyến' : 'Ngoại tuyến'}</span>`;
            }},
            { data: 'LastLoginDate', title: 'Lần đăng nhập cuối', render: function(data) {
                return data ? new Date(data).toLocaleString('vi-VN') : 'Chưa đăng nhập';
            }},
            { data: 'CreatedDate', title: 'Ngày tạo', render: function(data) {
                return new Date(data).toLocaleString('vi-VN');
            }}
        ],
        pageLength: 25,
        order: [[9, 'desc']], // Sort by CreatedDate desc
        responsive: true,
        searchDelay: 500
    });
    
    // Load data
    window.adminTableGrid.loadData();
    
    console.log('✅ Admin Management Page initialized');
});
</script>

<style>
/* Custom styles for admin management */
.stats-card {
    transition: transform 0.2s ease-in-out;
}

.stats-card:hover {
    transform: translateY(-2px);
}

.badge {
    font-size: 0.75em;
}

.table th {
    background-color: #f8f9fa;
    font-weight: 600;
}

.btn-group-sm > .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
}
</style>
