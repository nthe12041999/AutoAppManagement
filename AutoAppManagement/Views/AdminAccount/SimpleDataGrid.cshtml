@using AutoAppManagement.Models.Components
@{
    ViewData["Title"] = "Simple DataGrid Example";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Get data from ViewBag
    var users = ViewBag.UserData as List<dynamic> ?? new List<dynamic>
    {
        new { Id = 1, Name = "John Doe", Email = "john@example.com", Role = "Admin", Status = "Active", Salary = 5000.50, CreatedDate = DateTime.Now.AddDays(-10) },
        new { Id = 2, Name = "Jane Smith", Email = "jane@example.com", Role = "User", Status = "Inactive", Salary = 3000.75, CreatedDate = DateTime.Now.AddDays(-5) },
        new { Id = 3, Name = "Bob Johnson", Email = "bob@example.com", Role = "Moderator", Status = "Active", Salary = 4000.00, CreatedDate = DateTime.Now.AddDays(-2) }
    };

    // Simple DataGrid configuration
    var simpleGrid = new DataGridModel
    {
        TableId = "userTable",
        Title = "User Management",
        TitleIcon = "bi bi-people",
        Data = users,
        TotalRecords = users.Count,
        
        // Features
        ShowCheckbox = true,
        ShowActions = true,
        ShowPagination = false,
        ShowExport = true,
        ShowRefresh = true,
        
        // Columns
        Columns = new List<DataGridColumn>
        {
            new DataGridColumn 
            { 
                Title = "Name", 
                BindingField = "Name", 
                Type = "text",
                Width = 200
            },
            new DataGridColumn 
            { 
                Title = "Email", 
                BindingField = "Email", 
                Type = "text" 
            },
            new DataGridColumn 
            { 
                Title = "Role", 
                BindingField = "Role", 
                Type = "badge",
                Width = 100
            },
            new DataGridColumn 
            { 
                Title = "Status", 
                BindingField = "Status", 
                Type = "badge",
                Width = 100
            },
            new DataGridColumn 
            { 
                Title = "Salary", 
                BindingField = "Salary", 
                Type = "currency",
                Width = 120
            },
            new DataGridColumn 
            { 
                Title = "Created Date", 
                BindingField = "CreatedDate", 
                Type = "date",
                Width = 150
            }
        },
        
        // Actions
        ActionButtons = new List<DataGridAction>
        {
            new DataGridAction 
            { 
                Title = "View", 
                Icon = "bi bi-eye", 
                CssClass = "btn-outline-primary", 
                Action = "viewUser" 
            },
            new DataGridAction 
            { 
                Title = "Edit", 
                Icon = "bi bi-pencil", 
                CssClass = "btn-outline-warning", 
                Action = "editUser" 
            },
            new DataGridAction 
            { 
                Title = "Delete", 
                Icon = "bi bi-trash", 
                CssClass = "btn-outline-danger", 
                Action = "deleteUser" 
            }
        }
    };

    // Product Grid Example
    var products = ViewBag.ProductData as List<dynamic> ?? new List<dynamic>
    {
        new { Id = 1, Name = "Laptop Dell", Category = "Electronics", Price = 999.99, Stock = 50, Status = "In Stock" },
        new { Id = 2, Name = "iPhone 15", Category = "Mobile", Price = 1299.00, Stock = 0, Status = "Out of Stock" },
        new { Id = 3, Name = "Samsung TV", Category = "Electronics", Price = 799.50, Stock = 25, Status = "Low Stock" }
    };

    var productGrid = new DataGridModel
    {
        TableId = "productTable",
        Title = "Product Catalog",
        TitleIcon = "bi bi-box",
        Data = products,
        TotalRecords = products.Count,
        ShowCheckbox = true,
        ShowActions = true,
        ShowPagination = false,
        ShowExport = false,
        ShowRefresh = true,
        Columns = new List<DataGridColumn>
        {
            new DataGridColumn { Title = "Product Name", BindingField = "Name", Type = "text" },
            new DataGridColumn { Title = "Category", BindingField = "Category", Type = "badge" },
            new DataGridColumn { Title = "Price", BindingField = "Price", Type = "currency", Width = 100 },
            new DataGridColumn { Title = "Stock", BindingField = "Stock", Type = "text", Width = 80 },
            new DataGridColumn { Title = "Status", BindingField = "Status", Type = "badge", Width = 120 }
        },
        ActionButtons = new List<DataGridAction>
        {
            new DataGridAction { Title = "Edit", Icon = "bi bi-pencil", CssClass = "btn-outline-primary", Action = "editProduct" },
            new DataGridAction { Title = "Delete", Icon = "bi bi-trash", CssClass = "btn-outline-danger", Action = "deleteProduct" }
        }
    };
}

<div class="container-fluid">
    <h1 class="h3 mb-4">Simple DataGrid Examples</h1>
    
    <!-- User Grid -->
    <div class="mb-5">
        <h4>User Management Grid</h4>
        @await Html.PartialAsync("~/Views/Shared/Components/DataGrid/DataGrid.cshtml", simpleGrid)
    </div>
    
    <!-- Product Grid -->
    <div class="mb-5">
        <h4>Product Catalog Grid</h4>
        @await Html.PartialAsync("~/Views/Shared/Components/DataGrid/DataGrid.cshtml", productGrid)
    </div>
</div>

@section Scripts {
    <script>
        // User actions
        function viewUser(id) { alert('View user: ' + id); }
        function editUser(id) { alert('Edit user: ' + id); }
        function deleteUser(id) { alert('Delete user: ' + id); }
        
        // Product actions
        function editProduct(id) { alert('Edit product: ' + id); }
        function deleteProduct(id) { alert('Delete product: ' + id); }
        
        // Grid actions
        function exportData() { alert('Export data'); }
        function refreshData() { location.reload(); }
        
        // Select all functionality for both grids
        document.addEventListener('DOMContentLoaded', function() {
            // User table
            const userSelectAll = document.getElementById('userTable_selectAll');
            if (userSelectAll) {
                userSelectAll.addEventListener('change', function() {
                    const checkboxes = document.querySelectorAll('#userTable .row-checkbox');
                    checkboxes.forEach(cb => cb.checked = this.checked);
                });
            }
            
            // Product table
            const productSelectAll = document.getElementById('productTable_selectAll');
            if (productSelectAll) {
                productSelectAll.addEventListener('change', function() {
                    const checkboxes = document.querySelectorAll('#productTable .row-checkbox');
                    checkboxes.forEach(cb => cb.checked = this.checked);
                });
            }
        });
    </script>
}
