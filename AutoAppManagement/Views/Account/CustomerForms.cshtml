<!-- Customer Form -->
<div class="row" id="CustomerForm">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-body">
                <!-- Avatar Upload -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label">Avatar</label>
                        <div class="d-flex align-items-center gap-3">
                            <input type="file" class="form-control" id="avatarFile" name="AvatarFile" accept="image/*">
                        </div>
                    </div>
                </div>

                <!-- Personal Info -->
                <div data-type="text"
                        data-name="name"
                        data-label="Họ tên"
                        data-placeholder="Nhập họ và tên"
                     data-required>
            </div>
                <div class="row">
                    <div data-type="email"
                         data-name="email"
                         data-label="Email"
                         data-placeholder="Nhập email"
                         data-wrapper-class="col-md-6"
                         data-required>
                    </div>
                    <div data-type="tel"
                         data-name="phone"
                         data-label="Số điện thoại"
                         data-placeholder="Nhập số điện thoại"
                         data-wrapper-class="col-md-6"
                         data-required>
                    </div>
                </div>

                <div class="row">
                    <div data-type="date"
                         data-name="dateOfBirth"
                         data-wrapper-class="col-md-6"
                         data-label="Ngày sinh">
                    </div>

                    <div data-type="select"
                         data-name="gender"
                         data-label="Giới tính"
                         data-wrapper-class="col-md-6"
                         data-options="">
                    </div>
                </div>

                <div data-type="text"
                        data-name="address"
                        data-label="Địa chỉ"
                        data-placeholder="Nhập địa chỉ đầy đủ"
                     data-required>
            </div>

                <div data-type="textarea"
                        data-name="address"
                        data-label="Ghi chú"
                        data-placeholder="Ghi chú về khách hàng..."
                     data-maxLength="500">
            </div>

                @if (ViewBag.Mode == "add")
                    {
                    <div data-type="switch"
                                data-name="sendWelcomeEmail"
                                data-label="Gửi email chào mừng"
                                data-required></div>
                    }
            </div>
        </div>
    </div>
</div>

<script src="~/js/pages/account/account-detail.js"></script>