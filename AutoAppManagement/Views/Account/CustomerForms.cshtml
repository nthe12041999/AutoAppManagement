@using AutoAppManagement.WebApp.Common.Constant
@using AutoAppManagement.Helpers
@{
    string mode = ViewBag.Mode?.ToString() ?? "add";
    string modalTitle = mode switch {
        "add" => "Thêm mới tài khoản khách hàng",
        "edit" => "Chỉnh sửa tài khoản khách hàng",
        "view" => "Xem chi tiết tài khoản khách hàng",
        _ => "Quản lý tài khoản khách hàng"
    };
}

<style>
.modal-dialog {
    max-width: 95% !important;
    width: 95% !important;
}
.modal-body {
    padding: 1rem !important;
}
.form-group, .mb-3 {
    margin-bottom: 1rem !important;
}
</style>

<div data-type="@ControlType.Form"
     data-id="customerForm"
     data-label="<i class='bi bi-person-plus me-2'></i>@modalTitle"
     data-class="bg-success text-white"
     data-button-save-id="saveCustomerBtn"
     data-button-cancel-id="cancelCustomerBtn"
     data-form-id="customerForm"
     data-url="/Account/SaveCustomer"
     data-method="POST"
     data-modal>

    @if (mode == "add" || mode == "edit")
    {
        <!-- Avatar Upload -->
        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label">Avatar</label>
                <div class="d-flex align-items-center gap-3">
                    <img id="avatarPreview" src="/images/default-avatar.png" alt="Avatar"
                         class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;">
                    <input type="file" class="form-control" id="avatarFile" name="AvatarFile" accept="image/*">
                </div>
            </div>
        </div>

        <div class="row">
            <div data-type="@ControlType.Text"
                 data-id="firstName"
                 data-name="FirstName"
                 data-label="Họ"
                 data-placeholder="Nhập họ"
                 data-wrapper-class="col-md-6"
                 data-required></div>

            <div data-type="@ControlType.Text"
                 data-id="lastName"
                 data-name="LastName"
                 data-label="Tên"
                 data-placeholder="Nhập tên"
                 data-wrapper-class="col-md-6"
                 data-required></div>
        </div>

        <div class="row">
            <div data-type="@ControlType.Email"
                 data-id="email"
                 data-name="Email"
                 data-label="Email"
                 data-placeholder="example@email.com"
                 data-wrapper-class="col-md-6"
                 data-required></div>

            <div data-type="@ControlType.Tel"
                 data-id="phone"
                 data-name="Phone"
                 data-label="Số điện thoại"
                 data-placeholder="0123456789"
                 data-wrapper-class="col-md-6"></div>
        </div>

        @if (mode == "add")
        {
            <div class="row">
                <div data-type="@ControlType.Password"
                     data-id="password"
                     data-name="Password"
                     data-label="Mật khẩu"
                     data-placeholder="Nhập mật khẩu"
                     data-wrapper-class="col-md-6"
                     data-required></div>

                <div data-type="@ControlType.Password"
                     data-id="confirmPassword"
                     data-name="ConfirmPassword"
                     data-label="Xác nhận mật khẩu"
                     data-placeholder="Nhập lại mật khẩu"
                     data-wrapper-class="col-md-6"
                     data-required></div>
            </div>
        }

        <!-- Account Settings Card -->
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Cài đặt tài khoản</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div data-type="@ControlType.Select"
                         data-id="role"
                         data-name="Role"
                         data-label="<i class='bi bi-person-badge me-1'></i>Loại tài khoản"
                         data-wrapper-class="col-md-6"
                         data-required
                         data-options='@Html.Raw(FormOptionsHelper.GetCustomerTypeOptions())'></div>

                    <div data-type="@ControlType.Select"
                         data-id="status"
                         data-name="Status"
                         data-label="<i class='bi bi-toggle-on me-1'></i>Trạng thái"
                         data-wrapper-class="col-md-6"
                         data-required
                         data-options='@Html.Raw(FormOptionsHelper.GetAccountStatusOptions("active"))'></div>
                </div>
            </div>
        </div>

        <!-- Personal Information Card -->
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Thông tin cá nhân</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div data-type="@ControlType.Date"
                         data-id="dateOfBirth"
                         data-name="DateOfBirth"
                         data-label="<i class='bi bi-calendar-event me-1'></i>Ngày sinh"
                         data-wrapper-class="col-md-6"></div>
                    <div data-type="@ControlType.Select"
                         data-id="gender"
                         data-name="Gender"
                         data-label="<i class='bi bi-gender-ambiguous me-1'></i>Giới tính"
                         data-wrapper-class="col-md-6"
                         data-options='@Html.Raw(FormOptionsHelper.GetGenderOptions())'></div>
                </div>

                <div class="row">
                    <div data-type="@ControlType.Textarea"
                         data-id="address"
                         data-name="Address"
                         data-label="<i class='bi bi-geo-alt me-1'></i>Địa chỉ"
                         data-placeholder="Nhập địa chỉ đầy đủ"
                         data-rows="2"
                         data-wrapper-class="col-md-12"></div>
                </div>
            </div>
        </div>

        <!-- Verification Settings Card -->
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-shield-check me-2"></i>Xác thực & Thông báo</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div data-type="@ControlType.Checkbox"
                             data-id="isVerified"
                             data-name="IsVerified"
                             data-label="✅ Tài khoản đã được xác thực"
                             data-value="true"></div>
                    </div>

                    @if (mode == "add")
                    {
                        <div class="col-md-6">
                            <div data-type="@ControlType.Checkbox"
                                 data-id="sendWelcomeEmail"
                                 data-name="SendWelcomeEmail"
                                 data-label="📧 Gửi email chào mừng"
                                 data-value="true"
                                 data-checked></div>
                        </div>
                    }
                </div>
            </div>
        </div>
            }

            <!-- Notes -->
            <div data-type="@ControlType.Textarea"
                 data-id="notes"
                 data-name="Notes"
                 data-label="Ghi chú"
                 data-placeholder="Ghi chú thêm về khách hàng"
                 data-rows="3"></div>
        }
        else if (mode == "view")
        {
            <!-- View Mode - Display Only -->
            <div class="row">
                <div class="col-12 mb-4 text-center">
                    <img id="viewAvatar" src="/images/default-avatar.png" alt="Customer Avatar" 
                         style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #dee2e6;">
                    <h5 class="mt-2 mb-0" id="viewFullName">Tên khách hàng</h5>
                    <span class="badge bg-primary" id="viewRole">Loại tài khoản</span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Email:</label>
                    <p class="mb-0" id="viewEmail">-</p>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Số điện thoại:</label>
                    <p class="mb-0" id="viewPhone">-</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Trạng thái:</label>
                    <p class="mb-0">
                        <span class="badge" id="viewStatus">-</span>
                    </p>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Ngày tham gia:</label>
                    <p class="mb-0" id="viewCreatedDate">-</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Lần cuối đăng nhập:</label>
                    <p class="mb-0" id="viewLastLogin">-</p>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Xác thực:</label>
                    <p class="mb-0">
                        <span class="badge" id="viewVerification">-</span>
                    </p>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">Địa chỉ:</label>
                    <p class="mb-0" id="viewAddress">-</p>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">Ghi chú:</label>
                    <p class="mb-0" id="viewNotes">-</p>
                </div>
            </div>
        }

</div>

<script>
$(document).ready(function() {
    // Initialize form control binder
    window.formControlBinder.init('#customerModal');
    // Avatar preview functionality
    $('#avatarFile').on('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                $('#avatarPreview').attr('src', e.target.result);
            };
            reader.readAsDataURL(file);
        }
    });

    // Password confirmation validation
    $('#confirmPassword').on('input', function() {
        const password = $('#password').val();
        const confirmPassword = $(this).val();
        
        if (password !== confirmPassword) {
            this.setCustomValidity('Mật khẩu xác nhận không khớp');
        } else {
            this.setCustomValidity('');
        }
    });

    // Form submission
    $('#customerForm').on('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const mode = '@mode';
        
        // Show loading
        Swal.fire({
            title: 'Đang xử lý...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        // Simulate API call
        setTimeout(() => {
            Swal.fire({
                title: 'Thành công!',
                text: mode === 'add' ? 'Tài khoản khách hàng đã được tạo thành công.' : 'Tài khoản khách hàng đã được cập nhật.',
                icon: 'success'
            }).then(() => {
                // Close modal and refresh grid
                $('#customerModal').modal('hide');
                if (window.dataGridInstance) {
                    const config = window.dataGridInstance.getGrid('customerAccountDataGrid');
                    if (config) {
                        window.dataGridInstance.refreshData(config);
                    }
                }
            });
        }, 1500);
    });
});

function editCustomer() {
    // Close current modal and open edit mode
    $('#customerModal').modal('hide');
    
    // Get customer ID from the current view
    const customerId = $('#customerModal').data('customer-id');
    
    // Load edit form
    setTimeout(() => {
        if (window.dataGridInstance) {
            window.dataGridInstance.loadDetailFormModal('customerAccountDataGrid', customerId, 'edit');
        }
    }, 500);
}
</script>
