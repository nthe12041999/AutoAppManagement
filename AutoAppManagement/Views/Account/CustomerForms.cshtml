@using AutoAppManagement.Models.Components
@using AutoAppManagement.WebApp.Common.Constant
@using AutoAppManagement.Helpers
@{
    ViewData["Title"] = "Form Khách hàng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/customer-forms.css" />
}

<!-- Form content only - Modal structure handled by data-grid.js -->
<form id="customerForm" data-url="/Account/SubmitData" data-method="POST" data-mode="@ViewBag.Mode" novalidate>
    <!-- Hidden fields mapped to AccountDTO -->
    <div data-type="Hidden"
         data-id="UserName"
         data-name="UserName"
         data-value=""></div>

    <div data-type="Hidden"
         data-id="Name"
         data-name="Name"
         data-value=""></div>
    <!-- Avatar Upload -->
    @* <div class="row mb-3">
        <div data-type="@ControlType.Image"
             data-id="avatarFile"
             data-name="AvatarFile"
             data-label="Avatar"
             data-help-text="Chọn file ảnh (JPG, PNG, GIF) - Tối đa 2MB"
             data-accept="image/*"
             data-wrapper-class="col-md-12"></div>
    </div> *@

    <!-- Personal Info -->
    <div class="row">
        <div data-type="@ControlType.Text"
             data-id="FirstName"
             data-name="FirstName"
             data-label="Họ"
             data-placeholder="Nhập họ"
             data-wrapper-class="col-md-6"
             data-required
             data-min-length="1"
             data-max-length="50"></div>

        <div data-type="@ControlType.Text"
             data-id="LastName"
             data-name="LastName"
             data-label="Tên"
             data-placeholder="Nhập tên"
             data-wrapper-class="col-md-6"
             data-required
             data-min-length="1"
             data-max-length="50"></div>
    </div>

    <div class="row">
        <div data-type="@ControlType.Email"
             data-id="Email"
             data-name="Email"
             data-label="Email"
             data-placeholder="customer@email.com"
             data-wrapper-class="col-md-6"
             data-required
             data-max-length="100"
             data-regex='^.+&#64;.+\..+$'
             data-regex-message="Email không đúng định dạng"></div>

        <div data-type="@ControlType.Tel"
             data-id="Phone"
             data-name="Phone"
             data-label="Số điện thoại"
             data-placeholder="0XXX XXX XXX"
             data-wrapper-class="col-md-6"
             data-max-length="20"
             data-regex="^[0-9+\-\s()]+$"
             data-regex-message="Số điện thoại không đúng định dạng"></div>
    </div>

    <!-- Password will be auto-generated - No input needed -->
    @* Password Section removed - will be generated automatically by backend *@

    <!-- Account Info -->
    <div class="row">
        <div data-type="@ControlType.Select"
             data-id="LicenseId"
             data-name="LicenseId"
             data-label="License"
             data-wrapper-class="col-md-6"
             data-options='[]'
             data-required></div>

        <div data-type="@ControlType.Select"
             data-id="Status"
             data-name="Status"
             data-label="Trạng thái"
             data-wrapper-class="col-md-6"
             data-options='@Html.Raw(FormOptionsHelper.GetAccountStatusOptions())'
             data-value="1"
             data-required
             data-valid-values="1,2,3"></div>
    </div>

    <!-- Personal Information -->
    <div class="row">
        <div data-type="@ControlType.Date"
             data-id="DateOfBirth"
             data-name="DateOfBirth"
             data-label="Ngày sinh"
             data-wrapper-class="col-md-6"
             data-max-today></div>

        <div data-type="@ControlType.Select"
             data-id="Gender"
             data-name="Gender"
             data-label="Giới tính"
             data-wrapper-class="col-md-6"
             data-options='@Html.Raw(FormOptionsHelper.GetGenderOptions())'></div>
    </div>

    <!-- Address -->
    @* <div class="mb-3">
        <div data-type="@ControlType.Textarea"
             data-id="Address"
             data-name="Address"
             data-label="Địa chỉ"
             data-placeholder="Nhập địa chỉ đầy đủ"
             data-rows="2"
             data-max-length="500"
             data-wrapper-class="col-md-12"></div>
    </div> *@

    <!-- Notes -->
    @* <div class="mb-3">
        <div data-type="@ControlType.Textarea"
             data-id="Notes"
             data-name="Notes"
             data-label="Ghi chú"
             data-placeholder="Ghi chú về khách hàng..."
             data-rows="3"
             data-max-length="1000"
             data-wrapper-class="col-md-12"></div>
    </div> *@

    <!-- Verification Settings - Chỉ hiển thị khi thêm mới -->
    <div class="mb-3" data-show-on-mode="add">
        <div data-type="@ControlType.Switch"
             data-id="SendWelcomeEmail"
             data-name="SendWelcomeEmail"
             data-label="Gửi email đăng kí sử dụng"
             data-value="true"
             data-checked="true"></div>
    </div>

</form>
