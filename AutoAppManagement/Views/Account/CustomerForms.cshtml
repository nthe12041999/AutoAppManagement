@using AutoAppManagement.Models.Enums
@using AutoAppManagement.Helpers
@{
    ViewData["Title"] = "Customer Forms";
    ViewData["PageName"] = "customer-forms";
    var modalTitle = "Quản lý tài khoản khách hàng";
}

<div class="card-body">
    <form id="customerForm" action="/Account/SubmitData" method="POST" enctype="multipart/form-data">
        <!-- Avatar Upload -->
        <div class="row mb-3">
            <div class="col-md-12">
                <label class="form-label">Avatar</label>
                <div class="d-flex align-items-center gap-3">
                    <img id="avatarPreview" src="/images/default-avatar.png" alt="Avatar"
                         class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;">
                    <div data-type="File" data-id="avatarFile" data-name="AvatarFile" data-accept="image/*" data-wrapper-class="flex-grow-1"></div>
                </div>
            </div>
        </div>

        <!-- Personal Info -->
        <div class="row">
            <div data-type="Text" data-id="firstName" data-name="FirstName" data-label="Họ" data-placeholder="Nhập họ" data-wrapper-class="col-md-6" data-required></div>
            <div data-type="Text" data-id="lastName" data-name="LastName" data-label="Tên" data-placeholder="Nhập tên" data-wrapper-class="col-md-6" data-required></div>
        </div>

        <div class="row">
            <div data-type="Email" data-id="email" data-name="Email" data-label="Email" data-placeholder="customer@email.com" data-wrapper-class="col-md-6" data-required></div>
            <div data-type="Tel" data-id="phone" data-name="Phone" data-label="Số điện thoại" data-placeholder="0XXX XXX XXX" data-wrapper-class="col-md-6"></div>
        </div>

        <div class="row">
            <div data-type="Password" data-id="password" data-name="Password" data-label="Mật khẩu" data-placeholder="Nhập mật khẩu" data-wrapper-class="col-md-6" data-required></div>
            <div data-type="Password" data-id="confirmPassword" data-name="ConfirmPassword" data-label="Xác nhận mật khẩu" data-placeholder="Nhập lại mật khẩu" data-wrapper-class="col-md-6" data-required></div>
        </div>

        <!-- Account Info -->
        <div class="row">
            <div data-type="Select" data-id="role" data-name="Role" data-label="Loại tài khoản" data-wrapper-class="col-md-6" data-options='[
                            {"value":"","text":"Chọn loại tài khoản"},
                            {"value":"customer","text":"Khách hàng"},
                            {"value":"premium_customer","text":"Khách hàng VIP"},
                            {"value":"business_customer","text":"Khách hàng doanh nghiệp"}
                        ]' data-required></div>
            <div data-type="Select" data-id="status" data-name="Status" data-label="Trạng thái" data-wrapper-class="col-md-6" data-options='[
                            {"value":"","text":"Chọn trạng thái"},
                            {"value":"active","text":"Hoạt động"},
                            {"value":"inactive","text":"Không hoạt động"},
                            {"value":"pending","text":"Chờ xác thực"},
                            {"value":"suspended","text":"Tạm khóa"}
                        ]' data-required></div>
        </div>

        <!-- Personal Information -->
        <div class="row">
            <div data-type="Date" data-id="dateOfBirth" data-name="DateOfBirth" data-label="Ngày sinh" data-wrapper-class="col-md-6"></div>
            <div data-type="Select" data-id="gender" data-name="Gender" data-label="Giới tính" data-wrapper-class="col-md-6" data-options='[
                            {"value":"","text":"Chọn giới tính"},
                            {"value":"male","text":"Nam"},
                            {"value":"female","text":"Nữ"},
                            {"value":"other","text":"Khác"}
                        ]'></div>
        </div>

        <!-- Address -->
        <div class="mb-3">
            <div data-type="Textarea" data-id="address" data-name="Address" data-label="Địa chỉ" data-placeholder="Nhập địa chỉ đầy đủ" data-rows="2" data-wrapper-class="col-md-12"></div>
        </div>

        <!-- Notes -->
        <div class="mb-3">
            <div data-type="Textarea" data-id="notes" data-name="Notes" data-label="Ghi chú" data-placeholder="Ghi chú về khách hàng..." data-rows="3" data-maxlength="500" data-wrapper-class="col-md-12"></div>
            <div class="form-text">
                <span id="notesCount">0</span>/500 ký tự
            </div>
        </div>

        <!-- Verification Settings -->
        <div class="mb-3">
            <div data-type="Switch" data-id="isVerified" data-name="IsVerified" data-label="Tài khoản đã được xác thực"></div>
            <div data-type="Switch" data-id="sendWelcomeEmail" data-name="SendWelcomeEmail" data-label="Gửi email chào mừng" data-checked="true"></div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('customerForm');
            const cancelBtn = document.getElementById('cancelBtn');
            const resetBtn = document.getElementById('resetBtn');
            const saveBtn = document.getElementById('saveBtn');
            const notesTextarea = document.getElementById('notes');
            const notesCount = document.getElementById('notesCount');
            const passwordField = document.getElementById('password');
            const confirmPasswordField = document.getElementById('confirmPassword');
            const avatarFile = document.getElementById('avatarFile');
            const avatarPreview = document.getElementById('avatarPreview');

            // Avatar preview functionality
            if (avatarFile) {
                avatarFile.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            avatarPreview.src = e.target.result;
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            // Character count for notes
            if (notesTextarea) {
                notesTextarea.addEventListener('input', function() {
                    const length = this.value.length;
                    notesCount.textContent = length;
                    
                    if (length > 450) {
                        notesCount.style.color = '#ffc107';
                    } else {
                        notesCount.style.color = '#6c757d';
                    }
                });
            }

            // Password validation
            function validatePassword() {
                if (!passwordField || !confirmPasswordField) return true;
                
                const password = passwordField.value;
                const confirmPassword = confirmPasswordField.value;
                
                if (password.length > 0 && password.length < 8) {
                    passwordField.classList.add('is-invalid');
                    return false;
                }
                
                if (confirmPassword.length > 0 && password !== confirmPassword) {
                    confirmPasswordField.classList.add('is-invalid');
                    return false;
                }
                
                if (password.length >= 8) {
                    passwordField.classList.remove('is-invalid');
                    passwordField.classList.add('is-valid');
                }
                
                if (confirmPassword.length > 0 && password === confirmPassword) {
                    confirmPasswordField.classList.remove('is-invalid');
                    confirmPasswordField.classList.add('is-valid');
                }
                
                return true;
            }

            if (passwordField) {
                passwordField.addEventListener('input', validatePassword);
            }
            if (confirmPasswordField) {
                confirmPasswordField.addEventListener('input', validatePassword);
            }

            // Form validation
            if (form) {
                form.addEventListener('submit', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    
                    let isFormValid = true;
                    
                    // Check required fields
                    const requiredFields = form.querySelectorAll('[required]');
                    requiredFields.forEach(field => {
                        if (!field.value.trim()) {
                            isFormValid = false;
                            field.classList.add('is-invalid');
                        } else {
                            field.classList.remove('is-invalid');
                            field.classList.add('is-valid');
                        }
                    });

                    // Validate password
                    if (!validatePassword()) {
                        isFormValid = false;
                    }
                    
                    if (isFormValid) {
                        showNotification('✅ Customer validation thành công! Đang lưu...', 'success');
                        
                        // Simulate saving process
                        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
                        saveBtn.disabled = true;
                        
                        setTimeout(() => {
                            saveBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Lưu tài khoản';
                            saveBtn.disabled = false;
                            showNotification('💾 Tài khoản khách hàng đã được lưu thành công!', 'success');
                            
                            // Close modal if in modal
                            const modalContainer = form.closest('.modal-container');
                            if (modalContainer) {
                                setTimeout(() => {
                                    modalContainer.remove();
                                }, 1500);
                            }
                            
                            // Refresh grid if available
                            if (window.dataGridInstance) {
                                const config = window.dataGridInstance.getGrid('customerAccountDataGrid');
                                if (config) {
                                    window.dataGridInstance.refreshData(config);
                                }
                            }
                        }, 2000);
                    } else {
                        showNotification('❌ Vui lòng kiểm tra lại các trường bắt buộc', 'error');
                    }
                    
                    form.classList.add('was-validated');
                });
            }

            // Reset button
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    form.classList.remove('was-validated');
                    if (notesCount) notesCount.textContent = '0';
                    if (avatarPreview) avatarPreview.src = '/images/default-avatar.png';
                    showNotification('🔄 Form đã được reset', 'info');
                });
            }

            // Cancel button
            if (cancelBtn) {
                cancelBtn.addEventListener('click', function() {
                    if (confirm('Bạn có chắc muốn hủy? Dữ liệu sẽ không được lưu.')) {
                        form.reset();
                        form.classList.remove('was-validated');
                        if (notesCount) notesCount.textContent = '0';
                        if (avatarPreview) avatarPreview.src = '/images/default-avatar.png';
                        showNotification('❌ Đã hủy thao tác', 'warning');
                        
                        // Close modal if form is in modal
                        const modalContainer = this.closest('.modal-container');
                        if (modalContainer) {
                            modalContainer.remove();
                        }
                    }
                });
            }
        });

        function showNotification(message, type = 'info') {
            const alertClass = type === 'error' ? 'alert-danger' : 
                              type === 'success' ? 'alert-success' : 
                              type === 'warning' ? 'alert-warning' : 'alert-info';
            
            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 350px; max-width: 500px;';
            notification.innerHTML = `
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="d-flex align-items-center">
                    ${message}
                </div>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 4000);
        }

        function editCustomer() {
            // Close current modal and open edit mode
            const modalContainer = document.querySelector('.modal-container');
            if (modalContainer) {
                modalContainer.remove();
            }
            
            // Get customer ID from the current view
            const customerId = document.querySelector('#customerForm').dataset.customerId;
            
            // Load edit form
            setTimeout(() => {
                if (window.dataGridInstance) {
                    window.dataGridInstance.loadDetailFormModal('customerAccountDataGrid', customerId, 'edit');
                }
            }, 500);
        }
    </script>
}
