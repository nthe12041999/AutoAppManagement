@{
    var roleId = ViewBag.RoleId;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Role Info -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="avatar-lg bg-primary-subtle rounded me-3">
                            <i class="bi bi-person-badge text-primary fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-1" id="roleName">Đang tải...</h5>
                            <p class="text-muted mb-0" id="roleDescription">Đang tải thông tin vai trò...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Permissions Management -->
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="bi bi-shield-check me-2"></i>Quyền hạn của vai trò
                        </h6>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary" id="selectAllPermissions">
                                <i class="bi bi-check-all me-1"></i>Chọn tất cả
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="clearAllPermissions">
                                <i class="bi bi-x-circle me-1"></i>Bỏ chọn tất cả
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="permissionsContainer">
                        <!-- Permissions will be loaded here -->
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Đang tải...</span>
                            </div>
                            <p class="mt-2 text-muted">Đang tải danh sách quyền hạn...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    const roleId = @roleId;
    let allPermissions = {};
    let currentPermissions = [];

    // Load role info and permissions
    loadRoleInfo();
    loadPermissions();

    function loadRoleInfo() {
        // Simulate loading role info
        setTimeout(() => {
            $('#roleName').text('Quản trị viên');
            $('#roleDescription').text('Quyền cao nhất trong hệ thống');
        }, 500);
    }

    function loadPermissions() {
        $.get('/Role/GetAllPermissions')
            .done(function(response) {
                if (response.IsSuccess) {
                    allPermissions = response.Data;
                    loadCurrentRolePermissions();
                } else {
                    showError('Không thể tải danh sách quyền hạn');
                }
            })
            .fail(function() {
                showError('Có lỗi xảy ra khi tải quyền hạn');
            });
    }

    function loadCurrentRolePermissions() {
        $.get('/Role/GetRolePermissions', { roleId: roleId })
            .done(function(response) {
                if (response.IsSuccess) {
                    currentPermissions = response.Data || [];
                    renderPermissions();
                } else {
                    renderPermissions();
                }
            })
            .fail(function() {
                renderPermissions();
            });
    }

    function renderPermissions() {
        let html = '';
        
        Object.keys(allPermissions).forEach(module => {
            const modulePermissions = allPermissions[module];
            const moduleTitle = getModuleTitle(module);
            
            html += `
                <div class="permission-module mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <h6 class="mb-0 me-3">${moduleTitle}</h6>
                        <div class="form-check">
                            <input class="form-check-input module-checkbox" type="checkbox" 
                                   id="module_${module}" data-module="${module}">
                            <label class="form-check-label text-muted" for="module_${module}">
                                Chọn tất cả
                            </label>
                        </div>
                    </div>
                    <div class="row">
            `;
            
            modulePermissions.forEach(permission => {
                const isChecked = currentPermissions.includes(permission.id) ? 'checked' : '';
                html += `
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="card permission-card h-100">
                            <div class="card-body p-3">
                                <div class="form-check">
                                    <input class="form-check-input permission-checkbox" 
                                           type="checkbox" 
                                           id="permission_${permission.id}" 
                                           value="${permission.id}"
                                           data-module="${module}"
                                           ${isChecked}>
                                    <label class="form-check-label w-100" for="permission_${permission.id}">
                                        <div class="fw-semibold">${permission.name}</div>
                                        <small class="text-muted">${permission.description}</small>
                                        <div class="mt-1">
                                            <span class="badge bg-light text-dark">${permission.code}</span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            html += `
                    </div>
                </div>
            `;
        });
        
        $('#permissionsContainer').html(html);
        updateModuleCheckboxes();
    }

    function getModuleTitle(module) {
        const titles = {
            'users': 'Quản lý người dùng',
            'license': 'Quản lý License',
            'reports': 'Báo cáo',
            'settings': 'Cài đặt hệ thống',
            'orders': 'Quản lý đơn hàng',
            'system': 'Quản trị hệ thống'
        };
        return titles[module] || module;
    }

    function updateModuleCheckboxes() {
        $('.module-checkbox').each(function() {
            const module = $(this).data('module');
            const modulePermissions = $(`.permission-checkbox[data-module="${module}"]`);
            const checkedPermissions = $(`.permission-checkbox[data-module="${module}"]:checked`);
            
            if (checkedPermissions.length === 0) {
                $(this).prop('indeterminate', false).prop('checked', false);
            } else if (checkedPermissions.length === modulePermissions.length) {
                $(this).prop('indeterminate', false).prop('checked', true);
            } else {
                $(this).prop('indeterminate', true).prop('checked', false);
            }
        });
    }

    // Event handlers
    $(document).on('change', '.permission-checkbox', function() {
        updateModuleCheckboxes();
    });

    $(document).on('change', '.module-checkbox', function() {
        const module = $(this).data('module');
        const isChecked = $(this).is(':checked');
        $(`.permission-checkbox[data-module="${module}"]`).prop('checked', isChecked);
    });

    $('#selectAllPermissions').click(function() {
        $('.permission-checkbox').prop('checked', true);
        updateModuleCheckboxes();
    });

    $('#clearAllPermissions').click(function() {
        $('.permission-checkbox').prop('checked', false);
        updateModuleCheckboxes();
    });

    // Save permissions
    window.saveRolePermissions = function() {
        const selectedPermissions = $('.permission-checkbox:checked').map(function() {
            return parseInt($(this).val());
        }).get();

        $.post('/Role/AssignPermissions', {
            roleId: roleId,
            permissionIds: selectedPermissions
        })
        .done(function(response) {
            if (response.IsSuccess) {
                showSuccess('Cập nhật quyền hạn thành công');
                $('#managePermissionsModal').modal('hide');
                // Refresh the role grid if needed
                if (typeof window.refreshRoleGrid === 'function') {
                    window.refreshRoleGrid();
                }
            } else {
                showError(response.Message || 'Có lỗi xảy ra khi cập nhật quyền hạn');
            }
        })
        .fail(function() {
            showError('Có lỗi xảy ra khi cập nhật quyền hạn');
        });
    };

    function showSuccess(message) {
        // Use your notification system
        if (typeof toastr !== 'undefined') {
            toastr.success(message);
        } else {
            alert(message);
        }
    }

    function showError(message) {
        // Use your notification system
        if (typeof toastr !== 'undefined') {
            toastr.error(message);
        } else {
            alert(message);
        }
    }
});
</script>

<style>
.permission-card {
    transition: all 0.2s ease;
    border: 1px solid #e9ecef;
}

.permission-card:hover {
    border-color: #0d6efd;
    box-shadow: 0 2px 4px rgba(13, 110, 253, 0.1);
}

.permission-checkbox:checked + label .permission-card {
    border-color: #0d6efd;
    background-color: #f8f9ff;
}

.permission-module {
    border-bottom: 1px solid #e9ecef;
    padding-bottom: 1rem;
}

.permission-module:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.avatar-lg {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
}
</style>
