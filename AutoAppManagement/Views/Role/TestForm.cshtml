@using AutoAppManagement.WebApp.Common.Constant

<!DOCTYPE html>
<html>
<head>
    <title>Test Form Control Binder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h2>Test Form Control Binder</h2>
        
        <div class="row">
            <div class="col-12">
                <h4>1. Raw HTML Test</h4>
                <div data-type="Text" 
                     data-id="test1" 
                     data-name="test1" 
                     data-label="Test Input 1" 
                     data-placeholder="Enter text">
                    Original DIV - Should be replaced
                </div>
            </div>
        </div>
        
        <div class="row mt-3">
            <div class="col-12">
                <h4>2. Enum Value Test</h4>
                <div data-type="@ControlType.Text" 
                     data-id="test2" 
                     data-name="test2" 
                     data-label="Test Input 2" 
                     data-placeholder="Enter text">
                    Enum DIV - Value: @ControlType.Text
                </div>
            </div>
        </div>
        
        <div class="row mt-3">
            <div class="col-12">
                <h4>3. Checkbox Test</h4>
                <div data-type="@ControlType.Checkbox" 
                     data-id="test3" 
                     data-name="test3" 
                     data-label="Test Checkbox" 
                     data-value="true">
                    Checkbox DIV - Value: @ControlType.Checkbox
                </div>
            </div>
        </div>
        
        <div class="row mt-4">
            <div class="col-12">
                <button id="testBtn" class="btn btn-primary">Test Manual Binding</button>
                <button id="initBtn" class="btn btn-success">Run Init()</button>
            </div>
        </div>
        
        <div class="row mt-3">
            <div class="col-12">
                <h4>Debug Output:</h4>
                <pre id="debugOutput" style="background: #f8f9fa; padding: 10px; border: 1px solid #ddd;"></pre>
            </div>
        </div>
    </div>

    <script src="~/js/form-control-binder.js"></script>
    <script>
        function log(message) {
            const output = document.getElementById('debugOutput');
            output.textContent += message + '\n';
            console.log(message);
        }
        
        document.getElementById('testBtn').addEventListener('click', function() {
            log('=== MANUAL TEST START ===');
            
            // Check FormControlBinder
            log('FormControlBinder available: ' + !!window.formControlBinder);
            
            if (window.formControlBinder) {
                log('Available handlers: ' + Object.keys(window.formControlBinder.controlTypes).join(', '));
                
                // Check all data-type elements
                const elements = document.querySelectorAll('[data-type]');
                log('Found ' + elements.length + ' elements with data-type');
                
                elements.forEach((el, i) => {
                    const type = el.getAttribute('data-type');
                    const id = el.getAttribute('data-id');
                    log(`Element ${i}: type="${type}", id="${id}"`);
                    
                    // Check if handler exists
                    const handler = window.formControlBinder.controlTypes[type];
                    log(`  Handler exists: ${!!handler}`);
                    
                    if (handler) {
                        try {
                            const config = {
                                type: type,
                                id: id,
                                name: el.getAttribute('data-name'),
                                label: el.getAttribute('data-label'),
                                placeholder: el.getAttribute('data-placeholder'),
                                value: el.getAttribute('data-value') || '',
                                required: el.hasAttribute('data-required'),
                                customClass: '',
                                wrapperClass: 'col-12'
                            };
                            
                            log(`  Calling handler with config...`);
                            const html = handler(config);
                            log(`  Generated HTML length: ${html ? html.length : 0}`);
                            
                            if (html) {
                                // Try replacement
                                const tempDiv = document.createElement('div');
                                tempDiv.innerHTML = html;
                                const newElement = tempDiv.firstElementChild;
                                
                                if (newElement && el.parentNode) {
                                    el.parentNode.replaceChild(newElement, el);
                                    log(`  ✅ Replacement successful for ${id}`);
                                } else {
                                    log(`  ❌ Replacement failed for ${id}`);
                                }
                            }
                        } catch (error) {
                            log(`  ❌ Error: ${error.message}`);
                        }
                    }
                });
            }
            
            log('=== MANUAL TEST END ===');
        });
        
        document.getElementById('initBtn').addEventListener('click', function() {
            log('=== INIT TEST START ===');
            
            if (window.formControlBinder) {
                try {
                    window.formControlBinder.init();
                    log('✅ Init completed');
                } catch (error) {
                    log('❌ Init error: ' + error.message);
                }
            } else {
                log('❌ FormControlBinder not available');
            }
            
            log('=== INIT TEST END ===');
        });
        
        // Auto-run on load
        window.addEventListener('load', function() {
            log('Page loaded. FormControlBinder: ' + !!window.formControlBinder);
        });
    </script>
</body>
</html>
