<!-- Add/Edit License Modal -->
<div class="modal fade" id="addLicenseModal" tabindex="-1" aria-labelledby="addLicenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addLicenseModalLabel">
                    <i class="bi bi-key me-2"></i>Tạo License mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="licenseForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="customerId" required>
                                    <option value="">Chọn khách hàng</option>
                                    <option value="1">Nguyễn Văn An</option>
                                    <option value="2">Trần Thị Bình</option>
                                    <option value="3">Lê Minh Cường</option>
                                </select>
                                <label for="customerId">Khách hàng *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="licenseType" required>
                                    <option value="">Chọn loại license</option>
                                    <option value="basic">Basic</option>
                                    <option value="premium">Premium</option>
                                    <option value="enterprise">Enterprise</option>
                                </select>
                                <label for="licenseType">Loại License *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="maxDevices" placeholder="Số thiết bị tối đa" min="1" max="100" required>
                                <label for="maxDevices">Số thiết bị tối đa *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="maxUsers" placeholder="Số người dùng tối đa" min="1" max="1000" required>
                                <label for="maxUsers">Số người dùng tối đa *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="date" class="form-control" id="startDate" required>
                                <label for="startDate">Ngày bắt đầu *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="date" class="form-control" id="expiryDate" required>
                                <label for="expiryDate">Ngày hết hạn *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="number" class="form-control" id="price" placeholder="Giá" min="0" step="1000">
                                <label for="price">Giá (VND)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="status" required>
                                    <option value="">Chọn trạng thái</option>
                                    <option value="active">Hoạt động</option>
                                    <option value="suspended">Tạm dừng</option>
                                </select>
                                <label for="status">Trạng thái *</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea class="form-control" id="description" placeholder="Mô tả" style="height: 100px"></textarea>
                                <label for="description">Mô tả</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-primary" id="saveLicense">
                    <i class="bi bi-check-lg me-1"></i>Tạo License
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Renew License Modal -->
<div class="modal fade" id="renewLicenseModal" tabindex="-1" aria-labelledby="renewLicenseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="renewLicenseModalLabel">
                    <i class="bi bi-arrow-clockwise me-2"></i>Gia hạn License
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="renewForm">
                    <div class="mb-3">
                        <label class="form-label">License Key</label>
                        <input type="text" class="form-control font-monospace" id="renewLicenseKey" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày hết hạn hiện tại</label>
                        <input type="text" class="form-control" id="currentExpiryDate" readonly>
                    </div>
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="date" class="form-control" id="newExpiryDate" required>
                            <label for="newExpiryDate">Ngày hết hạn mới *</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-floating">
                            <textarea class="form-control" id="renewReason" placeholder="Lý do gia hạn" style="height: 80px"></textarea>
                            <label for="renewReason">Lý do gia hạn</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-warning" id="confirmRenew">
                    <i class="bi bi-arrow-clockwise me-1"></i>Gia hạn
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }
</style>

@section Scripts {
    <script>
        // Select all functionality
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Action functions
        function viewLicense(id) {
            alert('Xem chi tiết license ID: ' + id);
        }

        function renewLicense(id) {
            // Load license data
            document.getElementById('renewLicenseKey').value = 'LIC-2024-00' + id + '-ABCD';
            document.getElementById('currentExpiryDate').value = '31/12/2024';
            new bootstrap.Modal(document.getElementById('renewLicenseModal')).show();
        }

        function suspendLicense(id) {
            if (confirm('Bạn có chắc chắn muốn tạm dừng license này?')) {
                alert('Đã tạm dừng license ID: ' + id);
            }
        }

        function deleteLicense(id) {
            if (confirm('Bạn có chắc chắn muốn xóa license này?')) {
                alert('Đã xóa license ID: ' + id);
            }
        }

        // Save license
        document.getElementById('saveLicense').addEventListener('click', function() {
            const form = document.getElementById('licenseForm');
            if (form.checkValidity()) {
                alert('Đã tạo license thành công!');
                bootstrap.Modal.getInstance(document.getElementById('addLicenseModal')).hide();
            } else {
                form.reportValidity();
            }
        });

        // Confirm renew
        document.getElementById('confirmRenew').addEventListener('click', function() {
            const newDate = document.getElementById('newExpiryDate').value;
            if (newDate) {
                alert('Đã gia hạn license thành công!');
                bootstrap.Modal.getInstance(document.getElementById('renewLicenseModal')).hide();
            } else {
                alert('Vui lòng chọn ngày hết hạn mới!');
            }
        });

        // Filter functionality
        document.getElementById('resetFilter').addEventListener('click', function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('typeFilter').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('dateFrom').value = '';
            document.getElementById('dateTo').value = '';
        });

        // Set default dates
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('startDate').value = today;

            const nextYear = new Date();
            nextYear.setFullYear(nextYear.getFullYear() + 1);
            document.getElementById('expiryDate').value = nextYear.toISOString().split('T')[0];
        });
    </script>
}
