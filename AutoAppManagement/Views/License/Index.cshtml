@{
    ViewData["Title"] = "Quản lý License";
    ViewData["PageName"] = "license-management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-0">
                        <i class="bi bi-key me-2 text-primary"></i>Quản lý License
                    </h1>
                    <p class="text-muted mb-0">Quản lý giấy phép và quyền sử dụng hệ thống</p>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                        <li class="breadcrumb-item active">License</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Tổng License</h6>
                            <h3 class="mb-0" id="totalLicenses">156</h3>
                        </div>
                        <i class="bi bi-key-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Đang hoạt động</h6>
                            <h3 class="mb-0" id="activeLicenses">124</h3>
                        </div>
                        <i class="bi bi-check-circle-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Sắp hết hạn</h6>
                            <h3 class="mb-0" id="expiringLicenses">18</h3>
                        </div>
                        <i class="bi bi-exclamation-triangle-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-white-50 mb-1">Đã hết hạn</h6>
                            <h3 class="mb-0" id="expiredLicenses">14</h3>
                        </div>
                        <i class="bi bi-x-circle-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Filter Component (Standard) -->
    <div data-component="card-filter"
         data-container-id="licenseGridFilter"
         data-has-search="true"
         data-has-category="true"
         data-has-status="true"
         data-has-date-range="true"
         data-search-label="Tìm kiếm License"
         data-search-placeholder="Nhập tên license, mã số, khách hàng..."
         data-category-options="basic:Basic,premium:Premium,enterprise:Enterprise,trial:Trial"
         data-status-options="active:Hoạt động,expired:Hết hạn,suspended:Tạm dừng,pending:Chờ kích hoạt"
         data-debounce-ms="500"
         data-auto-apply="true">
    </div>



    <!-- Data Grid Component (Auto-generate) -->
    <div data-component="data-grid"
         data-container-id="licenseDataGrid"
         data-entity="License"
         data-entity-plural="Licenses"
         data-columns="licenseKey:License Key:text,customer:Khách hàng:text,type:Loại:badge,status:Trạng thái:badge,createdDate:Ngày tạo:text,expiryDate:Ngày hết hạn:text,devices:Thiết bị:text,actions:Thao tác:actions"
         data-has-add="true"
         data-has-refresh="true"
         data-has-export="true"
         data-has-select-all="true"
         data-add-label="Thêm License"
         data-refresh-label="Làm mới"
         data-export-label="Xuất Excel"
         data-sample-data='[
             {"id":1,"licenseKey":"LIC-2024-001","customer":"Công ty ABC","type":"Premium","status":"Hoạt động","badge":"success","createdDate":"15/01/2024","expiryDate":"15/01/2025","devices":"5/10"},
             {"id":2,"licenseKey":"LIC-2024-002","customer":"Công ty XYZ","type":"Basic","status":"Sắp hết hạn","badge":"warning","createdDate":"10/02/2024","expiryDate":"10/03/2024","devices":"2/5"},
             {"id":3,"licenseKey":"LIC-2023-045","customer":"Tập đoàn DEF","type":"Enterprise","status":"Hết hạn","badge":"danger","createdDate":"20/12/2023","expiryDate":"20/12/2024","devices":"0/20"}
         ]'
         data-has-pagination="true"
         data-page-size="10"
         data-total-items="156">
    </div>
</div>


