@using AutoAppManagement.Models.Components
@using AutoAppManagement.WebApp.Common.Constant
@using AutoAppManagement.Helpers
@{
    ViewData["Title"] = "Form License";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/license-forms.css" />
}

<!-- Form content only - Modal structure handled by data-grid.js -->
<form id="licenseForm" action="/License/CreateLicense" method="POST">
    <!-- License Key và Customer -->
    <div class="row">
        <div data-type="@ControlType.Text"
             data-id="licenseKey"
             data-name="licenseKey"
             data-label="License Key"
             data-placeholder="LIC-2024-XXX"
             data-help-text="Định dạng: LIC-YYYY-XXX"
             data-wrapper-class="col-md-6"
             data-required></div>

        <div data-type="@ControlType.Text"
             data-id="customer"
             data-name="customer"
             data-label="Khách hàng"
             data-placeholder="Tên công ty/khách hàng"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Contact Info -->
    <div class="row">
        <div data-type="@ControlType.Email"
             data-id="contactEmail"
             data-name="contactEmail"
             data-label="Email liên hệ"
             data-placeholder="contact@company.com"
             data-wrapper-class="col-md-6"
             data-required></div>

        <div data-type="@ControlType.Tel"
             data-id="contactPhone"
             data-name="contactPhone"
             data-label="Số điện thoại"
             data-placeholder="0XXX XXX XXX"
             data-wrapper-class="col-md-6"></div>
    </div>

    <!-- License Type và Status -->
    <div class="row">
        <div data-type="@ControlType.Select"
             data-id="licenseType"
             data-name="licenseType"
             data-label="Loại License"
             data-wrapper-class="col-md-6"
             data-options='[
                 {"value":"","text":"-- Chọn loại license --"},
                 {"value":"trial","text":"Trial (Dùng thử)"},
                 {"value":"basic","text":"Basic (Cơ bản)"},
                 {"value":"premium","text":"Premium (Cao cấp)"},
                 {"value":"enterprise","text":"Enterprise (Doanh nghiệp)"}
             ]'
             data-required></div>

        <div data-type="@ControlType.Select"
             data-id="status"
             data-name="status"
             data-label="Trạng thái"
             data-wrapper-class="col-md-6"
             data-options='[
                 {"value":"","text":"-- Chọn trạng thái --"},
                 {"value":"pending","text":"Chờ kích hoạt"},
                 {"value":"active","text":"Hoạt động"},
                 {"value":"suspended","text":"Tạm ngưng"},
                 {"value":"expired","text":"Hết hạn"}
             ]'
             data-required></div>
    </div>

    <!-- Dates -->
    <div class="row">
        <div data-type="@ControlType.Date"
             data-id="startDate"
             data-name="startDate"
             data-label="Ngày bắt đầu"
             data-wrapper-class="col-md-6"
             data-required></div>

        <div data-type="@ControlType.Date"
             data-id="expiryDate"
             data-name="expiryDate"
             data-label="Ngày hết hạn"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Device và Price -->
    <div class="row">
        <div data-type="@ControlType.Number"
             data-id="maxDevices"
             data-name="maxDevices"
             data-label="Số thiết bị tối đa"
             data-placeholder="10"
             data-min="1"
             data-max="1000"
             data-wrapper-class="col-md-6"
             data-required></div>

        <div data-type="@ControlType.Number"
             data-id="price"
             data-name="price"
             data-label="Giá (VNĐ)"
             data-placeholder="1000000"
             data-step="100000"
             data-min="0"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Features -->
    <div class="mb-3">
        <label class="form-label">Tính năng bao gồm</label>
        <div class="border rounded p-3 bg-light">
            <div class="row">
                <div class="col-md-4">
                    <div data-type="@ControlType.Checkbox" data-label="Báo cáo" data-value="reports" data-name="features[]" data-id="featureReports"></div>
                </div>
                <div class="col-md-4">
                    <div data-type="@ControlType.Checkbox" data-label="Phân tích" data-value="analytics" data-name="features[]" data-id="featureAnalytics"></div>
                </div>
                <div class="col-md-4">
                    <div data-type="@ControlType.Checkbox" data-label="API Access" data-value="api" data-name="features[]" data-id="featureApi"></div>
                </div>
                <div class="col-md-4">
                    <div data-type="@ControlType.Checkbox" data-label="Hỗ trợ 24/7" data-value="support" data-name="features[]" data-id="featureSupport"></div>
                </div>
                <div class="col-md-4">
                    <div data-type="@ControlType.Checkbox" data-label="Sao lưu dữ liệu" data-value="backup" data-name="features[]" data-id="featureBackup"></div>
                </div>
                <div class="col-md-4">
                    <div data-type="@ControlType.Checkbox" data-label="Tùy chỉnh" data-value="custom" data-name="features[]" data-id="featureCustom"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notes -->
    <div class="mb-3">
        <div data-type="@ControlType.Textarea"
             data-id="notes"
             data-name="notes"
             data-label="Ghi chú"
             data-placeholder="Ghi chú thêm về license này..."
             data-rows="3"
             data-maxlength="500"
             data-wrapper-class="col-md-12"></div>
    </div>

    <!-- Switch Settings -->
    <div class="mb-3">
        <div data-type="@ControlType.Switch"
             data-id="autoRenewal"
             data-name="autoRenewal"
             data-label="Tự động gia hạn"
             data-value="true"></div>

        <div data-type="@ControlType.Switch"
             data-id="sendNotifications"
             data-name="sendNotifications"
             data-label="Gửi thông báo email"
             data-value="true"
             data-checked="true"></div>
    </div>

</form>

@section Scripts {
    <script src="~/js/base-detail.js"></script>
    <script src="~/js/pages/license/license-detail.js"></script>
}
