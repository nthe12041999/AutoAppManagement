@{
    ViewData["Title"] = "License Forms";
    ViewData["PageName"] = "license-forms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- License Form - Sử dụng data-type để binding giống RoleForms -->
<form id="licenseForm" action="/License/CreateLicense" method="POST">
    <!-- License Key và Customer -->
    <div class="row">
        <div data-type="Text"
             data-id="licenseKey"
             data-name="licenseKey"
             data-label="License Key"
             data-placeholder="LIC-2024-XXX"
             data-wrapper-class="col-md-6"
             data-required></div>
        <div data-type="Text"
             data-id="customer"
             data-name="customer"
             data-label="Khách hàng"
             data-placeholder="Tên công ty/khách hàng"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Contact Info -->
    <div class="row">
        <div data-type="Text"
             data-id="contactEmail"
             data-name="contactEmail"
             data-label="Email liên hệ"
             data-placeholder="contact@company.com"
             data-wrapper-class="col-md-6"
             data-required></div>
        <div data-type="Text"
             data-id="contactPhone"
             data-name="contactPhone"
             data-label="Số điện thoại"
             data-placeholder="0XXX XXX XXX"
             data-wrapper-class="col-md-6"></div>
    </div>

    <!-- License Type và Status -->
    <div class="row">
        <div data-type="Select"
             data-id="licenseType"
             data-name="licenseType"
             data-label="Loại License"
             data-wrapper-class="col-md-6"
             data-options='[
                {"value":"","text":"Chọn loại license"},
                {"value":"trial","text":"Trial (Dùng thử)"},
                {"value":"basic","text":"Basic (Cơ bản)"},
                {"value":"premium","text":"Premium (Cao cấp)"},
                {"value":"enterprise","text":"Enterprise (Doanh nghiệp)"}
             ]'
             data-required></div>
        <div data-type="Select"
             data-id="status"
             data-name="status"
             data-label="Trạng thái"
             data-wrapper-class="col-md-6"
             data-options='[
                {"value":"","text":"Chọn trạng thái"},
                {"value":"pending","text":"Chờ kích hoạt"},
                {"value":"active","text":"Hoạt động"},
                {"value":"suspended","text":"Tạm ngưng"},
                {"value":"expired","text":"Hết hạn"}
             ]'
             data-required></div>
    </div>

    <!-- Dates -->
    <div class="row">
        <div data-type="Date"
             data-id="startDate"
             data-name="startDate"
             data-label="Ngày bắt đầu"
             data-wrapper-class="col-md-6"
             data-required></div>
        <div data-type="Date"
             data-id="expiryDate"
             data-name="expiryDate"
             data-label="Ngày hết hạn"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Device và Price -->
    <div class="row">
        <div data-type="Number"
             data-id="maxDevices"
             data-name="maxDevices"
             data-label="Số thiết bị tối đa"
             data-placeholder="10"
             data-min="1"
             data-max="1000"
             data-wrapper-class="col-md-6"
             data-required></div>
        <div data-type="Number"
             data-id="price"
             data-name="price"
             data-label="Giá (VNĐ)"
             data-placeholder="1000000"
             data-step="100000"
             data-min="0"
             data-wrapper-class="col-md-6"
             data-required></div>
    </div>

    <!-- Features -->
    <div class="mb-3">
        <label class="form-label">Tính năng bao gồm</label>
        <div class="row">
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Báo cáo" data-value="reports" data-name="features[]" data-id="featureReports"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Phân tích" data-value="analytics" data-name="features[]" data-id="featureAnalytics"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="API Access" data-value="api" data-name="features[]" data-id="featureApi"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Hỗ trợ 24/7" data-value="support" data-name="features[]" data-id="featureSupport"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Sao lưu dữ liệu" data-value="backup" data-name="features[]" data-id="featureBackup"></div>
            </div>
            <div class="col-md-4">
                <div data-type="Checkbox" data-label="Tùy chỉnh" data-value="custom" data-name="features[]" data-id="featureCustom"></div>
            </div>
        </div>
    </div>

    <!-- Notes -->
    <div class="mb-3">
        <div data-type="Textarea"
             data-id="notes"
             data-name="notes"
             data-label="Ghi chú"
             data-placeholder="Ghi chú thêm về license này..."
             data-rows="3"
             data-maxlength="500"
             data-wrapper-class="col-md-12"></div>
        <div class="form-text">
            <span id="notesCount">0</span>/500 ký tự
        </div>
    </div>

    <!-- Switch -->
    <div class="mb-3">
        <div data-type="Switch" data-id="autoRenewal" data-name="autoRenewal" data-label="Tự động gia hạn"></div>
        <div data-type="Switch" data-id="sendNotifications" data-name="sendNotifications" data-label="Gửi thông báo email" data-checked="true"></div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('licenseForm');
            const cancelBtn = document.getElementById('cancelBtn');
            const resetBtn = document.getElementById('resetBtn');
            const saveBtn = document.getElementById('saveBtn');
            const notesTextarea = document.getElementById('notes');
            const notesCount = document.getElementById('notesCount');

            // Character count for notes
            notesTextarea.addEventListener('input', function() {
                const length = this.value.length;
                notesCount.textContent = length;
                
                if (length > 450) {
                    notesCount.style.color = '#ffc107';
                } else {
                    notesCount.style.color = '#6c757d';
                }
            });

            // Form validation
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                event.stopPropagation();
                
                let isFormValid = true;
                
                // Check required fields
                const requiredFields = form.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        isFormValid = false;
                        field.classList.add('is-invalid');
                    } else {
                        field.classList.remove('is-invalid');
                        field.classList.add('is-valid');
                    }
                });

                // Validate dates
                const startDate = document.getElementById('startDate').value;
                const expiryDate = document.getElementById('expiryDate').value;
                
                if (startDate && expiryDate && new Date(startDate) >= new Date(expiryDate)) {
                    document.getElementById('expiryDate').classList.add('is-invalid');
                    isFormValid = false;
                    showNotification('Ngày hết hạn phải sau ngày bắt đầu', 'error');
                }
                
                if (isFormValid) {
                    showNotification('✅ License validation thành công! Đang lưu...', 'success');
                    
                    // Simulate saving process
                    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
                    saveBtn.disabled = true;
                    
                    setTimeout(() => {
                        saveBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Lưu License';
                        saveBtn.disabled = false;
                        showNotification('💾 License đã được lưu thành công!', 'success');
                        
                        // Close modal if in modal
                        const modalContainer = form.closest('.modal-container');
                        if (modalContainer) {
                            setTimeout(() => {
                                modalContainer.remove();
                            }, 1500);
                        }
                    }, 2000);
                } else {
                    showNotification('❌ Vui lòng kiểm tra lại các trường bắt buộc', 'error');
                }
                
                form.classList.add('was-validated');
            });

            // Reset button
            resetBtn.addEventListener('click', function() {
                form.classList.remove('was-validated');
                notesCount.textContent = '0';
                showNotification('🔄 Form đã được reset', 'info');
            });

            // Cancel button
            cancelBtn.addEventListener('click', function() {
                if (confirm('Bạn có chắc muốn hủy? Dữ liệu sẽ không được lưu.')) {
                    form.reset();
                    form.classList.remove('was-validated');
                    notesCount.textContent = '0';
                    showNotification('❌ Đã hủy thao tác', 'warning');
                    
                    // Close modal if form is in modal
                    const modalContainer = this.closest('.modal-container');
                    if (modalContainer) {
                        modalContainer.remove();
                    }
                }
            });
        });

        function showNotification(message, type = 'info') {
            const alertClass = type === 'error' ? 'alert-danger' : 
                              type === 'success' ? 'alert-success' : 
                              type === 'warning' ? 'alert-warning' : 'alert-info';
            
            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 350px; max-width: 500px;';
            notification.innerHTML = `
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <div class="d-flex align-items-center">
                    ${message}
                </div>
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 4000);
        }
    </script>
}
