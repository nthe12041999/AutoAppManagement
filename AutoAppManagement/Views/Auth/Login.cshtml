@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Auto App Management</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    <!-- Login Page CSS -->
    <link rel="stylesheet" href="~/css/auth/login.css">
</head>
<body>
    <div class="login-container d-flex align-items-center justify-content-center p-4">
        <div class="login-card card border-0 rounded-4 p-4">
            <div class="card-body">
                <!-- Logo -->
                <div class="login-logo">
                    <i class="bi bi-gear-fill text-white fs-1"></i>
                </div>
                
                <!-- Title -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark mb-2">Đăng nhập</h2>
                    <p class="text-muted mb-0">Auto App Management System</p>
                </div>
                
                <!-- Error Alert -->
                <div id="errorAlert" class="alert alert-danger d-none" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <span id="errorMessage"></span>
                </div>
                
                <!-- Login Form -->
                <form id="loginForm">
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="userName" placeholder="Tên đăng nhập" required>
                            <label for="userName">
                                <i class="bi bi-person me-2"></i>Tên đăng nhập
                            </label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="password" class="form-control" id="password" placeholder="Mật khẩu" required>
                            <label for="password">
                                <i class="bi bi-lock me-2"></i>Mật khẩu
                            </label>
                        </div>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">
                            Ghi nhớ đăng nhập
                        </label>
                    </div>
                    
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-login text-white">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                        </button>
                    </div>
                    
                    <div class="text-center">
                        <a href="#" class="text-decoration-none">
                            <i class="bi bi-question-circle me-1"></i>Quên mật khẩu?
                        </a>
                    </div>
                </form>
                
                <!-- Loading Spinner -->
                <div id="loadingSpinner" class="text-center d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang xử lý...</span>
                    </div>
                    <p class="mt-2 text-muted">Đang xác thực...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/fetch-api.js"></script>
    <script src="~/js/auth/login.js"></script>
</body>
</html>
