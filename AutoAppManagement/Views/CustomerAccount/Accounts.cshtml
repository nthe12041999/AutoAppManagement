@using AutoAppManagement.Models.Enums
@using AutoAppManagement.Models.BaseEntity
@{
    ViewData["Title"] = "Danh sách tài khoản khách hàng";
    ViewData["PageName"] = "customer-accounts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi bi-people me-2 text-primary"></i>Danh sách tài khoản khách hàng
        </h1>
        <p class="text-muted mb-0">Quản lý tài khoản khách hàng trong hệ thống</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="toggleAdminStats">
            <i class="bi bi-shield-check me-1"></i>
            <span id="toggleAdminStatsText">Hiện thống kê Admin</span>
        </button>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item active">Tài khoản khách hàng</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Statistics Cards -->
<!-- Customer Statistics Cards Component -->
<div id="customerStatistics" data-component="statistics" data-template="customer">
    <!-- Cards will be auto-generated by StatisticsCards component -->
</div>

<!-- Admin Statistics Section -->
<div class="row mb-4" id="adminStatsSection" style="display: none;">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="bi bi-shield-check me-2"></i>Thống kê quản trị viên
                </h6>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-light" id="refreshAdminStats" title="Làm mới dữ liệu">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="hideAdminStats" title="Ẩn thống kê">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Admin Statistics Cards -->
                <div id="adminStatistics" data-component="statistics" data-template="admin">
                    <!-- Admin cards will be auto-generated -->
                </div>

                <!-- Additional Info -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Thông tin:</strong> Dữ liệu thống kê admin được cập nhật tự động mỗi 30 giây.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filter and Actions -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="form-floating">
                    <input type="text" class="form-control" id="searchInput" placeholder="Tìm kiếm...">
                    <label for="searchInput">
                        <i class="bi bi-search me-2"></i>Tìm kiếm
                    </label>
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="statusFilter">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Hoạt động</option>
                    <option value="inactive">Không hoạt động</option>
                    <option value="suspended">Tạm khóa</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" id="roleFilter">
                    <option value="">Tất cả vai trò</option>
                    <option value="customer">Khách hàng</option>
                    <option value="premium">Premium</option>
                    <option value="vip">VIP</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <input type="date" class="form-control" id="dateFrom">
                    <span class="input-group-text">đến</span>
                    <input type="date" class="form-control" id="dateTo">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DataGrid Component -->
<div class="card" data-component="datagrid"
     data-table-id="customerTable"
     data-get-url="@Url.Action("GetCustomerAccounts", "CustomerAccount")"
     data-base-url="/CustomerAccount"
     data-entity="customer"
     data-page-size="10"
     data-auto-load="true"
     data-has-paging="true"
     data-title="Danh sách tài khoản khách hàng"
     data-title-icon="bi bi-table"
     data-has-export="true"
     data-has-refresh="true"
     data-has-add="true"
     data-title-add="Thêm khách hàng"
     data-add-action="modal"
     data-add-target="#customerModal">

    <!-- Header will be auto-generated by DataGrid -->
    <div class="card-body p-0" data-section="table-container">
        <div class="table-responsive" data-element="table-wrapper">
            <table class="table table-hover mb-0" id="customerTable">
                <thead class="table-light" data-section="table-header">
                    <tr data-row="header">
                        <th width="50" data-type="@DataGridColumnType.Checkbox" data-sortable="false" class="text-center">
                            <input type="checkbox" class="form-check-input" id="selectAll" data-action="select-all" data-target="all-rows">
                        </th>
                        <th data-field="Name" data-type="@DataGridColumnType.User">
                            Thông tin khách hàng
                        </th>
                        <th data-field="Email" data-type="@DataGridColumnType.Email">
                            Email
                        </th>
                        <th data-field="Phone" data-type="@DataGridColumnType.Text">
                            Số điện thoại
                        </th>
                        <th data-field="Role" data-type="@DataGridColumnType.Badge">
                            Vai trò
                        </th>
                        <th data-field="Status" data-type="@DataGridColumnType.Badge">
                            Trạng thái
                        </th>
                        <th data-field="CreatedDate" data-type="@DataGridColumnType.DateTime">
                            Ngày tạo
                        </th>
                        <th width="150" data-type="@DataGridColumnType.Actions" data-sortable="false">
                            Thao tác
                        </th>
                    </tr>
                </thead>
                <!-- tbody will be auto-generated by DataGrid with loading state -->
            </table>
        </div>
    </div>
    <!-- Pagination will be auto-generated by DataGrid when data-has-paging="true" -->
</div>


<!-- Include Customer Modal (Create/Edit/View) -->
@await Html.PartialAsync("_CustomerModal")

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    /* Admin Statistics Styles */
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    #adminStatistics .card {
        transition: all 0.3s ease;
        border: none;
    }

    #adminStatistics .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    #adminStatistics .card-body {
        padding: 1.5rem;
    }

    #adminStatistics .fs-1 {
        font-size: 2.5rem !important;
        opacity: 0.7;
    }

    /* Animation cho admin statistics */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #adminStatistics .card {
        animation: fadeInUp 0.6s ease-out;
    }

    #adminStatistics .card:nth-child(1) { animation-delay: 0.1s; }
    #adminStatistics .card:nth-child(2) { animation-delay: 0.2s; }
    #adminStatistics .card:nth-child(3) { animation-delay: 0.3s; }
    #adminStatistics .card:nth-child(4) { animation-delay: 0.4s; }
</style>

<!-- Add/Edit Account Modal -->
<div class="modal fade" id="addAccountModal" tabindex="-1" aria-labelledby="addAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addAccountModalLabel">
                    <i class="bi bi-person-plus me-2"></i>Thêm tài khoản mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="accountForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="fullName" placeholder="Họ và tên" required>
                                <label for="fullName">Họ và tên *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="username" placeholder="Tên đăng nhập" required>
                                <label for="username">Tên đăng nhập *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="email" class="form-control" id="email" placeholder="Email" required>
                                <label for="email">Email *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="tel" class="form-control" id="phone" placeholder="Số điện thoại">
                                <label for="phone">Số điện thoại</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="password" class="form-control" id="password" placeholder="Mật khẩu" required>
                                <label for="password">Mật khẩu *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="password" class="form-control" id="confirmPassword" placeholder="Xác nhận mật khẩu" required>
                                <label for="confirmPassword">Xác nhận mật khẩu *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="role" required>
                                    <option value="">Chọn vai trò</option>
                                    <option value="customer">Khách hàng</option>
                                    <option value="premium">Premium</option>
                                    <option value="vip">VIP</option>
                                </select>
                                <label for="role">Vai trò *</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="status" required>
                                    <option value="">Chọn trạng thái</option>
                                    <option value="active">Hoạt động</option>
                                    <option value="inactive">Không hoạt động</option>
                                    <option value="suspended">Tạm khóa</option>
                                </select>
                                <label for="status">Trạng thái *</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea class="form-control" id="notes" placeholder="Ghi chú" style="height: 100px"></textarea>
                                <label for="notes">Ghi chú</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-primary" id="saveAccount">
                    <i class="bi bi-check-lg me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/css/components/datagrid.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/components/statistics-cards.js"></script>
    <script src="~/js/components/datagrid.js"></script>
    <script src="~/js/components/customer-modal.js"></script>
    <script src="~/js/pages/customer-datagrid.js"></script>
    <script src="~/js/pages/admin-datagrid.js"></script>

    <script>
        let adminStatsInterval;
        let isAdminStatsVisible = false;

        // Khởi tạo admin statistics với dữ liệu mẫu
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 Initializing Admin Statistics in Customer Accounts page...');

            // Toggle Admin Stats
            const toggleBtn = document.getElementById('toggleAdminStats');
            const toggleText = document.getElementById('toggleAdminStatsText');
            const adminStatsSection = document.getElementById('adminStatsSection');
            const hideBtn = document.getElementById('hideAdminStats');
            const refreshBtn = document.getElementById('refreshAdminStats');

            // Toggle function
            function toggleAdminStats() {
                isAdminStatsVisible = !isAdminStatsVisible;

                if (isAdminStatsVisible) {
                    adminStatsSection.style.display = 'block';
                    toggleText.textContent = 'Ẩn thống kê Admin';
                    toggleBtn.classList.remove('btn-outline-secondary');
                    toggleBtn.classList.add('btn-secondary');

                    // Load initial data
                    updateAdminStats();

                    // Start auto-update
                    startAdminStatsAutoUpdate();
                } else {
                    adminStatsSection.style.display = 'none';
                    toggleText.textContent = 'Hiện thống kê Admin';
                    toggleBtn.classList.remove('btn-secondary');
                    toggleBtn.classList.add('btn-outline-secondary');

                    // Stop auto-update
                    stopAdminStatsAutoUpdate();
                }
            }

            // Event listeners
            toggleBtn.addEventListener('click', toggleAdminStats);
            hideBtn.addEventListener('click', toggleAdminStats);
            refreshBtn.addEventListener('click', updateAdminStats);

            // Update admin statistics function
            function updateAdminStats() {
                if (window.adminStatisticsStats) {
                    // Show loading
                    window.adminStatisticsStats.showLoading();

                    // Simulate API call
                    setTimeout(() => {
                        const randomData = {
                            totalAdmins: Math.floor(Math.random() * 25) + 10,
                            activeAdmins: Math.floor(Math.random() * 20) + 5,
                            verifiedAdmins: Math.floor(Math.random() * 22) + 8,
                            onlineAdmins: Math.floor(Math.random() * 10) + 1
                        };

                        window.adminStatisticsStats.updateValues(randomData);
                        console.log('✅ Admin Statistics updated:', randomData);
                    }, 800);
                }
            }

            // Auto-update functions
            function startAdminStatsAutoUpdate() {
                if (adminStatsInterval) clearInterval(adminStatsInterval);

                adminStatsInterval = setInterval(() => {
                    if (isAdminStatsVisible) {
                        updateAdminStats();
                        console.log('🔄 Admin Statistics auto-updated');
                    }
                }, 30000); // Cập nhật mỗi 30 giây
            }

            function stopAdminStatsAutoUpdate() {
                if (adminStatsInterval) {
                    clearInterval(adminStatsInterval);
                    adminStatsInterval = null;
                }
            }

            // Cleanup on page unload
            window.addEventListener('beforeunload', stopAdminStatsAutoUpdate);
        });
    </script>
}
