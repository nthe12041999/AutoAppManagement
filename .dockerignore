# Docker ignore file
**/.dockerignore
**/.env
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/azds.yaml
**/bin
**/charts
**/docker-compose*
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
LICENSE
README.md

# Build files
**/bin/
**/obj/
**/out/

# VS files
**/.vs/
**/*.user
**/*.suo
**/*.cache

# Logs
**/logs/
**/*.log

# Environment files
**/.env
**/.env.local
**/.env.production

# Temporary files
**/tmp/
**/temp/

# IDE files
**/.idea/
**/.vscode/

# OS files
**/.DS_Store
**/Thumbs.db

# Package files
**/packages/
**/node_modules/

# Database files
**/*.db
**/*.sqlite
**/*.mdf
**/*.ldf

# Certificates
**/*.pfx
**/*.p12
**/ssl/

# Migration files (chỉ build từ source)
# **/Migrations/

# Postman collections (không cần trong container)
**/*.postman_collection.json
**/*.postman_environment.json
